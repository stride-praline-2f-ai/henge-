+        // The generation check rejects a block after its physical code changed.
+        block[0].gen=r->page_gen[10]-1;
+        checks++;if(hv_ijc_fill_checked(&target,&block[0]))printf("  FAIL stale block entered IJC\n"),failures++;
+        for(int i=0;i<17;i++)hv_cpu_post_ijc_page(&target,va[0]+((uint64_t)i<<14)|2);
+        checks++;if(!(target.pc_state->req_flags&HV_REQ_IJC_RESET))printf("  FAIL overflowing page queue lacks reset fallback\n"),failures++;
+        hv_cpu_process_requests(&target);
+        checks++;if(entry[1][0]==(va[1]^target.ijc_salt[0]))printf("  FAIL overflowing page queue retained a target\n"),failures++;
+        printf("  checked IJC aliases, stale generation, posted selective drop, acknowledgement and queue-overflow fallback exercised\n");
     }
 
     /* Another CPU's big range TLBI (64 user pages of ASID 5: over the 32 done from here by default). With HV_RANGE_DROP it is done from here in one pass:
diff --git a/tests/test_register_groups.c b/tests/test_register_groups.c
new file mode 100644
index 0000000..4c46c83
--- /dev/null
+++ b/tests/test_register_groups.c
@@ -0,0 +1,40 @@
+#include "translate.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+static HvMachine machine;
+static unsigned hot(unsigned mode,const uint32_t *code,unsigned n) {
+    hv_knob[HV_K_GROUPS]=(int)mode;
+    HvBlock block={.va=0x100000,.pa=0x100000};
+    uint64_t before=machine.stats.words_inline;
+    assert(!hv_translate_emit(&machine,&block,code,n));
+    unsigned words=(unsigned)(machine.stats.words_inline-before);
+    printf("register-groups: mode=%u guest=%u inline_words=%u hot_allocation=%u total_words=%u\n",mode,n,words,hv_translate_last_words(),hv_translate_pending_words());
+    return words;
+}
+int main(void) {
+    assert(!hv_machine_init(&machine,4<<20));machine.chain=1;machine.stats_interval=1;
+    const uint32_t stack_frame[]={0xa9bc7bfd,0xa9014ff4,0xa90257f6,0xa9414ff4,0xa94257f6,0xa8c47bfd,0xd65f03c0};
+    unsigned frame_plain=hot(0,stack_frame,7),frame_grouped=hot(2,stack_frame,7);
+    printf("writeback-groups: enabled=%d plain=%u grouped=%u\n",hv_translate_writeback_groups(),frame_plain,frame_grouped);
+    assert(frame_grouped<frame_plain);
+    const uint32_t stream[]={0xf9400001,0xf9400402,0xf9400803,0xf9400c04,0xd65f03c0};
+    unsigned plain=hot(0,stream,5),selected=hot(2,stream,5);
+    assert(selected+10<plain); /* actual emitter, not a copied cost model */
+    const uint32_t clobber[]={0xf9400001,0xf9400402,0x910004c6,0xf9400803,0xf9400c04,0xd65f03c0};
+    assert(hot(2,clobber,6)+8<hot(0,clobber,6)); /* two independent validated pairs survive the scratch clobber */
+    const uint32_t stack_adjust[]={0xf94003e1,0xf94007e2,0xd10043ff,0xf94003e3,0xf94007e4,0xd65f03c0};
+    assert(hot(2,stack_adjust,6)+8<hot(0,stack_adjust,6)); /* SP origin changes split, rather than poison, stack groups */
+    const uint32_t alternating[]={0xf9400001,0xf9400402,0xf9400183,0xf9400584,0xf9400803,0xf9400c04,0xd65f03c0};
+    assert(hot(2,alternating,7)+10<hot(0,alternating,7)); /* field groups on distinct base registers */
+    assert(hot(2,stream+1,4)+6<hot(0,stream+1,4)); /* three-field objects also reuse the translation */
+    assert(hot(2,stream+2,3)<hot(0,stream+2,3)); /* two fields share one validated lookup */
+    hv_knob[HV_K_GROUP_MIN]=3;
+    assert(hot(0,stream+2,3)==hot(2,stream+2,3));
+    hv_knob[HV_K_GROUP_MIN]=2;
+    const uint32_t barrier[]={0xf9400001,0xf9400402,0xf9400803,0xd5033bbf,
+                              0xf9400001,0xf9400402,0xf9400803,0xd65f03c0};
+    assert(hot(2,barrier,8)+12<hot(0,barrier,8)); /* independent groups on both sides of DMB */
+    hv_machine_free(&machine);
+    puts("PASS register groups: real inline-path reduction; two-field reuse, scratch clobber safety and three-access reference policy");
+}
diff --git a/tests/test_tail_recheck.c b/tests/test_tail_recheck.c
new file mode 100644
index 0000000..14d3f32
--- /dev/null
+++ b/tests/test_tail_recheck.c
@@ -0,0 +1,64 @@
+#include "machine.h"
+#include "dispatch.h"
+#include <mach/mach_time.h>
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static HvMachine m;
+static HvCpu cpu;
+/* LDR X1,[X0]; ADD X2,X2,X1; SUBS X3,X3,#1; B.NE loop */
+static uint32_t code[4096] __attribute__((aligned(16384))) = {0xf9400001, 0x8b010042, 0xf1000463, 0x54ffffa1};
+static uint64_t code_words(void) { return m.stats.words_inline + m.stats.words_ool + m.stats.words_pool; }
+int main(void) {
+    assert(hv_machine_init(&m, 4 << 20) == 0);
+    unsigned char *data = aligned_alloc(16384, 32768);
+    assert(data);
+    assert(hv_machine_add_ram(&m, (uintptr_t)code, sizeof code, code, 1) == 0);
+    assert(hv_machine_add_ram(&m, (uintptr_t)data, 32768, data, 0) == 0);
+    m.stats_interval = 1000;
+    mach_timebase_info_data_t timebase;
+    assert(mach_timebase_info(&timebase) == 0);
+    for (int width=8; width<=16; width+=8) {
+        code[0] = width==8 ? 0xf9400001 : 0xa9401001; /* LDR X1 or LDP X1,X4 */
+        uint64_t middle_words = 0;
+        for (int scenario=0; scenario<3; scenario++) {
+            for (int precise=0; precise<=1; precise++) {
+                hv_knob[HV_K_RECHECK] = precise;
+                hv_flush_blocks(&m);
+                hv_cpu_reset(&cpu, &m);
+                memset(data, 0, 32768);
+                size_t offset = scenario==0 ? 64 : scenario==1 ? 16384-width : 16384-width+4;
+                uint64_t value = 5;
+                memcpy(data+offset, &value, sizeof value);
+                uint64_t second = 7;
+                if (width==16) memcpy(data+offset+8, &second, sizeof second);
+                cpu.pc = (uintptr_t)code;
+                cpu.x[0] = (uintptr_t)(data+offset);
+                cpu.x[3] = 100000;
+                cpu.cpacr_el1 = 3u << 20;
+                m.stop_pc = (uintptr_t)(code+4);
+                m.stat_slow_mem = 0;
+                uint64_t words_before = code_words(), start = mach_absolute_time();
+                assert(hv_run(&cpu) == HV_EXIT_HALT);
+                uint64_t elapsed = mach_absolute_time()-start;
+                assert(cpu.x[2] == 500000 && cpu.x[3] == 0);
+                if (width==16) assert(cpu.x[4] == 7);
+                uint64_t slow = m.stat_slow_mem;
+                if (scenario==1) assert(width==16 || precise ? slow <= 1 : slow == 100000);
+                if (scenario==2) assert(slow == 100000); /* a real crossing must remain slow */
+                uint64_t words = code_words()-words_before;
+                if (scenario==0 && !precise) middle_words = words;
+                if (scenario==0 && precise && width==16) assert(words==middle_words); /* 16-byte guard is already exact */
+                double ns = (double)elapsed*timebase.numer/timebase.denom;
+                printf("tail-recheck: bytes=%d location=%s enabled=%d slow_helpers=%llu/100000 ns_per_iteration=%.1f emitted_words=%llu\n",
+                    width, scenario==0 ? "middle" : scenario==1 ? "valid-tail" : "cross-page",
+                    precise, (unsigned long long)slow, ns/100000, (unsigned long long)(code_words()-words_before));
+            }
+        }
+    }
+    hv_machine_free(&m);
+    free(data);
+    puts("tail recheck: identical guest results, valid page-tail helpers removed, real page crossing preserved");
+}

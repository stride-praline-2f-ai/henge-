+import SwiftUI
+
+enum WirelessControlMode: Int, CaseIterable, Identifiable {
+    case touchpad, keyboard, gamepad
+    var id: Int { rawValue }
+    var title: String { ["Touchpad","Keyboard","Gamepad"][rawValue] }
+    var icon: String { ["cursorarrow.motionlines","keyboard","gamecontroller"][rawValue] }
+}
+
+/// Shared production/preview shell. Transport, pairing and native injection stay
+/// in LinkViewerService; no second connection or independent input timer.
+struct WirelessControlsPanel<Input: View>: View {
+    let status: String
+    let tuning: GamepadTuning
+    @Binding var mode: WirelessControlMode
+    let disconnect: () -> Void
+    let configure: () -> Void
+    let sendPad: (GamepadState) -> Void
+    let input: (WirelessControlMode) -> Input
+    var body: some View {
+        GeometryReader { geometry in
+            let wide = geometry.size.width > geometry.size.height * 1.25
+            Group {
+                if wide {
+                    HStack(spacing:14) {
+                        Group {
+                            if geometry.size.height<450 {
+                                ScrollView(.vertical) { navigation(compact:true) }.scrollIndicators(.hidden)
+                            } else { navigation(compact:false) }
+                        }.frame(width:100)
+                        content
+                    }
+                } else {
+                    VStack(spacing:14) { header; modePicker; content }
+                }
+            }
+            .padding(wide ? 14 : 18)
+            .background(LinearGradient(colors:[Color(red:0.08,green:0.1,blue:0.16),.black],startPoint:.topLeading,endPoint:.bottomTrailing))
+            .foregroundStyle(.white)
+        }
+    }
+    private var header: some View {
+        HStack(spacing:12) {
+            Image(systemName:"antenna.radiowaves.left.and.right").foregroundStyle(.green)
+            VStack(alignment:.leading,spacing:3) {
+                Text("Wireless controls").font(.headline)
+                Text(status).font(.caption).foregroundStyle(.secondary).lineLimit(2)
+            }
+            Spacer()
+            settingsButton
+            Button(action:disconnect) { Image(systemName:"xmark.circle.fill").font(.title2) }
+                .accessibilityLabel("Disconnect wireless controls")
+        }
+    }
+    private var modePicker: some View {
+        Picker("Control mode",selection:$mode) {
+            ForEach(WirelessControlMode.allCases) { control in Label(control.title,systemImage:control.icon).tag(control) }
+        }.pickerStyle(.segmented)
+    }
+    private func navigation(compact: Bool) -> some View {
+        VStack(spacing:compact ? 8 : 18) {
+            if !compact { Image(systemName:"antenna.radiowaves.left.and.right").font(.title2).foregroundStyle(.green) }
+            Text(status).font(.caption2).foregroundStyle(.secondary).lineLimit(compact ? 1 : 3)
+            ForEach(WirelessControlMode.allCases) { control in
+                Button { mode = control } label: {
+                    Group {
+                        if compact { Label(control.title,systemImage:control.icon).font(.caption) }
+                        else { VStack(spacing:6) { Image(systemName:control.icon).font(.title2); Text(control.title).font(.caption) } }
+                    }
+                        .frame(maxWidth:.infinity).padding(.vertical,compact ? 8 : 10)
+                        .background(mode == control ? Color.blue.opacity(0.3) : .clear,in:RoundedRectangle(cornerRadius:14))
+                }.accessibilityLabel(control.title).accessibilityAddTraits(mode == control ? .isSelected : [])
+            }
+            Spacer(minLength:0)
+            settingsButton
+            Button("Disconnect",systemImage:"xmark.circle",action:disconnect).font(.caption)
+        }.padding(.vertical,8)
+    }
+    private var settingsButton: some View {
+        Button(action:configure) { Image(systemName:"slider.horizontal.3").font(.title3).frame(width:44,height:44) }
+            .accessibilityLabel("Controller sensitivity and layout settings")
+    }
+    @ViewBuilder private var content: some View {
+        if mode == .gamepad {
+            VStack(spacing:4) {
+                Text("Gamepad").font(.headline).frame(maxWidth:.infinity,alignment:.leading)
+                GamepadSurface(tuning:tuning,send:sendPad).frame(maxWidth:.infinity,maxHeight:.infinity)
+            }
+        } else {
+            VStack(alignment:.leading,spacing:12) {
+                Label(mode.title,systemImage:mode.icon).font(.headline)
+                input(mode)
+                    .frame(maxWidth:.infinity,maxHeight:.infinity)
+                    .background(.white.opacity(0.06),in:RoundedRectangle(cornerRadius:24))
+                    .overlay(RoundedRectangle(cornerRadius:24).strokeBorder(.white.opacity(0.12)))
+                Text(mode == .keyboard ? "Software and hardware keyboards use the shared connection." : "Tap to click · Two fingers scroll · Hold and drag moves windows")
+                    .font(.footnote).foregroundStyle(.secondary)
+            }
+        }
+    }
+}
diff --git a/ios/Henge/Controls/WirelessInputSurface.swift b/ios/Henge/Controls/WirelessInputSurface.swift
new file mode 100644
index 0000000..3c6f98f
--- /dev/null
+++ b/ios/Henge/Controls/WirelessInputSurface.swift
@@ -0,0 +1,112 @@
+import SwiftUI
+import UIKit
+
+// Shipping Link input surface shared with controls-only views and UI fixtures.
+class LinkInputView: UIView, UIGestureRecognizerDelegate, UIKeyInput {
+    var send: ((LinkControl) -> Void)?
+    var rejectedPaste: (() -> Void)?
+    var toggleControls: (() -> Void)?
+    // The surface is a remote trackpad, not a text editor. Keep iOS's system
+    // three-finger editing menu from taking the local controls gesture.
+    override var editingInteractionConfiguration: UIEditingInteractionConfiguration { .none }
+    override var canBecomeFirstResponder: Bool { true }
+    private var heldKeys = Set<Int>()
+    var keyboardEnabled = false {
+        didSet { if oldValue != keyboardEnabled { releaseInput(); reloadInputViews(); if window != nil { becomeFirstResponder() } } }
+    }
+    override var inputView: UIView? { keyboardEnabled ? nil : UIView(frame:.zero) }
+    var hasText: Bool { true }
+    var autocorrectionType: UITextAutocorrectionType = .no
+    var autocapitalizationType: UITextAutocapitalizationType = .none
+    var keyboardType: UIKeyboardType = .asciiCapable
+    var keyboardAppearance: UIKeyboardAppearance = .dark
+    func releaseInput() { heldKeys.removeAll(); send?(LinkControl(type:"release")) }
+    func deleteBackward() { stroke(42,shift:false) }
+    private func stroke(_ key: Int,shift: Bool) {
+        let shifted = heldKeys.contains(225)
+        if shift && !shifted { send?(LinkControl(type:"key",code:225,down:true)) }
+        if heldKeys.contains(key) { send?(LinkControl(type:"key",code:key,down:false)) }
+        send?(LinkControl(type:"key",code:key,down:true))
+        if !heldKeys.contains(key) { send?(LinkControl(type:"key",code:key,down:false)) }
+        if shift && !shifted { send?(LinkControl(type:"key",code:225,down:false)) }
+    }
+    func insertText(_ text: String) {
+        // Bound pastes and keep enough queue capacity for releases. The
+        // software keyboard is explicit US ASCII; no text enters diagnostics.
+        let plain = Array("abcdefghijklmnopqrstuvwxyz1234567890\n\u{1b}\u{8}\t -=[]\\;’`,./")
+        let shifted = Array("ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()")
+        var mapping: [Character:(Int,Bool)] = [:]
+        for (i,c) in plain.prefix(36).enumerated() { mapping[c]=(i<26 ? 4+i : 30+i-26,false) }
+        for (i,c) in shifted.enumerated() { mapping[c]=(i<26 ? 4+i : 30+i-26,true) }
+        mapping["\n"]=(40,false);mapping["\t"]=(43,false);mapping[" "]=(44,false)
+        let punctuation: [(Character,Int)] = [("-",45),("=",46),("[",47),("]",48),("\\",49),(";",51),("'",52),("`",53),(",",54),(".",55),("/",56)]
+        for (c,k) in punctuation { mapping[c]=(k,false) }
+        let upper = Array(#"_+{}|:"~<>?"#)
+        for ((_,k),c) in zip(punctuation,upper) { mapping[c]=(k,true) }
+        guard text.count <= 16 else { rejectedPaste?(); return }
+        for c in text { if let (key,shift)=mapping[c] { stroke(key,shift:shift) } }
+    }
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        backgroundColor = .clear
+        accessibilityIdentifier = "wireless-input-surface"
+        isAccessibilityElement = true
+        accessibilityLabel = "Wireless keyboard and touchpad"
+        let controls = UITapGestureRecognizer(target: self, action: #selector(toggleViewerControls))
+        controls.numberOfTouchesRequired = 3; controls.numberOfTapsRequired = 1
+        addGestureRecognizer(controls)
+        let pointer = UIPanGestureRecognizer(target: self, action: #selector(pointerPan(_:))); pointer.maximumNumberOfTouches = 1; addGestureRecognizer(pointer)
+        let scroll = UIPanGestureRecognizer(target: self, action: #selector(scroll(_:))); scroll.minimumNumberOfTouches = 2; scroll.maximumNumberOfTouches = 2; addGestureRecognizer(scroll)
+        let click = UITapGestureRecognizer(target: self, action: #selector(click)); addGestureRecognizer(click); click.require(toFail: pointer)
+        let right = UITapGestureRecognizer(target: self, action: #selector(rightClick)); right.numberOfTouchesRequired = 2; addGestureRecognizer(right); right.require(toFail: scroll)
+        let hold = UILongPressGestureRecognizer(target: self, action: #selector(holdButton(_:)))
+        hold.minimumPressDuration = 0.35; hold.delegate = self; addGestureRecognizer(hold)
+    }
+    override func didMoveToWindow() { super.didMoveToWindow(); if window != nil { becomeFirstResponder() } else { releaseInput() } }
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith other: UIGestureRecognizer) -> Bool {
+        gestureRecognizer is UILongPressGestureRecognizer || other is UILongPressGestureRecognizer
+    }
+    @objc private func toggleViewerControls() { toggleControls?() }
+    @objc private func holdButton(_ hold: UILongPressGestureRecognizer) {
+        if hold.state == .began { send?(LinkControl(type: "button", code: 0, down: true)) }
+        if hold.state == .ended || hold.state == .cancelled || hold.state == .failed { send?(LinkControl(type: "button", code: 0, down: false)) }
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+    @objc private func pointerPan(_ pan: UIPanGestureRecognizer) {
+        let p = pan.translation(in: self)
+        let dx = max(-4096, min(4096, Int(p.x * contentScaleFactor))), dy = max(-4096, min(4096, Int(p.y * contentScaleFactor)))
+        pan.setTranslation(CGPoint(x: p.x - CGFloat(dx) / contentScaleFactor, y: p.y - CGFloat(dy) / contentScaleFactor), in: self)
+        if dx != 0 || dy != 0 { send?(LinkControl(type: "move", x: dx, y: dy)) }
+    }
+    @objc private func scroll(_ pan: UIPanGestureRecognizer) {
+        let p = pan.translation(in: self)
+        let x = Int(p.x / 6), y = Int(p.y / 6)
+        if x != 0 || y != 0 { pan.setTranslation(CGPoint(x: p.x - CGFloat(x * 6), y: p.y - CGFloat(y * 6)), in: self); send?(LinkControl(type: "scroll", x: max(-4096, min(4096, x)), y: max(-4096, min(4096, y)))) }
+    }
+    private func button(_ n: Int) { send?(LinkControl(type: "button", code: n, down: true)); send?(LinkControl(type: "button", code: n, down: false)) }
+    @objc private func click() { button(0) }
+    @objc private func rightClick() { button(1) }
+    override func pressesBegan(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+        for press in presses { if let key = press.key, (4...231).contains(key.keyCode.rawValue) { heldKeys.insert(key.keyCode.rawValue); send?(LinkControl(type: "key", code: key.keyCode.rawValue, down: true)) } }
+    }
+    override func pressesEnded(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+        for press in presses { if let key = press.key, (4...231).contains(key.keyCode.rawValue) { heldKeys.remove(key.keyCode.rawValue); send?(LinkControl(type: "key", code: key.keyCode.rawValue, down: false)) } }
+    }
+    override func pressesCancelled(_ presses: Set<UIPress>, with event: UIPressesEvent?) { pressesEnded(presses, with: event) }
+}
+
+struct WirelessInputSurface: UIViewRepresentable {
+    let keyboard: Bool
+    let send: (LinkControl) -> Void
+    var rejectedPaste: () -> Void = {}
+    func makeUIView(context: Context) -> LinkInputView {
+        let view = LinkInputView();view.send = send;view.rejectedPaste = rejectedPaste
+        view.keyboardEnabled = keyboard;return view
+    }
+    func updateUIView(_ view: LinkInputView,context: Context) {
+        view.send = send;view.rejectedPaste = rejectedPaste;view.keyboardEnabled = keyboard
+    }
+    static func dismantleUIView(_ view: LinkInputView,coordinator: ()) {
+        view.releaseInput();view.resignFirstResponder();view.send = nil;view.rejectedPaste = nil
+    }
+}

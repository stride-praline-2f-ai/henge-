+    if (![release isKindOfClass:NSDictionary.class]) return NO;
+    NSArray *assets = release[@"assets"];
+    if (![assets isKindOfClass:NSArray.class]) return NO;
+    NSDictionary *chosen = nil;
+    for (id asset in assets) {
+        if (![asset isKindOfClass:NSDictionary.class]) continue;
+        NSString *name = asset[@"name"];
+        if ([name isKindOfClass:NSString.class] && [name hasPrefix:@"actions-runner-osx-arm64-"] && [name hasSuffix:@".tar.gz"]) { chosen = asset; break; }

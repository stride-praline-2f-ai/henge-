+        hv_flush_blocks(m);
+        return;
+    }
+    uint64_t t0 = mach_absolute_time();
+    uint32_t seg = hv_jit_evict_next(r);
+    const uint32_t *lo = r->base + (size_t)seg * r->seg_words, *hi = lo + r->seg_words;

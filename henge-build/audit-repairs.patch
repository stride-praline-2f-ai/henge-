diff --git a/tests/test_runner_control.c b/tests/test_runner_control.c
new file mode 100644
index 0000000..0a8447b
--- /dev/null
+++ b/tests/test_runner_control.c
@@ -0,0 +1,58 @@
+#include "share.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static char socket_path[108];
+static void http(const char *query, const char *body, char *out) {
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0); assert(fd >= 0);
+    struct sockaddr_un address = {.sun_family = AF_UNIX};
+    snprintf(address.sun_path, sizeof address.sun_path, "%s", socket_path);
+    assert(connect(fd, (struct sockaddr *)&address, sizeof address) == 0);
+    char request[1024]; int n = snprintf(request, sizeof request,
+        "%s /.henge/runner?%s HTTP/1.1\r\nHost: 10.0.2.4\r\nConnection: close\r\nContent-Length: %zu\r\n\r\n%s",
+        body ? "PUT" : "GET", query, body ? strlen(body) : 0, body ? body : "");
+    assert(write(fd, request, (size_t)n) == n);
+    size_t at = 0; ssize_t got;
+    while ((got = read(fd, out+at, 4095-at)) > 0) { at += (size_t)got; assert(at < 4095); }
+    out[at] = 0; close(fd);
+}
+static void *waiting(void *seq) {
+    char query[64], response[4096]; snprintf(query, sizeof query, "since=%lu", *(unsigned long *)seq);
+    http(query, NULL, response);
+    assert(strstr(response, "200 OK") && strstr(response, "\"action\":\"stop\"")); return NULL;
+}
+int main(void) {
+    alarm(15);
+    char folder[] = "/tmp/henge-runner-XXXXXX"; assert(mkdtemp(folder));
+    snprintf(socket_path, sizeof socket_path, "%s/s", folder);
+    assert(hv_share_start(folder, socket_path, NULL) == 0);
+    char response[4096], query[64]; long age;
+    assert(hv_share_runner_status(&age) == HV_RUNNER_WAITING && age == -1);
+    const char *command = "{\"version\":1,\"action\":\"start\",\"token\":\"temporary-secret\"}";
+    unsigned long seq = hv_share_runner_set(command); assert(seq);
+    http("since=0", NULL, response); assert(strstr(response, "temporary-secret"));
+    http("since=0", NULL, response); assert(strstr(response, "temporary-secret")); // dropped response retries
+    snprintf(query, sizeof query, "seq=%lu", seq);
+    http(query, "2", response); assert(strstr(response, "204"));
+    assert(hv_share_runner_status(&age) == HV_RUNNER_LISTENING && age == 0);
+    http("since=0", NULL, response); assert(!strstr(response, "temporary-secret") && strstr(response, "resume"));
+    pthread_t worker; assert(!pthread_create(&worker, NULL, waiting, &seq));
+    unsigned long newer = hv_share_runner_set("{\"version\":1,\"action\":\"stop\"}"); assert(newer != seq);
+    assert(!pthread_join(worker, NULL));
+    http(query, "2", response); assert(strstr(response, "409")); // old guest/session can't overwrite state
+    assert(hv_share_runner_status(&age) == HV_RUNNER_WAITING && age == -1);
+    snprintf(query, sizeof query, "seq=%lu", newer);
+    http(query, "4\n", response); assert(strstr(response, "400"));
+    http(query, "4", response); assert(strstr(response, "204"));
+    http("seq=garbage", "2", response); assert(strstr(response, "400"));
+    char too_large[8194]; memset(too_large, 'x', sizeof too_large-1); too_large[sizeof too_large-1] = 0;
+    assert(!hv_share_runner_set(too_large));
+    unlink(socket_path); rmdir(folder);
+    puts("runner control: bounded HTTP, retry, secret retirement, stale reports and wakeup passed");
+}

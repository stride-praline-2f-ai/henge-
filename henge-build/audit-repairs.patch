+import SwiftUI
+
+struct RunnerView: View {
+    @ObservedObject private var machines = Machines.shared
+    @ObservedObject private var jit = JITCoordinator.shared
+    @ObservedObject private var runner = RunnerMode.shared
+    @Binding var running: VirtualMac?
+    @AppStorage(RunnerMode.repositoryKey) private var repository = "https://github.com/stride-praline-2f-ai/henge-"
+    @AppStorage(RunnerMode.nameKey) private var name = "Henge-Mac"
+    @AppStorage(RunnerMode.macKey) private var macID = ""
+    @AppStorage(RunnerMode.backgroundKey) private var background = false
+    @AppStorage(RunnerMode.cpuBackgroundKey) private var cpuBackground = true
+    @State private var token = ""
+    @State private var error: String?
+    private var selected: VirtualMac? { machines.all.first { $0.id.uuidString == macID } ?? machines.all.first }
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section("Mac runner") {
+                    Picker("Mac", selection: $macID) {
+                        ForEach(machines.all) { Text($0.name).tag($0.id.uuidString) }
+                    }
+                    TextField("Repository URL", text: $repository).textInputAutocapitalization(.never).autocorrectionDisabled().keyboardType(.URL)
+                    TextField("Runner name", text: $name).autocorrectionDisabled()
+                    SecureField("Temporary registration token (first setup only)", text: $token).textInputAutocapitalization(.never).autocorrectionDisabled()
+                    Text("Get a temporary token from this repository’s Settings › Actions › Runners › New self-hosted runner. Leave it empty after registration. Henge does not save it.")
+                        .font(.footnote).foregroundStyle(.secondary)
+                    Button(JITBootstrap.ready ? "Start Mac and Runner" : "Enable JIT") {
+                        guard JITBootstrap.ready else { jit.enable(); return }
+                        guard let selected else { error = "Install or import a Mac first."; return }
+                        guard UserDefaults.standard.object(forKey: Sharing.enabledKey) as? Bool ?? true else { error = "Enable the shared folder and Mac companion in Settings first."; return }
+                        guard runner.prepare(mac: selected, repository: repository.trimmingCharacters(in: .whitespacesAndNewlines), name: name, token: token) else { error = "Use a GitHub repository URL and a runner name of 1–64 characters."; return }
+                        token = ""; error = nil
+                        running = Machines.shared.fittedForStart(selected)
+                    }.disabled(machines.all.isEmpty)
+                    if let error { Text(error).foregroundStyle(.red) }
+                }
+                Section("Automatic startup") {
+                    Text("Install or update the Mac companion once using Details › Sharing inside the running Mac. Then this button starts or resumes macOS and launches the runner without opening Terminal. The Mac must log in to its user account; unlock FileVault or the login screen if needed.")
+                    Text("Henge installs the official ARM64 GitHub runner after verifying its release SHA-256. Xcode and its command line tools must already be installed in the Mac for iOS builds. Use labels [self-hosted, macOS, ARM64, henge] in your workflow. Hosted xcode-27 workflows remain separate.")
+                }
+                Section("Leaving Henge") {
+                    Toggle("Request background processing", isOn: $background).disabled(runner.active)
+                    Toggle("CPU-only background jobs (experimental)", isOn: $cpuBackground).disabled(runner.active)
+                    Text(runner.background).font(.footnote)
+                    Text("CPU mode needs no GPU grant: once the Mac runner is ready, prepare it from the runner dashboard before leaving. Henge pauses briefly, drains graphics, then continues CPU, network and disk work. New graphics commands wait in the guest until you return; GUI tools, Simulator or GPU-dependent builds may stall. Persistent saves require returning to the foreground first. iOS can end the task or terminate Henge. PiP does not provide unlimited execution.")
+                        .font(.footnote).foregroundStyle(.secondary)
+                }
+            }
+            .navigationTitle("GitHub Runner")
+            .onAppear { if macID.isEmpty, let selected { macID = selected.id.uuidString } }
+            .onDisappear { token = "" }
+        }
+    }
+}
diff --git a/ios/Henge/SessionDiagnosticCapture.swift b/ios/Henge/SessionDiagnosticCapture.swift
new file mode 100644
index 0000000..67868a3
--- /dev/null
+++ b/ios/Henge/SessionDiagnosticCapture.swift
@@ -0,0 +1,72 @@
+import Foundation
+import Combine
+
+/// A bounded consumer of SessionView's existing maintenance waiter. No new
+/// sampling timer, per-access instrumentation, key text or pairing secrets.
+@MainActor
+final class SessionDiagnosticCapture: ObservableObject {
+    @Published private(set) var active = false
+    private var end = 0.0
+    private(set) var nextDeadline: Double?
+    private var previous: (Double,HengeVmCounters,HengeVmResources)?
+    func begin() {
+        guard !active else { return }
+        let now = ProcessInfo.processInfo.systemUptime
+        active = true; end = now+30; nextDeadline = now; previous = nil
+        henge_vm_capture_timing(1)
+        HengeLog.log("capture","BEGIN 30s; aggregate process CPU, VM/JIT/memory/network/presentation; replay GPU buffer durations may overlap and exclude other GPU users; no per-access counters enabled")
+    }
+    func stop() {
+        guard active else { return }
+        active = false; nextDeadline = nil; previous = nil
+        henge_vm_capture_timing(0)
+        HengeLog.log("capture","END; share henge.log and henge-native.log; host presentation is not game FPS; no temperature/watts measurement")
+    }
+    func event(_ name: String) {
+        guard active else { return }
+        HengeLog.log("capture-event",name)
+        nextDeadline = ProcessInfo.processInfo.systemUptime
+    }
+    func sample() {
+        guard active else { return }
+        let now = ProcessInfo.processInfo.systemUptime
+        guard now >= (nextDeadline ?? now) else { return }
+        var vm = HengeVmCounters(), resources = HengeVmResources()
+        henge_vm_capture_timing(1) // also handles a newly created replay during this capture
+        henge_vm_counters(&vm); henge_vm_resources(&resources)
+        guard vm.generation==resources.generation, vm.epoch==resources.epoch, vm.state==resources.state else {
+            previous = nil; nextDeadline = min(end,now+5)
+            HengeLog.log("capture","Lifecycle changed during sample; mixed VM statistics discarded")
+            if now>=end { stop() }
+            return
+        }
+        var rates = "baseline"
+        if let (time,oldVM,old) = previous, now>time {
+            let seconds = now-time
+            if old.available & 1 != 0, resources.available & 1 != 0, resources.process_cpu_us >= old.process_cpu_us {
+                rates = String(format:"cpu_core_equivalents=%.3f interval_s=%.3f",Double(resources.process_cpu_us-old.process_cpu_us)/1_000_000/seconds,seconds)
+            } else { rates = "cpu=unavailable" }
+            if vm.generation==oldVM.generation && vm.epoch==oldVM.epoch,
+               vm.gpu_frames>=oldVM.gpu_frames,vm.blocks>=oldVM.blocks,vm.tx>=oldVM.tx,vm.rx>=oldVM.rx {
+                rates += String(format:" blocks_s=%.0f host_presentations_s=%.2f tx=%llu rx=%llu",Double(vm.blocks-oldVM.blocks)/seconds,Double(vm.gpu_frames-oldVM.gpu_frames)/seconds,vm.tx-oldVM.tx,vm.rx-oldVM.rx)
+                if old.available & 16 != 0, resources.available & 16 != 0, resources.replay_gpu_ns>=old.replay_gpu_ns,
+                   resources.replay_gpu_completed>=old.replay_gpu_completed, resources.replay_gpu_unavailable>=old.replay_gpu_unavailable {
+                    rates += String(format:" replay_gpu_ms=%.3f replay_gpu_commands=%llu gpu_timing_unavailable=%llu",Double(resources.replay_gpu_ns-old.replay_gpu_ns)/1_000_000,resources.replay_gpu_completed-old.replay_gpu_completed,resources.replay_gpu_unavailable-old.replay_gpu_unavailable)
+                } else { rates += " replay_gpu_timing=unavailable_or_new_baseline" }
+            } else { rates += " vm_rates=new_epoch" }
+        }
+        previous = (now,vm,resources)
+        let power = ProcessInfo.processInfo.isLowPowerModeEnabled
+        let thermal = ProcessInfo.processInfo.thermalState.rawValue
+        let hz = getenv("HV_HZ").map { String(cString:$0) } ?? "unknown"
+        let policy = getenv("HV_CPU_POLICY").map { String(cString:$0) } ?? "unknown"
+        HengeLog.log("capture", "\(rates) state=\(vm.state) generation=\(vm.generation) epoch=\(vm.epoch) lpm=\(power) thermal=\(thermal) guest_hz=\(hz) cpu_policy=\(policy) cpu_background=\(henge_vm_cpu_background()) available_bits=\(resources.available) footprint=\(resources.footprint) resident=\(resources.resident) headroom=\(resources.headroom) jit_used=\(resources.jit_used) jit_capacity=\(resources.jit_capacity) translations=\(resources.translations) resets=\(resources.full_flushes) pad_delivered=\(resources.gamepad_delivered) pad_coalesced=\(resources.gamepad_coalesced) pad_overflow=\(resources.gamepad_overflow) detailed_counters=\(resources.detailed_counters)")
+        let preferences = UserDefaults.standard
+        HengeLog.log("capture-policy","requested_hz=\(preferences.integer(forKey:EngineTuning.refreshKey)) presentation_cap=\(preferences.integer(forKey:"henge.perf.presentationCap")) power_aware=\(preferences.object(forKey:"henge.perf.lowPowerAware") as? Bool ?? true) link_connected=\(LinkHostService.shared.connected) controls_only=\(LinkHostService.shared.controlOnly) grouped=\(preferences.bool(forKey:EngineTuning.groupsKey)) superblocks=\(preferences.bool(forKey:EngineTuning.superblocksKey))")
+        // Existing cumulative wait/idle/cache reports, only during this capture.
+        // Disabled per-access diagnostics remain explicitly unavailable.
+        henge_vm_log_cache()
+        nextDeadline = min(end,now+5)
+        if now>=end { stop() }
+    }
+}

--- /dev/null
+++ b/tools/henge-runner-agent.h
@@ -0,0 +1,191 @@
+// Included by the existing guest companion: no second launchd job, clipboard
+// loop or daemon. Only a host command can enable this GitHub Actions runner.
+#import <CommonCrypto/CommonDigest.h>
+#include <limits.h>
+
+static BOOL runnerArchiveMatches(NSString *path, NSString *digest) {
+    if (![digest isKindOfClass:NSString.class] || ![digest hasPrefix:@"sha256:"] || digest.length != 71) return NO;
+    NSFileHandle *file = [NSFileHandle fileHandleForReadingAtPath:path];
+    if (!file) return NO;
+    CC_SHA256_CTX hash; CC_SHA256_Init(&hash); BOOL ok = YES;
+    @try { for (;;) { @autoreleasepool {
+        NSData *data = [file readDataOfLength:1024*1024]; if (!data.length) break;
+        CC_SHA256_Update(&hash, data.bytes, (CC_LONG)data.length);
+    } } } @catch (NSException *e) { (void)e; ok = NO; }
+    [file closeFile]; unsigned char bytes[CC_SHA256_DIGEST_LENGTH]; CC_SHA256_Final(bytes, &hash);
+    NSMutableString *actual = [NSMutableString string];
+    for (unsigned i=0; i<sizeof bytes; i++) [actual appendFormat:@"%02x", bytes[i]];
+    return ok && [actual isEqualToString:[digest substringFromIndex:7]];
+}
+
+@interface HengeRunner : NSObject
+@property(nonatomic, strong) NSLock *lock;
+@property(nonatomic, strong) dispatch_queue_t work;
+@property(nonatomic, strong) NSTask *child;
+@property(nonatomic) unsigned long revision;
+@property(nonatomic) int state;
+@end
+
+@implementation HengeRunner
+- (instancetype)init {
+    if ((self = [super init])) {
+        _lock = [NSLock new]; _work = dispatch_queue_create("henge.runner", DISPATCH_QUEUE_SERIAL);
+        _state = 4;
+    }
+    return self;
+}
+- (NSString *)directory {
+    return [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Application Support/Henge/ActionsRunner"];
+}
+- (BOOL)current:(unsigned long)revision {
+    [self.lock lock]; BOOL current = self.revision == revision; [self.lock unlock]; return current;
+}
+- (void)report:(int)state revision:(unsigned long)revision {
+    [self.lock lock]; BOOL current = self.revision == revision; if (current) self.state = state; [self.lock unlock];
+    if (!current) return;
+    int status = 0;
+    request(@"PUT", [NSString stringWithFormat:@"/.henge/runner?seq=%lu", revision],
+            [[NSString stringWithFormat:@"%d", state] dataUsingEncoding:NSUTF8StringEncoding], &status, NULL);
+}
+- (BOOL)run:(NSString *)executable arguments:(NSArray *)arguments environment:(NSDictionary *)environment revision:(unsigned long)revision {
+    NSTask *task = [NSTask new];
+    task.executableURL = [NSURL fileURLWithPath:executable]; task.arguments = arguments;
+    task.currentDirectoryURL = [NSURL fileURLWithPath:self.directory];
+    if (environment) { NSMutableDictionary *env = [NSProcessInfo.processInfo.environment mutableCopy]; [env addEntriesFromDictionary:environment]; task.environment = env; }
+    // Runner diagnostics stay in its private guest _diag directory. Never send
+    // subprocess output to iOS logs, where a registration token could leak.
+    task.standardOutput = NSFileHandle.fileHandleWithNullDevice;
+    task.standardError = NSFileHandle.fileHandleWithNullDevice;
+    task.standardInput = NSFileHandle.fileHandleWithNullDevice;
+    [self.lock lock];
+    if (self.revision != revision) { [self.lock unlock]; return NO; }
+    self.child = task;
+    BOOL launched = [task launchAndReturnError:NULL];
+    [self.lock unlock];
+    if (launched) [task waitUntilExit];
+    [self.lock lock]; if (self.child == task) self.child = nil; [self.lock unlock];
+    return launched && task.terminationStatus == 0 && [self current:revision];
+}
+- (BOOL)download:(unsigned long)revision {
+    // Official release metadata supplies the asset's SHA-256. Refuse downloads
+    // without it, and never execute an unverified archive or a user-supplied URL.
+    NSURL *url = [NSURL URLWithString:@"https://api.github.com/repos/actions/runner/releases/latest"];
+    NSMutableURLRequest *query = [NSMutableURLRequest requestWithURL:url cachePolicy:NSURLRequestReloadIgnoringLocalCacheData timeoutInterval:30];
+    [query setValue:@"Henge-runner-setup" forHTTPHeaderField:@"User-Agent"];
+    __block NSURLResponse *response = nil;
+    __block NSData *metadata = nil;
+    dispatch_semaphore_t arrived = dispatch_semaphore_create(0);
+    NSURLSessionConfiguration *options = NSURLSessionConfiguration.ephemeralSessionConfiguration;
+    options.timeoutIntervalForRequest = options.timeoutIntervalForResource = 30;
+    NSURLSession *session = [NSURLSession sessionWithConfiguration:options];
+    NSURLSessionDataTask *fetch = [session dataTaskWithRequest:query completionHandler:^(NSData *data, NSURLResponse *reply, NSError *error) {
+        if (!error) { metadata = data; response = reply; }
+        dispatch_semaphore_signal(arrived);
+    }];
+    [fetch resume];
+    if (dispatch_semaphore_wait(arrived, dispatch_time(DISPATCH_TIME_NOW, 35*NSEC_PER_SEC))) {
+        [session invalidateAndCancel]; return NO;
+    }
+    [session finishTasksAndInvalidate];

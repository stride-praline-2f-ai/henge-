@@ -0,0 +1,14 @@
+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+flags='-std=c11 -Wall -Wextra -O1 -g -fno-omit-frame-pointer -Icore -Ihost -Idevices'
+# Separate objects: no uninstrumented engine objects or sanitizers in the IPA.
+make -j3 B=build/asan ASFLAGS=-DHV_SANITIZER_HELPERS=1 CFLAGS="$flags -fsanitize=address,undefined" build/asan/test_vm_lifecycle build/asan/test_pvg_lifecycle build/asan/test_jit build/asan/test_mem
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/asan/test_vm_lifecycle
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/asan/test_pvg_lifecycle
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/asan/test_jit
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/asan/test_mem
+# Real concurrent resolver cancellation and idle wakeup paths, independently of JIT code.
+make -j3 B=build/tsan CFLAGS="$flags -fsanitize=thread" build/tsan/test_dns_lifecycle build/tsan/test_idle_ticker
+TSAN_OPTIONS=halt_on_error=1 build/tsan/test_dns_lifecycle
+TSAN_OPTIONS=halt_on_error=1 build/tsan/test_idle_ticker

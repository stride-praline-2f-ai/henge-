+    if (ok) ok = [self run:@"/usr/bin/tar" arguments:@[@"-xzf", archive, @"-C", self.directory] environment:nil revision:revision];
+    [NSFileManager.defaultManager removeItemAtPath:archive error:NULL];
+    if (ok) {
+        ok = [NSFileManager.defaultManager isExecutableFileAtPath:[self.directory stringByAppendingPathComponent:@"bin/Runner.Listener"]] &&
+             [NSFileManager.defaultManager isExecutableFileAtPath:[self.directory stringByAppendingPathComponent:@"run.sh"]] && [self current:revision];
+        // Written only after verified extraction is whole. A partial executable
+        // from a cancelled/failed extraction never bypasses verification on retry.
+        if (ok) ok = [digest writeToFile:[self.directory stringByAppendingPathComponent:@".henge-install-complete"] atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    }
+    return ok;
+}

diff --git a/tests/test_pvg_task_memory.c b/tests/test_pvg_task_memory.c
new file mode 100644
index 0000000..60d7847
--- /dev/null
+++ b/tests/test_pvg_task_memory.c
@@ -0,0 +1,42 @@
+/* Exercise the production task walker with actual guest physical mappings. */
+#include "../devices/pvg_lite.c"
+#include <assert.h>
+
+static uint8_t ram[8 * 0x4000];
+static HvMachine machine;
+static HvPvgLite pvg;
+int main(void) {
+    assert(!hv_machine_init(&machine, 1 << 20));
+    assert(!hv_machine_add_ram(&machine, 0x4000, sizeof ram, ram, 0));
+    pvg.m = &machine; pvg.task_root[1] = 1;
+    uint32_t *root = (void *)ram, *leaf = (void *)(ram + 0x4000);
+    root[0] = 2; root[1] = 1;
+    leaf[0] = 3; leaf[1] = 4; leaf[4095] = 4;
+    memset(ram + 0x8000, 0xa3, 0x4000);
+    memset(ram + 0xc000, 0xa4, 0x4000);
+    uint8_t bytes[32];
+    assert(!hv_pvg_lite_task_read(&pvg, 1, 0x3ff0, bytes, sizeof bytes));
+    for (unsigned i = 0; i < sizeof bytes; i++) assert(bytes[i] == (i < 16 ? 0xa3 : 0xa4));
+    assert(!hv_pvg_lite_task_read(&pvg, 1, 0x3ff0, NULL, sizeof bytes));
+    assert(hv_pvg_lite_task_read(&pvg, 1, 0x7ff0, NULL, sizeof bytes) == -1);
+    assert(hv_pvg_lite_task_read(&pvg, 1, UINT64_MAX - 2, bytes, sizeof bytes) == -1);
+    for (unsigned depth = 1; depth <= 3; depth++) {
+        root[1] = depth;
+        uint64_t pages = 1ull << (12 * depth), end = pages << 14;
+        /* Root bits must not silently wrap into a valid low mapping. */
+        assert(!hv_pvg_lite_task_page(&pvg, 1, end));
+        assert(hv_pvg_lite_task_read(&pvg, 1, end, bytes, 1) == -1);
+        uint32_t out[] = {99,99};
+        hv_pvg_lite_task_pages(&pvg, 1, pages, 2, out);
+        assert(!out[0] && !out[1]);
+    }
+    root[1] = 1;
+    uint32_t out[3] = {99,99,99};
+    hv_pvg_lite_task_pages(&pvg, 1, 4095, 3, out);
+    assert(out[0] == 4 && !out[1] && !out[2]);
+    hv_pvg_lite_task_pages(&pvg, 1, UINT64_MAX, 3, out);
+    assert(!out[0] && !out[1] && !out[2]);
+    assert(hv_pvg_lite_task_read(&pvg, 1, 0, NULL, UINT32_MAX) == -1);
+    hv_machine_free(&machine);
+    puts("PASS GPU task memory: copied and validation-only reads, unmapped blobs, all address widths and batch tail bounds");
+}
diff --git a/tests/test_register_groups.c b/tests/test_register_groups.c
new file mode 100644
index 0000000..ec38398
--- /dev/null
+++ b/tests/test_register_groups.c
@@ -0,0 +1,29 @@
+#include "translate.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+static HvMachine machine;
+static unsigned hot(unsigned mode,const uint32_t *code,unsigned n) {
+    hv_knob[HV_K_GROUPS]=(int)mode;
+    HvBlock block={.va=0x100000,.pa=0x100000};
+    uint64_t before=machine.stats.words_inline;
+    assert(!hv_translate_emit(&machine,&block,code,n));
+    unsigned words=(unsigned)(machine.stats.words_inline-before);
+    printf("register-groups: mode=%u guest=%u inline_words=%u hot_allocation=%u total_words=%u\n",mode,n,words,hv_translate_last_words(),hv_translate_pending_words());
+    return words;
+}
+int main(void) {
+    assert(!hv_machine_init(&machine,4<<20));machine.chain=1;machine.stats_interval=1;
+    const uint32_t stream[]={0xf9400001,0xf9400402,0xf9400803,0xf9400c04,0xd65f03c0};
+    unsigned plain=hot(0,stream,5),selected=hot(2,stream,5);
+    assert(selected+10<plain); /* actual emitter, not a copied cost model */
+    const uint32_t clobber[]={0xf9400001,0xf9400402,0x910004c6,0xf9400803,0xf9400c04,0xd65f03c0};
+    assert(hot(0,clobber,6)==hot(2,clobber,6));
+    assert(hot(2,stream+1,4)+6<hot(0,stream+1,4)); /* three-field objects also reuse the translation */
+    assert(hot(0,stream+2,3)==hot(2,stream+2,3)); /* two accesses stay plain */
+    const uint32_t barrier[]={0xf9400001,0xf9400402,0xf9400803,0xd5033bbf,
+                              0xf9400001,0xf9400402,0xf9400803,0xd65f03c0};
+    assert(hot(2,barrier,8)+12<hot(0,barrier,8)); /* independent groups on both sides of DMB */
+    hv_machine_free(&machine);
+    puts("PASS register groups: real inline-path reduction; scratch clobber and short groups retain reference emission");
+}

+"""Exercise production Swift launch/pause decisions, with native API fixtures.
+The native lifecycle suite separately exercises real snapshots, threads and GPU.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = (root / 'ios/Henge/InstantResume.swift').read_text()
+
+def member(token):
+    start = source.index(token)
+    brace = source.index('{', start)
+    depth, end = 1, brace + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+fixture = r'''
+import Foundation
+struct VirtualMac {
+ let rom=URL(fileURLWithPath:"/rom"), disk=URL(fileURLWithPath:"/disk"), aux=URL(fileURLWithPath:"/aux")
+ let ecid:UInt64=1, seed:UInt64=2
+}
+var boots=0, restores=0, pauses=0, state:Int32=1
+func henge_vm_state()->Int32 { state }
+func henge_vm_pause(_ error:UnsafeMutablePointer<CChar>,_ capacity:Int)->Int32 { pauses+=1;state=4;return 0 }
+func henge_vm_boot(_ a:String,_ b:String,_ c:String,_ d:UInt64,_ e:UInt64,_ f:UInt64,_ g:Int32,_ h:UnsafeMutablePointer<CChar>,_ i:Int)->Int32 { boots+=1;return 11 }
+func henge_vm_resume(_ a:String,_ b:String,_ c:String,_ d:UInt64,_ e:UInt64,_ f:UInt64,_ g:Int32,_ path:String,_ ident:String,_ h:UnsafeMutablePointer<CChar>,_ i:Int)->Int32 {
+ precondition(path=="/snapshot" && ident=="expected-ident");restores+=1;return 22
+}
+enum HengeLog { static func log(_ a:String,_ b:String) {} }
+enum InstantResume {
+ static var enabled=false, exists=false, compatible=false
+ static let queue=DispatchQueue(label:"test.resume")
+ static func hasSave(for mac:VirtualMac)->Bool { exists }
+ static func saved(for mac:VirtualMac,ramMB:UInt64,cpus:Int)->Date? { compatible ? Date() : nil }
+ static func file(for mac:VirtualMac)->URL { URL(fileURLWithPath:"/snapshot") }
+ static func ident(for mac:VirtualMac,ramMB:UInt64,cpus:Int)->String { "expected-ident" }
+ START
+ PAUSE
+}
+@main struct Check {
+ static func main() {
+  var error=[CChar](repeating:0,count:256);let mac=VirtualMac()
+  func start()->Int32 { InstantResume.start(mac,ramMB:8192,cpus:4,error:&error,capacity:error.count) }
+  precondition(start()==11 && boots==1 && restores==0)
+  InstantResume.enabled=true;InstantResume.exists=true;InstantResume.compatible=true
+  precondition(start()==22 && boots==1 && restores==1)
+  InstantResume.compatible=false
+  precondition(start()==(-1) && boots==1 && restores==1)
+  precondition(String(cString:error).contains("saved Mac"))
+  // Invalid saves are preserved; a launch decision never discards them.
+  precondition(InstantResume.exists)
+  InstantResume.enabled=false
+  InstantResume.pause();InstantResume.queue.sync {}
+  precondition(pauses==0 && state==1)
+  var finished=false
+  InstantResume.pause(force:true) { precondition(state==4);finished=true };InstantResume.queue.sync {}
+  precondition(finished)
+  precondition(pauses==1 && state==4)
+  InstantResume.pause(force:true);InstantResume.queue.sync {}
+  precondition(pauses==1)
+  state=1;InstantResume.enabled=true
+  InstantResume.pause();InstantResume.queue.sync {}
+  precondition(pauses==2 && state==4)
+  print("session resume: production restore/cold-boot/reject paths and forced runner pause passed")
+ }
+}
+'''
+fixture = fixture.replace(' START', member('static func start(')).replace(' PAUSE', member('static func pause('))
+with tempfile.TemporaryDirectory(prefix='henge-session-resume-') as folder:
+    folder = Path(folder)
+    (folder / 'main.swift').write_text(fixture)
+    subprocess.run(['swiftc', '-parse-as-library', '-swift-version', '5', str(folder / 'main.swift'), '-o', str(folder / 'check')], check=True)
+    subprocess.run([str(folder / 'check')], check=True, timeout=10)

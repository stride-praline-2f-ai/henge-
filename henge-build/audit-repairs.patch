diff --git a/tools/henge-runner-agent.h b/tools/henge-runner-agent.h
new file mode 100644
index 0000000..1df55f8
--- /dev/null
+++ b/tools/henge-runner-agent.h
@@ -0,0 +1,191 @@
+// Included by the existing guest companion: no second launchd job, clipboard
+// loop or daemon. Only a host command can enable this GitHub Actions runner.
+#import <CommonCrypto/CommonDigest.h>
+#include <limits.h>
+
+static BOOL runnerArchiveMatches(NSString *path, NSString *digest) {
+    if (![digest isKindOfClass:NSString.class] || ![digest hasPrefix:@"sha256:"] || digest.length != 71) return NO;
+    NSFileHandle *file = [NSFileHandle fileHandleForReadingAtPath:path];
+    if (!file) return NO;
+    CC_SHA256_CTX hash; CC_SHA256_Init(&hash); BOOL ok = YES;
+    @try { for (;;) { @autoreleasepool {
+        NSData *data = [file readDataOfLength:1024*1024]; if (!data.length) break;
+        CC_SHA256_Update(&hash, data.bytes, (CC_LONG)data.length);
+    } } } @catch (NSException *e) { (void)e; ok = NO; }
+    [file closeFile]; unsigned char bytes[CC_SHA256_DIGEST_LENGTH]; CC_SHA256_Final(bytes, &hash);
+    NSMutableString *actual = [NSMutableString string];
+    for (unsigned i=0; i<sizeof bytes; i++) [actual appendFormat:@"%02x", bytes[i]];
+    return ok && [actual isEqualToString:[digest substringFromIndex:7]];
+}
+
+@interface HengeRunner : NSObject
+@property(nonatomic, strong) NSLock *lock;
+@property(nonatomic, strong) dispatch_queue_t work;
+@property(nonatomic, strong) NSTask *child;
+@property(nonatomic) unsigned long revision;
+@property(nonatomic) int state;
+@end
+
+@implementation HengeRunner
+- (instancetype)init {
+    if ((self = [super init])) {
+        _lock = [NSLock new]; _work = dispatch_queue_create("henge.runner", DISPATCH_QUEUE_SERIAL);
+        _state = 4;
+    }
+    return self;
+}
+- (NSString *)directory {
+    return [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Application Support/Henge/ActionsRunner"];
+}
+- (BOOL)current:(unsigned long)revision {
+    [self.lock lock]; BOOL current = self.revision == revision; [self.lock unlock]; return current;
+}
+- (void)report:(int)state revision:(unsigned long)revision {
+    [self.lock lock]; BOOL current = self.revision == revision; if (current) self.state = state; [self.lock unlock];
+    if (!current) return;
+    int status = 0;
+    request(@"PUT", [NSString stringWithFormat:@"/.henge/runner?seq=%lu", revision],
+            [[NSString stringWithFormat:@"%d", state] dataUsingEncoding:NSUTF8StringEncoding], &status, NULL);
+}
+- (BOOL)run:(NSString *)executable arguments:(NSArray *)arguments environment:(NSDictionary *)environment revision:(unsigned long)revision {
+    NSTask *task = [NSTask new];
+    task.executableURL = [NSURL fileURLWithPath:executable]; task.arguments = arguments;
+    task.currentDirectoryURL = [NSURL fileURLWithPath:self.directory];
+    if (environment) { NSMutableDictionary *env = [NSProcessInfo.processInfo.environment mutableCopy]; [env addEntriesFromDictionary:environment]; task.environment = env; }
+    // Runner diagnostics stay in its private guest _diag directory. Never send
+    // subprocess output to iOS logs, where a registration token could leak.
+    task.standardOutput = NSFileHandle.fileHandleWithNullDevice;
+    task.standardError = NSFileHandle.fileHandleWithNullDevice;
+    task.standardInput = NSFileHandle.fileHandleWithNullDevice;
+    [self.lock lock];
+    if (self.revision != revision) { [self.lock unlock]; return NO; }
+    self.child = task;
+    BOOL launched = [task launchAndReturnError:NULL];
+    [self.lock unlock];
+    if (launched) [task waitUntilExit];
+    [self.lock lock]; if (self.child == task) self.child = nil; [self.lock unlock];
+    return launched && task.terminationStatus == 0 && [self current:revision];
+}
+- (BOOL)download:(unsigned long)revision {
+    // Official release metadata supplies the asset's SHA-256. Refuse downloads
+    // without it, and never execute an unverified archive or a user-supplied URL.
+    NSURL *url = [NSURL URLWithString:@"https://api.github.com/repos/actions/runner/releases/latest"];
+    NSMutableURLRequest *query = [NSMutableURLRequest requestWithURL:url cachePolicy:NSURLRequestReloadIgnoringLocalCacheData timeoutInterval:30];
+    [query setValue:@"Henge-runner-setup" forHTTPHeaderField:@"User-Agent"];
+    __block NSURLResponse *response = nil;
+    __block NSData *metadata = nil;
+    dispatch_semaphore_t arrived = dispatch_semaphore_create(0);
+    NSURLSessionConfiguration *options = NSURLSessionConfiguration.ephemeralSessionConfiguration;
+    options.timeoutIntervalForRequest = options.timeoutIntervalForResource = 30;
+    NSURLSession *session = [NSURLSession sessionWithConfiguration:options];
+    NSURLSessionDataTask *fetch = [session dataTaskWithRequest:query completionHandler:^(NSData *data, NSURLResponse *reply, NSError *error) {
+        if (!error) { metadata = data; response = reply; }
+        dispatch_semaphore_signal(arrived);
+    }];
+    [fetch resume];
+    if (dispatch_semaphore_wait(arrived, dispatch_time(DISPATCH_TIME_NOW, 35*NSEC_PER_SEC))) {
+        [session invalidateAndCancel]; return NO;
+    }
+    [session finishTasksAndInvalidate];
+    if (metadata.length > 2 * 1024 * 1024 || ![response isKindOfClass:NSHTTPURLResponse.class] || ((NSHTTPURLResponse *)response).statusCode != 200) return NO;
+    NSDictionary *release = metadata ? [NSJSONSerialization JSONObjectWithData:metadata options:0 error:NULL] : nil;
+    if (![release isKindOfClass:NSDictionary.class]) return NO;
+    NSArray *assets = release[@"assets"];
+    if (![assets isKindOfClass:NSArray.class]) return NO;
+    NSDictionary *chosen = nil;
+    for (id asset in assets) {
+        if (![asset isKindOfClass:NSDictionary.class]) continue;
+        NSString *name = asset[@"name"];
+        if ([name isKindOfClass:NSString.class] && [name hasPrefix:@"actions-runner-osx-arm64-"] && [name hasSuffix:@".tar.gz"]) { chosen = asset; break; }
+    }
+    NSString *digest = chosen[@"digest"], *download = chosen[@"browser_download_url"];
+    if (![digest isKindOfClass:NSString.class] || ![digest hasPrefix:@"sha256:"] || digest.length != 71 ||
+        ![download isKindOfClass:NSString.class] || ![download hasPrefix:@"https://github.com/actions/runner/releases/download/"]) return NO;
+    NSString *archive = [self.directory stringByAppendingPathComponent:@"runner.tar.gz.part"];
+    BOOL ok = [self run:@"/usr/bin/curl" arguments:@[@"--fail", @"--location", @"--proto", @"=https", @"--proto-redir", @"=https", @"--max-time", @"600", @"--output", archive, download] environment:nil revision:revision];
+    if (ok) ok = runnerArchiveMatches(archive, digest);
+    if (ok) ok = [self run:@"/usr/bin/tar" arguments:@[@"-xzf", archive, @"-C", self.directory] environment:nil revision:revision];
+    [NSFileManager.defaultManager removeItemAtPath:archive error:NULL];
+    if (ok) {
+        ok = [NSFileManager.defaultManager isExecutableFileAtPath:[self.directory stringByAppendingPathComponent:@"bin/Runner.Listener"]] &&
+             [NSFileManager.defaultManager isExecutableFileAtPath:[self.directory stringByAppendingPathComponent:@"run.sh"]] && [self current:revision];
+        // Written only after verified extraction is whole. A partial executable
+        // from a cancelled/failed extraction never bypasses verification on retry.
+        if (ok) ok = [digest writeToFile:[self.directory stringByAppendingPathComponent:@".henge-install-complete"] atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    }
+    return ok;
+}
+- (void)execute:(NSMutableDictionary *)command revision:(unsigned long)revision {
+    @autoreleasepool {
+        if (![self current:revision]) return;
+        NSString *action = command[@"action"];
+        if ([action isEqual:@"stop"]) { [self report:4 revision:revision]; return; }
+        NSString *repository = command[@"repository"], *name = command[@"name"], *token = command[@"token"];
+        BOOL resume = [action isEqual:@"resume"];
+        if (!resume && (![repository isKindOfClass:NSString.class] || ![name isKindOfClass:NSString.class] || ![token isKindOfClass:NSString.class])) { [self report:3 revision:revision]; return; }
+        if (!resume) {
+            NSRegularExpression *repo = [NSRegularExpression regularExpressionWithPattern:@"^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" options:0 error:NULL];
+            if (!name.length || name.length > 64 || token.length > 1024 || [repo numberOfMatchesInString:repository options:0 range:NSMakeRange(0, repository.length)] != 1) { [self report:3 revision:revision]; return; }
+        }
+        [NSFileManager.defaultManager createDirectoryAtPath:self.directory withIntermediateDirectories:YES attributes:@{NSFilePosixPermissions:@0700} error:NULL];
+        NSString *listener = [self.directory stringByAppendingPathComponent:@"bin/Runner.Listener"];
+        NSString *configuration = [self.directory stringByAppendingPathComponent:@".runner"];
+        BOOL installed = [NSFileManager.defaultManager isExecutableFileAtPath:listener] &&
+                         [NSFileManager.defaultManager fileExistsAtPath:[self.directory stringByAppendingPathComponent:@".henge-install-complete"]];
+        if (!installed) {
+            // Preserve an existing registration if binaries are damaged. Never
+            // overwrite its credentials or silently re-register it elsewhere.
+            if ([NSFileManager.defaultManager fileExistsAtPath:configuration]) { [self report:3 revision:revision]; return; }
+            if (resume) { [self report:3 revision:revision]; return; }
+            [self report:5 revision:revision];
+            if (![self download:revision]) { [self report:3 revision:revision]; return; }
+        }
+        if ([NSFileManager.defaultManager fileExistsAtPath:configuration]) {
+            NSData *data = [NSData dataWithContentsOfFile:configuration];
+            NSDictionary *saved = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL] : nil;
+            if (![saved isKindOfClass:NSDictionary.class] || (!resume && ![saved[@"gitHubUrl"] isEqual:repository])) { [self report:3 revision:revision]; return; }
+        } else {
+            if (resume || !token.length) { [self report:3 revision:revision]; return; }
+            [self report:6 revision:revision];
+            if (![self run:listener arguments:@[@"configure", @"--unattended", @"--url", repository, @"--name", name, @"--labels", @"henge", @"--work", @"_work"]
+                environment:@{@"ACTIONS_RUNNER_INPUT_TOKEN":token} revision:revision]) { [self report:3 revision:revision]; return; }
+        }
+        command[@"token"] = @""; token = nil;
+        // This means the listener process was launched, not that GitHub has
+        // authenticated it or assigned a job. GitHub's runner page is authoritative.
+        [self report:1 revision:revision];
+        NSTask *task = [NSTask new]; task.executableURL = [NSURL fileURLWithPath:[self.directory stringByAppendingPathComponent:@"run.sh"]]; task.arguments = @[];
+        NSMutableDictionary *environment = [NSProcessInfo.processInfo.environment mutableCopy];
+        environment[@"RUNNER_MANUALLY_TRAP_SIG"] = @"1"; task.environment = environment;
+        task.currentDirectoryURL = [NSURL fileURLWithPath:self.directory];
+        task.standardOutput = task.standardError = NSFileHandle.fileHandleWithNullDevice;
+        task.standardInput = NSFileHandle.fileHandleWithNullDevice;
+        [self.lock lock];
+        if (self.revision != revision) { [self.lock unlock]; return; }
+        self.child = task; BOOL started = [task launchAndReturnError:NULL]; [self.lock unlock];
+        if (started) { [self report:2 revision:revision]; [task waitUntilExit]; }
+        [self.lock lock]; if (self.child == task) self.child = nil; [self.lock unlock];
+        [self report:started && task.terminationStatus == 0 ? 4 : 3 revision:revision];
+    }
+}
+- (void)follow {
+    unsigned long seen = ULONG_MAX;
+    for (;;) { @autoreleasepool {
+        int status = 0; unsigned long revision = seen;
+        NSData *data = request(@"GET", [NSString stringWithFormat:@"/.henge/runner?since=%lu", seen], nil, &status, &revision);
+        if (!data || status != 200) { sleep(5); continue; }
+        if (revision == seen) {
+            [self.lock lock]; int state = self.state; [self.lock unlock];
+            [self report:state revision:revision]; continue;
+        }
+        NSMutableDictionary *command = [[NSJSONSerialization JSONObjectWithData:data options:0 error:NULL] mutableCopy];
+        if (![command isKindOfClass:NSDictionary.class] || ![command[@"version"] isEqual:@1] ||
+            ![@[@"start", @"stop", @"resume"] containsObject:command[@"action"] ?: @""]) { sleep(5); continue; }
+        seen = revision;
+        [self.lock lock]; self.revision = revision;
+        if (self.child.running) [self.child terminate];
+        [self.lock unlock];
+        dispatch_async(self.work, ^{ [self execute:command revision:revision]; });
+    } }
+}
+@end

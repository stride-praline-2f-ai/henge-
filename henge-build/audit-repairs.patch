+        fixtureM4=0;M4Performance.applyAutomaticDefaults()
+        precondition(d.string(forKey:EngineTuning.cpuPolicyKey)=="mixed")
+        precondition(d.bool(forKey:EngineTuning.groupsKey))
+        fixtureM4=1;M4Performance.applyAutomaticDefaults()
+        precondition(d.string(forKey:EngineTuning.cpuPolicyKey)=="auto")
+        for key in keys where key != EngineTuning.cpuPolicyKey && key != EngineTuning.refreshKey && key != "henge.perf.codeCacheMB" {
+            precondition(!d.bool(forKey:key))
+        }
+        precondition(d.integer(forKey:EngineTuning.refreshKey)==120)
+        precondition(d.integer(forKey:"henge.perf.codeCacheMB")==1536)

new file mode 100644
index 0000000..da9cdbc
--- /dev/null
+++ b/ios/Henge/Controls/GyroSteering.swift
@@ -0,0 +1,55 @@
+import Foundation
+import Combine
+import CoreMotion
+
+/// One opt-in motion owner. No sensor, timer or network work when disabled,
+/// backgrounded, disconnected or outside the gamepad view.
+@MainActor final class GyroSteeringService: ObservableObject {
+    static let shared=GyroSteeringService()
+    @Published var enabled=false { didSet { if oldValue != enabled { reconcile() } } }
+    @Published private(set) var axis:Int16=0
+    @Published private(set) var status="Gyro off"
+    @Published var fullLockDegrees:Double=UserDefaults.standard.object(forKey:"henge.gyro.lock") as? Double ?? 35 {
+        didSet { UserDefaults.standard.set(fullLockDegrees.isFinite ? min(70,max(15,fullLockDegrees)) : 35,forKey:"henge.gyro.lock");calibrate() }
+    }
+    @Published var inverted=UserDefaults.standard.bool(forKey:"henge.gyro.inverted") {
+        didSet { UserDefaults.standard.set(inverted,forKey:"henge.gyro.inverted");calibrate() }
+    }
+    private let motion=CMMotionManager()
+    private var reference:CMAttitude?
+    private var math=GyroSteeringMath()
+    private var owner:UUID?
+    private var foreground=true
+    private var configuring=false
+    private var generation=UUID()
+    var available:Bool { motion.isDeviceMotionAvailable }
+    var steering:Bool { enabled && available && owner != nil && foreground && !configuring }
+    func acquire(_ id:UUID) { owner=id;foreground=true;reconcile() }
+    func release(_ id:UUID) { guard owner==id else { return };owner=nil;reconcile() }
+    func setForeground(_ active:Bool,owner id:UUID) { guard owner==id else { return };foreground=active;reconcile() }
+    func owns(_ id:UUID)->Bool { owner==id }
+    func setConfigurationVisible(_ visible:Bool) { configuring=visible;reconcile() }
+    func calibrate() { reference=nil;math.reset();axis=0 }
+    private func reconcile() {
+        motion.stopDeviceMotionUpdates();generation=UUID();calibrate()
+        guard steering else { status=available ? "Gyro off" : "Motion sensor unavailable";return }
+        status="Hold comfortably · calibrating…"
+        motion.deviceMotionUpdateInterval=1/60
+        let stamp=generation
+        motion.startDeviceMotionUpdates(to:.main) { [weak self] sample,error in
+            MainActor.assumeIsolated {
+                guard let self,self.generation==stamp,self.steering else { return }
+                guard error==nil,let sample else { self.enabled=false;self.status="Motion unavailable; joystick steering restored";return }
+                guard let reference=self.reference else {
+                    self.reference=sample.attitude.copy() as? CMAttitude;self.status="Tilt to steer";return
+                }
+                guard let relative=sample.attitude.copy() as? CMAttitude else { return }
+                relative.multiply(byInverseOf:reference)
+                let q=relative.quaternion
+                let angle=atan2(2*(q.w*q.z+q.x*q.y),1-2*(q.y*q.y+q.z*q.z))
+                let next=self.math.update(angle:angle,time:sample.timestamp,fullLockDegrees:self.fullLockDegrees,inverted:self.inverted)
+                if next==0 || abs(Int(next)-Int(self.axis))>=32 { self.axis=next }
+            }
+        }
+    }
+}
diff --git a/ios/Henge/Controls/GyroSteeringMath.swift b/ios/Henge/Controls/GyroSteeringMath.swift
new file mode 100644
index 0000000..6b743f6
--- /dev/null
+++ b/ios/Henge/Controls/GyroSteeringMath.swift
@@ -0,0 +1,26 @@
+import Foundation
+
+/// Rotation about the calibrated screen's normal, with a small center deadband.
+/// Horizontal steering replaces LX only; throttle/brake (LY) and all buttons stay.
+struct GyroSteeringMath {
+    private var filtered=0.0
+    private var last:Double?
+    mutating func reset() { filtered=0;last=nil }
+    mutating func update(angle:Double,time:Double,fullLockDegrees:Double,inverted:Bool)->Int16 {
+        guard angle.isFinite,time.isFinite,fullLockDegrees.isFinite else { reset();return 0 }
+        let full=min(70,max(15,fullLockDegrees))*Double.pi/180
+        let bounded=min(1,max(-1,atan2(sin(angle),cos(angle))/full))
+        let dead=0.04
+        let target=abs(bounded)<=dead ? 0 : (bounded<0 ? -1.0 : 1.0)*(abs(bounded)-dead)/(1-dead)
+        let dt=last.map { min(0.1,max(0,time-$0)) } ?? 1/60.0
+        last=time
+        filtered += (target-filtered)*(1-exp(-dt/0.04))
+        if target==0 && abs(filtered)<0.005 { filtered=0 }
+        let result=Int16((min(1,max(-1,filtered))*(inverted ? -32767 : 32767)).rounded())
+        return result
+    }
+    static func merge(_ pad:GamepadState,steering:Int16,enabled:Bool)->GamepadState {
+        guard enabled,pad.connected else { return pad }
+        var result=pad;result.lx=steering;return result
+    }
+}
diff --git a/ios/Henge/Controls/PadInput.swift b/ios/Henge/Controls/PadInput.swift
new file mode 100644
index 0000000..7cc0e18
--- /dev/null
+++ b/ios/Henge/Controls/PadInput.swift
@@ -0,0 +1,40 @@
+import Foundation
+import CoreGraphics
+
+/// Transport-independent finger ownership and full-state production input model.
+/// Drawing and UIKit events use this same model; tests need no synthetic UITouch.
+struct PadInput {
+    struct Finger { var control: PadControl; var point: CGPoint; var start: CGPoint }
+    private(set) var fingers: [Int:Finger] = [:]
+    func active(_ control: PadControl) -> Finger? { fingers.values.first { $0.control == control } }
+    mutating func begin(_ id: Int, point: CGPoint, layout: PadLayout) {
+        guard point.x.isFinite,point.y.isFinite,layout.bounds.contains(point),
+              let control = PadControl.allCases.reversed().first(where:{layout.rect($0).contains(point)}),
+              active(control) == nil else { return }
+        fingers[id] = Finger(control:control,point:point,start:point)
+    }
+    mutating func move(_ id: Int, point: CGPoint) {
+        guard point.x.isFinite,point.y.isFinite,var finger = fingers[id] else { return };finger.point=point;fingers[id]=finger
+    }
+    mutating func end(_ id: Int) { fingers.removeValue(forKey:id) }
+    mutating func release() { fingers.removeAll() }
+    func trigger(_ control: PadControl, layout: PadLayout) -> CGFloat {
+        guard let finger=active(control) else { return 0 }
+        return max(0,min(1,1-(finger.point.y-finger.start.y)/(layout.rect(control).height*0.9)))
+    }
+    func state(tuning: GamepadTuning, layout: PadLayout) -> GamepadState {
+        var state=GamepadState();state.mouseSpeed=UInt16(tuning.normalized.mouseLookSpeed.rounded())
+        for finger in fingers.values {
+            let c=finger.control,r=layout.rect(c)
+            if c == .move || c == .look {
+                let axes=tuning.stick(x:Double((finger.point.x-r.midX)/(r.width*0.32)),y:Double((finger.point.y-r.midY)/(r.height*0.32)),right:c == .look)
+                if c == .move { state.lx=axes.0;state.ly=axes.1 } else { state.rx=axes.0;state.ry=axes.1 }
+            } else if c == .dpad {
+                state.hat=GamepadTuning.hat(x:Double((finger.point.x-r.midX)/(r.width/2)),y:Double((finger.point.y-r.midY)/(r.height/2)))
+            } else if c == .lt { state.left=UInt8((trigger(c,layout:layout)*255).rounded()) }
+            else if c == .rt { state.right=UInt8((trigger(c,layout:layout)*255).rounded()) }
+            else { state.buttons |= c.mask }
+        }
+        return state
+    }
+}
diff --git a/ios/Henge/Controls/TouchpadTuning.swift b/ios/Henge/Controls/TouchpadTuning.swift
new file mode 100644
index 0000000..f4bf2f7
--- /dev/null
+++ b/ios/Henge/Controls/TouchpadTuning.swift
@@ -0,0 +1,39 @@
+import Foundation
+import Combine
+
+struct TouchpadTuning: Codable, Equatable {
+    var pointerSpeed = 1.0
+    var scrollSpeed = 1.0
+    var normalized: Self {
+        var result=self
+        result.pointerSpeed=pointerSpeed.isFinite ? min(3,max(0.25,pointerSpeed)) : 1
+        result.scrollSpeed=scrollSpeed.isFinite ? min(3,max(0.25,scrollSpeed)) : 1
+        return result
+    }
+}
+
+/// Retain fractional motion without timers; reset between gestures or settings.
+struct TouchpadMotion {
+    private var x=0.0,y=0.0
+    mutating func reset() { x=0;y=0 }
+    mutating func consume(dx:Double,dy:Double,multiplier:Double)->(Int,Int) {
+        guard dx.isFinite,dy.isFinite,multiplier.isFinite,multiplier>0 else { reset();return (0,0) }
+        x += dx*multiplier;y += dy*multiplier
+        x=min(4096,max(-4096,x));y=min(4096,max(-4096,y))
+        let output=(Int(x),Int(y));x -= Double(output.0);y -= Double(output.1)
+        return output
+    }
+}
+
+@MainActor final class TouchpadPreferences: ObservableObject {
+    static let shared=TouchpadPreferences()
+    private let defaults:UserDefaults
+    @Published var value:TouchpadTuning {
+        didSet { if let data=try? JSONEncoder().encode(value.normalized) { defaults.set(data,forKey:"henge.touchpad.tuning.v1") } }
+    }
+    init(defaults:UserDefaults = .standard) {
+        self.defaults=defaults
+        if let data=defaults.data(forKey:"henge.touchpad.tuning.v1"),let saved=try? JSONDecoder().decode(TouchpadTuning.self,from:data) { value=saved.normalized }
+        else { value=TouchpadTuning() }
+    }
+}

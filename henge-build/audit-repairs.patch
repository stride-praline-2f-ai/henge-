+    0x05,0x01,0x09,0x39,0x15,0x00,0x25,0x07,0x35,0x00,0x46,0x3b,0x01,0x65,0x14,
+    0x75,0x04,0x95,0x01,0x81,0x42,0x75,0x04,0x95,0x01,0x81,0x01,
+    0x65,0x00,0x35,0x00,0x45,0x00,
+    0x09,0x30,0x09,0x31,0x09,0x33,0x09,0x34,0x16,0x01,0x80,0x26,0xff,0x7f,
+    0x75,0x10,0x95,0x04,0x81,0x02,
+    0x09,0x32,0x09,0x35,0x15,0x00,0x26,0xff,0x00,0x75,0x08,0x95,0x02,0x81,0x02,0xc0
+};
+static inline void hv_gamepad_pack(uint8_t out[HV_GAMEPAD_BYTES], uint16_t buttons,
+                                  unsigned hat, const int16_t axes[4], uint8_t left, uint8_t right) {
+    out[0]=(uint8_t)buttons;out[1]=(uint8_t)(buttons>>8);out[2]=hat<8?(uint8_t)hat:8;
+    for(unsigned i=0;i<4;i++) {
+        int16_t v=axes[i]==INT16_MIN ? -32767 : axes[i];
+        out[3+i*2]=(uint8_t)v;out[4+i*2]=(uint8_t)((uint16_t)v>>8);
+    }
+    out[11]=left;out[12]=right;
+}
+static inline void hv_gamepad_neutral(uint8_t out[HV_GAMEPAD_BYTES]) {
+    memset(out,0,HV_GAMEPAD_BYTES);out[2]=8;
+}

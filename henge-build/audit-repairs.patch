diff --git a/devices/display_snapshot.h b/devices/display_snapshot.h
new file mode 100644
index 0000000..57303a2
--- /dev/null
+++ b/devices/display_snapshot.h
@@ -0,0 +1,35 @@
+#ifndef HV_DISPLAY_SNAPSHOT_H
+#define HV_DISPLAY_SNAPSHOT_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#define HV_DISPLAY_SNAPSHOT_VERSION 2u
+#define HV_DISPLAY_SNAPSHOT_PORTS 2u
+typedef struct HvDisplaySnapshotPort {
+    uint64_t mapping;
+    uint32_t width, height, stride, shown;
+    int32_t hot_x, hot_y;
+} HvDisplaySnapshotPort;
+typedef struct HvDisplaySnapshot {
+    uint32_t version, ports;
+    HvDisplaySnapshotPort port[HV_DISPLAY_SNAPSHOT_PORTS];
+} HvDisplaySnapshot;
+/* Validate before allocating or touching any live renderer state. */
+static inline int hv_display_snapshot_parse(const void *in, size_t len,
+                                            HvDisplaySnapshot *out, size_t bytes[2]) {
+    if (!in || len < sizeof *out) return -1;
+    memcpy(out, in, sizeof *out);
+    if (out->version != HV_DISPLAY_SNAPSHOT_VERSION || out->ports != 2) return -1;
+    size_t total = sizeof *out;
+    for (unsigned p = 0; p < 2; p++) {
+        const HvDisplaySnapshotPort *d = &out->port[p];
+        if (d->shown > 1 || d->width > 512 || d->height > 512 || d->stride > 8192) return -1;
+        if ((!d->width || !d->height) && (d->width || d->height || d->stride)) return -1;
+        if (d->stride < d->width * 4) return -1;
+        bytes[p] = (size_t)d->stride * d->height;
+        if (bytes[p] > len - total) return -1;
+        total += bytes[p];
+    }
+    return total == len ? 0 : -1;
+}
+#endif
diff --git a/devices/gpu_copy_bounds.h b/devices/gpu_copy_bounds.h
new file mode 100644
index 0000000..803678a
--- /dev/null
+++ b/devices/gpu_copy_bounds.h
@@ -0,0 +1,20 @@
+#ifndef HV_GPU_COPY_BOUNDS_H
+#define HV_GPU_COPY_BOUNDS_H
+#include <stdint.h>
+/* Checked arithmetic for one complete mip/array slice; no partial-copy claim. */
+static inline int hv_gpu_copy_range(uint64_t base, uint64_t stride, uint64_t slice,
+    uint64_t offset, uint64_t row, uint32_t height, uint32_t depth, uint32_t block_height,
+    uint64_t length, uint64_t *from, uint64_t *image) {
+    if (!row || !height || !depth || !block_height || base > length) return 0;
+    if (slice && stride > (length - base) / slice) return 0;
+    uint64_t start = base + stride * slice;
+    if (offset > length - start) return 0;
+    start += offset;
+    uint64_t rows = ((uint64_t)height + block_height - 1) / block_height;
+    if (rows > (length - start) / row) return 0;
+    uint64_t plane = rows * row;
+    if (depth > (length - start) / plane) return 0;
+    *from = start; *image = plane;
+    return 1;
+}
+#endif

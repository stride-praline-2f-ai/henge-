@@ -0,0 +1,201 @@
+import SwiftUI
+import BackgroundTasks
+import UIKit
+
+/// One owner for the opt-in guest runner and its iOS execution grant. The
+/// registration token is transient; GitHub stores the runner credential in the
+/// selected guest, never in Henge's shared folder or UserDefaults.
+@MainActor
+final class RunnerMode: ObservableObject {
+    static let shared = RunnerMode()
+    @Published private(set) var active = false
+    @Published private(set) var status = "Not started"
+    @Published private(set) var background = "Keep Henge visible, or use Split View."
+    @Published private(set) var preparingCPU = false
+    @Published private(set) var cpuPrepared = false
+    private var grantCPU = false
+    private var preparationID = UUID()
+    private var macID: UUID?
+    private var command: String?
+    private var revision: UInt = 0
+    private var continued: AnyObject?
+    private var submitted = false
+    private var registeredIdentifiers = Set<String>()
+    private var requestIdentifier: String?
+    private var expired: ((@escaping () -> Void) -> Void)?
+
+    static let repositoryKey = "henge.runner.repository"
+    static let nameKey = "henge.runner.name"
+    static let macKey = "henge.runner.mac"
+    static let backgroundKey = "henge.runner.background"
+    static let cpuBackgroundKey = "henge.runner.cpuBackground"
+    var usesCPUBackground: Bool { UserDefaults.standard.object(forKey: Self.cpuBackgroundKey) as? Bool ?? true }
+    static func valid(repository: String, name: String) -> Bool {
+        repository.range(of: #"\Ahttps://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\z"#, options: .regularExpression) != nil &&
+        !name.isEmpty && name.count <= 64 && !name.unicodeScalars.contains { CharacterSet.controlCharacters.contains($0) }
+    }
+    func prepare(mac: VirtualMac, repository: String, name: String, token: String) -> Bool {
+        guard Self.valid(repository: repository, name: name), token.count <= 1024,
+              let data = try? JSONSerialization.data(withJSONObject: ["version": 1, "action": "start", "repository": repository, "name": name, "token": token]),
+              let json = String(data: data, encoding: .utf8) else { return false }
+        end()
+        macID = mac.id; command = json; active = true
+        status = "Waiting for the Mac companion"
+        return true
+    }
+    func booted(_ mac: VirtualMac, expired: @escaping (@escaping () -> Void) -> Void) {
+        guard active, macID == mac.id else { return }
+        self.expired = expired
+        if let command { revision = hv_share_runner_set(command); self.command = nil }
+        if revision == 0 { status = "Could not send runner configuration"; return }
+        requestBackground()
+    }
+    /// Uses session maintenance while the runner is active. No independent polling timer.
+    func refresh() {
+        guard active else { return }
+        if henge_vm_state() == 4 {
+            if status != "Mac paused — runner jobs cannot progress" { status = "Mac paused — runner jobs cannot progress" }
+            return
+        }
+        var age: Int = -1
+        let value = hv_share_runner_status(&age)
+        let labels = ["Waiting for updated Mac companion", "Starting listener", "Listener running — check GitHub for online/job status",
+                      "Runner setup failed — check the guest’s ActionsRunner/_diag logs and registration token", "Runner stopped",
+                      "Downloading and verifying GitHub runner", "Registering with GitHub"]
+        let message = age > 70 ? "Mac companion not responding" : labels.indices.contains(Int(value)) ? labels[Int(value)] : "Unknown runner status"
+        if message != status { status = message }
+    }
+    var mayRunInBackground: Bool { continued != nil && (!grantCPU || cpuPrepared) }
+    func prepareCPUBackground() {
+        guard active, !preparingCPU, usesCPUBackground, UIApplication.shared.applicationState == .active else { return }
+        guard UserDefaults.standard.bool(forKey: Self.backgroundKey) else {
+            background = "Enable background processing before starting the runner."; return
+        }
+        var companionAge: Int = -1
+        guard hv_share_runner_status(&companionAge) == 2, (0...70).contains(companionAge) else {
+            background = "Wait for the Mac companion to report Listener running before preparing CPU background jobs."; return
+        }
+        guard LinkHostService.shared.mode == nil else {
+            background = "Disconnect the extended display and restart without it before CPU-only background work. Video encoding needs GPU access."; return
+        }
+        finishBackground(success: true)
+        let id = UUID(); preparationID = id; preparingCPU = true
+        background = "Preparing CPU background work: pausing and draining graphics in the foreground…"
+        InstantResume.prepareCPUBackground { rc,reason in
+                guard self.preparationID == id, self.active else {
+                    // The scene/end transition already queued its pause,
+                    // restoration or destruction. A stale callback must not
+                    // undo a newer preparation on that same transition queue.
+                    return
+                }
+                self.preparingCPU = false
+                guard rc == 0 else { self.background = reason; return }
+                self.cpuPrepared = true
+                HengeLog.log("runner", "CPU background prepared; guest GPU commands retained; CPU/network/disk live; no GPU resource request")
+                guard UIApplication.shared.applicationState == .active else {
+                    InstantResume.pause(force: true)
+                    self.background = "Preparation was interrupted. Return to Henge before requesting CPU background work."
+                    return
+                }
+                self.requestBackground()
+        }
+    }
+    func end() {
+        preparationID = UUID(); preparingCPU = false; cpuPrepared = false
+        if active { _ = hv_share_runner_set(#"{"version":1,"action":"stop"}"#) }
+        active = false; macID = nil; command = nil; revision = 0; expired = nil
+        finishBackground(success: true)
+        status = "Not started"
+    }
+    func returnedToForeground() {
+        if preparingCPU { preparationID = UUID(); preparingCPU = false }
+        cpuPrepared = false
+        if grantCPU { finishBackground(success: true) }
+        if active { requestBackground() }
+    }
+    func requestBackground() {
+        guard active, !submitted, continued == nil else { return }
+        guard UserDefaults.standard.bool(forKey: Self.backgroundKey) else {
+            background = "Background processing is off. Keep Henge visible, or use Split View."; return
+        }
+        #if compiler(>=6.2)
+        if #available(iOS 26.0, *) {
+            let cpuOnly = usesCPUBackground
+            if cpuOnly && !cpuPrepared {
+                background = "When the runner is ready, tap Prepare CPU Background before leaving Henge."; return
+            }
+            guard cpuOnly || (BGTaskScheduler.supportedResources.contains(.gpu) && Entitlements.has(BackgroundExecutionStatus.gpuEntitlement)) else {
+                background = "This install cannot run the Mac’s GPU in the background. Keep Henge visible or use Split View; PiP does not grant GPU access."; return
+            }
+            let identifier = (Bundle.main.bundleIdentifier ?? "com.henge.app") + (cpuOnly ? ".runner.cpu" : ".runner.session")
+            if !registeredIdentifiers.contains(identifier) {
+                let registered = BGTaskScheduler.shared.register(forTaskWithIdentifier: identifier, using: .main) { task in
+                    guard let task = task as? BGContinuedProcessingTask else { task.setTaskCompleted(success: false); return }
+                    MainActor.assumeIsolated { RunnerMode.shared.attach(task) }
+                }
+                if registered { registeredIdentifiers.insert(identifier) }
+            }
+            guard registeredIdentifiers.contains(identifier) else { background = "iOS refused background task registration. Keep Henge visible."; return }
+            let request = BGContinuedProcessingTaskRequest(identifier: identifier, title: "Henge Mac runner", subtitle: "Running the selected Mac for GitHub Actions")
+            request.strategy = .fail; request.requiredResources = cpuOnly ? [] : .gpu
+            do {
+                grantCPU = cpuOnly
+                requestIdentifier = identifier
+                try BGTaskScheduler.shared.submit(request); submitted = true
+                background = "Waiting for iOS background permission. Keep Henge visible until granted."
+            } catch {
+                if cpuOnly {
+                    cpuPrepared = false
+                    if UIApplication.shared.applicationState == .active { InstantResume.restoreForegroundGraphics() }
+                    else { InstantResume.pause(force: true) }
+                }
+                background = "iOS declined background processing. Keep Henge visible or use Split View."
+            }
+            return
+        }
+        #endif
+        background = "Continued background processing needs iOS 26 or later. Keep Henge visible."
+    }
+    #if compiler(>=6.2)
+    @available(iOS 26.0, *)
+    private func attach(_ task: BGContinuedProcessingTask) {
+        guard task.identifier == requestIdentifier, active, continued == nil,
+              task.identifier.hasSuffix(".runner.cpu") == grantCPU, !grantCPU || cpuPrepared else {
+            task.setTaskCompleted(success: false); return
+        }
+        submitted = false
+        continued = task
+        // No invented completion percentage for an idle listener. The user or
+        // iOS can end this task at any time; it is not an always-on service.
+        task.progress.totalUnitCount = 1
+        task.expirationHandler = { DispatchQueue.main.async {
+            let owner = RunnerMode.shared
+            guard owner.continued === task else { return }
+            owner.continued = nil
+            owner.cpuPrepared = false
+            owner.background = "iOS ended background processing. The Mac was paused."
+            // Quiesce GPU work before completing the task and relinquishing its
+            // resource grant. OS expiration can still impose its own deadline.
+            if let expire = owner.expired {
+                expire { DispatchQueue.main.async { task.setTaskCompleted(success: false) } }
+            } else { task.setTaskCompleted(success: false) }
+        } }
+        background = grantCPU
+            ? "CPU background granted. CPU/network/disk jobs may continue; graphics jobs wait for Henge to return. iOS can end this task."
+            : "iOS granted background GPU processing. iOS may end it; this is not unlimited execution."
+        HengeLog.log("runner", "continued grant=\(grantCPU ? "CPU" : "GPU"); prepared=\(cpuPrepared)")
+    }
+    #endif
+    private func finishBackground(success: Bool) {
+        #if compiler(>=6.2)
+        if #available(iOS 26.0, *), let task = continued as? BGContinuedProcessingTask {
+            if success { task.progress.completedUnitCount = 1 }
+            task.setTaskCompleted(success: success)
+        }
+        if #available(iOS 26.0, *), submitted, let requestIdentifier {
+            BGTaskScheduler.shared.cancel(taskRequestWithIdentifier: requestIdentifier)
+        }
+        #endif
+        continued = nil; submitted = false; requestIdentifier = nil
+    }
+}

+import Foundation
+@main struct Check {
+    @MainActor static func main() async {
+        var ticks=0
+        let delayed=await ClipboardDelivery.wait(isCurrent:{true},isDelivered:{ticks>=7},attempts:10,sleep:{ticks+=1})
+        precondition(delayed == .delivered && ticks==7)
+        ticks=0

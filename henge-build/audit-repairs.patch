+#import <AppKit/AppKit.h>
+#include <assert.h>
+#include <sys/stat.h>
+#include <unistd.h>
+static NSCondition *condition;
+static int reported;
+static NSData *request(NSString *method, NSString *path, NSData *body, int *status, unsigned long *seq) {
+    (void)method; (void)path; (void)seq;
+    [condition lock]; reported = [[NSString alloc] initWithData:body encoding:NSUTF8StringEncoding].intValue;
+    [condition broadcast]; [condition unlock]; *status = 204; return [NSData data];
+}
+#include "../tools/henge-runner-agent.h"
+static NSString *testDirectory;
+@interface TestRunner : HengeRunner @end
+@implementation TestRunner
+- (NSString *)directory { return testDirectory; }
+@end
+static void waitFor(int status) {
+    [condition lock]; NSDate *limit = [NSDate dateWithTimeIntervalSinceNow:5];
+    while (reported != status) assert([condition waitUntilDate:limit]);
+    [condition unlock];
+}
+int main(void) { @autoreleasepool {
+    alarm(20); condition = [NSCondition new];
+    testDirectory = [NSTemporaryDirectory() stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    [NSFileManager.defaultManager createDirectoryAtPath:[testDirectory stringByAppendingPathComponent:@"bin"] withIntermediateDirectories:YES attributes:nil error:NULL];
+    NSString *listener = [testDirectory stringByAppendingPathComponent:@"bin/Runner.Listener"];
+    [@"#!/bin/sh\nexec /bin/sleep 30\n" writeToFile:listener atomically:YES encoding:NSUTF8StringEncoding error:NULL]; chmod(listener.fileSystemRepresentation, 0700);
+    NSString *wrapper = [testDirectory stringByAppendingPathComponent:@"run.sh"];
+    [@"#!/bin/sh\nexec /bin/sleep 30\n" writeToFile:wrapper atomically:YES encoding:NSUTF8StringEncoding error:NULL]; chmod(wrapper.fileSystemRepresentation, 0700);
+    [@"{\"gitHubUrl\":\"https://github.com/example/repo\"}" writeToFile:[testDirectory stringByAppendingPathComponent:@".runner"] atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    NSString *marker = [testDirectory stringByAppendingPathComponent:@".henge-install-complete"];
+    [@"verified-test-fixture" writeToFile:marker atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    NSString *archive = [testDirectory stringByAppendingPathComponent:@"archive"];
+    [@"abc" writeToFile:archive atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    NSString *digest = @"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
+    assert(runnerArchiveMatches(archive, digest));
+    [@"tampered" writeToFile:archive atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    assert(!runnerArchiveMatches(archive, digest));
+    assert(!runnerArchiveMatches(archive, @"sha256:invalid"));
+    assert(!runnerArchiveMatches(@"/nonexistent/henge/runner", digest));
+    TestRunner *runner = [TestRunner new]; runner.revision = 1;
+    NSMutableDictionary *command = [@{@"version":@1, @"action":@"start", @"repository":@"https://github.com/example/repo", @"name":@"test", @"token":@"private"} mutableCopy];
+    dispatch_async(runner.work, ^{ [runner execute:command revision:1]; });
+    waitFor(2); assert([command[@"token"] isEqual:@""]);
+    [runner.lock lock]; runner.revision = 2; [runner.child terminate]; [runner.lock unlock];
+    dispatch_async(runner.work, ^{ [runner execute:[@{@"action":@"stop"} mutableCopy] revision:2]; });
+    waitFor(4); dispatch_sync(runner.work, ^{}); assert(!runner.child);
+    // Repository mismatch never launches/reconfigures an existing runner.
+    runner.revision = 3; command[@"repository"] = @"https://github.com/other/repo";
+    [runner execute:command revision:3]; waitFor(3); assert(!runner.child);
+    // Stale queued start cannot restart a stopped session.
+    [runner execute:command revision:1]; assert(!runner.child);
+    // A partial extraction cannot be executed or overwrite a registration.
+    [NSFileManager.defaultManager removeItemAtPath:marker error:NULL];
+    runner.revision = 4; command[@"repository"] = @"https://github.com/example/repo";
+    [runner execute:command revision:4]; waitFor(3); assert(!runner.child);
+    [NSFileManager.defaultManager removeItemAtPath:testDirectory error:NULL];

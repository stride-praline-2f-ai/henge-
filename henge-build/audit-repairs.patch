+        guard ownership.claim(.hardware) else { return true }
+        cancelSurface?()
+        PointerLock.set(true)
+        NotificationCenter.default.post(name: changed, object: nil)
+        return true
+    }
+    static func cancel() {
+        ownership.reset(); cancelSurface?()
+    }
+}

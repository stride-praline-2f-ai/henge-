+        surfaceID = ObjectIdentifier(view); cancelSurface = cancel
+    }
+    static func uninstall(_ view: UIView) {
+        guard surfaceID == ObjectIdentifier(view) else { return }
+        cancelSurface = nil; surfaceID = nil; ownership.reset()
+    }

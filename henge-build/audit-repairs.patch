+    NSString *archive = [self.directory stringByAppendingPathComponent:@"runner.tar.gz.part"];
+    BOOL ok = [self run:@"/usr/bin/curl" arguments:@[@"--fail", @"--location", @"--proto", @"=https", @"--proto-redir", @"=https", @"--max-time", @"600", @"--output", archive, download] environment:nil revision:revision];

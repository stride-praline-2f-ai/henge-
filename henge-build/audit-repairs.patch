+        // authenticated it or assigned a job. GitHub's runner page is authoritative.
+        [self report:1 revision:revision];
+        NSTask *task = [NSTask new]; task.executableURL = [NSURL fileURLWithPath:[self.directory stringByAppendingPathComponent:@"run.sh"]]; task.arguments = @[];
+        NSMutableDictionary *environment = [NSProcessInfo.processInfo.environment mutableCopy];
+        environment[@"RUNNER_MANUALLY_TRAP_SIG"] = @"1"; task.environment = environment;
+        task.currentDirectoryURL = [NSURL fileURLWithPath:self.directory];
+        task.standardOutput = task.standardError = NSFileHandle.fileHandleWithNullDevice;
+        task.standardInput = NSFileHandle.fileHandleWithNullDevice;
+        [self.lock lock];
+        if (self.revision != revision) { [self.lock unlock]; return; }
+        self.child = task; BOOL started = [task launchAndReturnError:NULL]; [self.lock unlock];
+        if (started) { [self report:2 revision:revision]; [task waitUntilExit]; }
+        [self.lock lock]; if (self.child == task) self.child = nil; [self.lock unlock];
+        [self report:started && task.terminationStatus == 0 ? 4 : 3 revision:revision];
+    }
+}
+- (void)follow {
+    unsigned long seen = ULONG_MAX;
+    for (;;) { @autoreleasepool {
+        int status = 0; unsigned long revision = seen;
+        NSData *data = request(@"GET", [NSString stringWithFormat:@"/.henge/runner?since=%lu", seen], nil, &status, &revision);
+        if (!data || status != 200) { sleep(5); continue; }
+        if (revision == seen) {
+            [self.lock lock]; int state = self.state; [self.lock unlock];
+            [self report:state revision:revision]; continue;
+        }
+        NSMutableDictionary *command = [[NSJSONSerialization JSONObjectWithData:data options:0 error:NULL] mutableCopy];
+        if (![command isKindOfClass:NSDictionary.class] || ![command[@"version"] isEqual:@1] ||
+            ![@[@"start", @"stop", @"resume"] containsObject:command[@"action"] ?: @""]) { sleep(5); continue; }
+        seen = revision;
+        [self.lock lock]; self.revision = revision;
+        if (self.child.running) [self.child terminate];
+        [self.lock unlock];
+        dispatch_async(self.work, ^{ [self execute:command revision:revision]; });
+    } }
+}
+@end

diff --git a/tests/benchmark_surface_hash.py b/tests/benchmark_surface_hash.py
new file mode 100644
index 0000000..eef5d30
--- /dev/null
+++ b/tests/benchmark_surface_hash.py
@@ -0,0 +1,28 @@
+"""Report full-content scan cost; this is bandwidth work, not an energy measurement."""
+from pathlib import Path
+import subprocess, tempfile
+root=Path(__file__).resolve().parents[1]
+source=r'''
+#define _POSIX_C_SOURCE 200809L
+#include "surface_hash.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return t.tv_sec+t.tv_nsec*1e-9; }
+__attribute__((noinline)) static uint64_t scan(const uint8_t *p, size_t n) { return hv_surface_hash(p,n); }
+int main(void) {
+ for (unsigned mb=1;mb<=64;mb*=4) {
+  size_t n=(size_t)mb<<20; uint8_t *p=calloc(1,n); if(!p)return 1;
+  uint64_t sum=0; double begin=now(); unsigned repeats=256/mb;
+  for(unsigned i=0;i<repeats;i++){ p[i%n]^=1; sum^=scan(p,n); }
+  double seconds=now()-begin;
+  printf("full-surface-hash: size=%uMiB ms/scan=%.3f GiB/s=%.3f signature=%llx\n",
+   mb,seconds*1000/repeats,(double)n*repeats/seconds/(1ull<<30),(unsigned long long)sum);
+  free(p);
+ }
+ return 0;
+}'''
+with tempfile.TemporaryDirectory() as tmp:
+ c=Path(tmp)/'bench.c';c.write_text(source);exe=Path(tmp)/'bench'
+ subprocess.run(['cc','-O3','-Wall','-Wextra','-Werror','-I'+str(root/'devices'),str(c),'-o',str(exe)],check=True)
+ subprocess.run([str(exe)],check=True)
diff --git a/tests/test_display_snapshot.py b/tests/test_display_snapshot.py
new file mode 100644
index 0000000..7b09ed0
--- /dev/null
+++ b/tests/test_display_snapshot.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Production parser fuzz/bounds checks under address and undefined sanitizers."""
+import pathlib, subprocess, tempfile
+root = pathlib.Path(__file__).resolve().parents[1]
+source = r'''#include "display_snapshot.h"
+#include <assert.h>
+#include <stdlib.h>
+int main(void) {
+    unsigned char data[sizeof(HvDisplaySnapshot) + 128] = {0};
+    HvDisplaySnapshot d = {.version=HV_DISPLAY_SNAPSHOT_VERSION,.ports=2}, out;
+    size_t bytes[2];
+    memcpy(data, &d, sizeof d);
+    assert(!hv_display_snapshot_parse(data, sizeof d, &out, bytes));
+    for (size_t n=0;n<sizeof d;n++) assert(hv_display_snapshot_parse(data,n,&out,bytes));
+    d.port[0]=(HvDisplaySnapshotPort){.width=4,.height=4,.stride=16};
+    d.port[1]=d.port[0]; memcpy(data,&d,sizeof d);
+    assert(!hv_display_snapshot_parse(data,sizeof data,&out,bytes));
+    for (size_t i=0;i<sizeof d;i++) {
+        unsigned char saved=data[i];
+        for (unsigned value=0;value<256;value++) {
+            data[i]=value;
+            for (size_t n=0;n<=sizeof data;n++)
+                (void)hv_display_snapshot_parse(data,n,&out,bytes);
+        }
+        data[i]=saved;
+    }
+    d.port[1].stride=UINT32_MAX; memcpy(data,&d,sizeof d);
+    assert(hv_display_snapshot_parse(data,sizeof data,&out,bytes));
+    return 0;
+}'''
+with tempfile.TemporaryDirectory() as tmp:
+    c=pathlib.Path(tmp)/'parser.c'; c.write_text(source)
+    binary=pathlib.Path(tmp)/'parser'
+    subprocess.run(['cc','-O1','-g','-fsanitize=address,undefined','-Wall','-Wextra','-Werror',
+                    '-I'+str(root/'devices'),str(c),'-o',str(binary)],check=True)
+    subprocess.run([str(binary)],check=True)
+print('Display snapshot parser: two ports, all header mutations and truncations passed ASan/UBSan')

+void hv_cpu_wake(HvCpu *c){(void)c;}
+int hv_machine_add_mmio(HvMachine *m,uint64_t pa,uint64_t size,void *o,
+ uint64_t (*read)(void*,uint64_t,unsigned),void (*write)(void*,uint64_t,uint64_t,unsigned),const char *name){
+ (void)m;(void)pa;(void)size;(void)o;(void)read;(void)write;(void)name;return 0;
+}
+#include GIC_SOURCE
+static double now(void){struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return t.tv_sec+t.tv_nsec*1e-9;}
+int main(void){
+ static HvMachine m;static HvGic g;g.m=&m;m.ncpus=4;g.ctlr=3;
+ pthread_mutexattr_t attr;pthread_mutexattr_init(&attr);pthread_mutexattr_settype(&attr,PTHREAD_MUTEX_RECURSIVE);pthread_mutex_init(&g.mu,&attr);
+ for(int c=0;c<4;c++){g.cpu[c].pmr=255;g.cpu[c].igrpen1=1;g.cpu[c].enabled[27]=g.cpu[c].enabled[30]=1;g.cpu[c].group[27]=g.cpu[c].group[30]=1;g.cpu[c].priority[27]=64;g.cpu[c].priority[30]=96;}
+ double start=now();
+ for(unsigned i=0;i<200000;i++){
+ #ifdef PAIRED
+  hv_gicv3_set_timer_lines(&g,0,i&1,(i>>1)&1);
+ #else
+  hv_gicv3_set_ppi(&g,0,27,i&1);hv_gicv3_set_ppi(&g,0,30,(i>>1)&1);
+ #endif
+ }
+ double elapsed=now()-start;struct rusage use;getrusage(RUSAGE_SELF,&use);
+ printf("{\"iterations\":200000,\"cpu_count\":4,\"arbitrations\":%llu,\"elapsed_ms\":%.6f,\"process_cpu_ms\":%.6f,\"irq_final\":%u}\n",(unsigned long long)arbitrations,elapsed*1000,(use.ru_utime.tv_sec+use.ru_stime.tv_sec)*1000+(use.ru_utime.tv_usec+use.ru_stime.tv_usec)/1000.0,m.percpu[0].irq_line);
+}
diff --git a/tools/thermal/compare_runs.py b/tools/thermal/compare_runs.py
new file mode 100644
index 0000000..cc705bb
--- /dev/null
+++ b/tools/thermal/compare_runs.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+"""Compare controlled trials. Unknown physical measurements stay null; no FPS from coarse frame counters."""
+import argparse,json,re
+from pathlib import Path
+CONDITIONS=('device','os','guest_os','workload','scene','game_settings','resolution','hidpi','refresh_hz','cpus','guest_ram_mb','jit_mb','brightness','charging','case','orientation','ambient_c','start_thermal','warmup_seconds','measurement_seconds','instrumentation')
+def parse_log(text):
+ def last(pat):
+  rows=re.findall(pat,text,re.M);return rows[-1] if rows else None
+ result={'custom_source':last(r'\[boot\] custom source: ([0-9a-f]+)'),
+  'screen':last(r'\[session\] screen (\d+x\d+) retina (true|false)'),
+  'jit_cache':last(r'jit-cache:.*used=([\d.]+)MiB.*full_flushes=(\d+)'),
+  'frame_presented':last(r'^frame-presented: (.*)$'),
+  'gpu_execution':last(r'^hengevm: gpu-execution: (.*)$'),
+  'task_wakeups':last(r'^task-wakeups: (.*)$'),
+  'thermal_transitions':re.findall(r'\[([\d.]+)ms\]\[session\] thermal state: (.*)',text),
+  'panic':bool(re.search(r'^(?!.*\[prev\]).*(?:guest reported a panic|panic\(cpu|unmapped read:)',text,re.M))}
+ # Neither sampled code counters nor a sum of overlapping GPU times is GPU utilization or energy.
+ result.update(game_average_fps=None,game_low1_fps=None,gpu_active_utilization=None,cpu_gpu_power_watts=None,energy_per_displayed_frame_joules=None)
+ return result
+
+def compare(before,after):
+ missing=[k for k in CONDITIONS if k not in before['conditions'] or k not in after['conditions']]
+ different=[k for k in CONDITIONS if k not in missing and before['conditions'][k]!=after['conditions'][k]]
+ return {'controlled_comparison':not missing and not different,'missing_conditions':missing,'different_conditions':different,
+  'before':before,'after':after,'conclusion':'No efficiency or non-regression conclusion without matched conditions, repeated trials and actual measured outcomes.'}
+def main():
+ ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('before',type=Path);ap.add_argument('after',type=Path);ap.add_argument('--output',type=Path,required=True);a=ap.parse_args()
+ runs=[]
+ for p in (a.before,a.after):
+  data=json.loads(p.read_text());data['log_summary']=parse_log((p.parent/data['log']).read_text(errors='replace'));runs.append(data)
+ out=compare(*runs);a.output.write_text(json.dumps(out,indent=2)+'\n');print(json.dumps({'controlled_comparison':out['controlled_comparison'],'missing':out['missing_conditions'],'different':out['different_conditions']}));return 0 if out['controlled_comparison'] else 2
+if __name__=='__main__':raise SystemExit(main())
diff --git a/tools/thermal/run_microbenchmarks.py b/tools/thermal/run_microbenchmarks.py
new file mode 100644
index 0000000..1c8ce38
--- /dev/null
+++ b/tools/thermal/run_microbenchmarks.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Native source microbenchmark, not game FPS or power. Reference is pristine Henge 0.2."""
+import argparse,json,statistics,subprocess
+from pathlib import Path
+ap=argparse.ArgumentParser();ap.add_argument('--reference',type=Path,required=True);ap.add_argument('--output',type=Path,required=True);a=ap.parse_args()
+r=Path(__file__).resolve().parents[2];build=r/'build/thermal';build.mkdir(parents=True,exist_ok=True)
+variants=[('release_0_2',a.reference,False),('candidate_local_ppi',r,False),('candidate_paired',r,True)]
+executables={};results={}
+for name,src,paired in variants:
+ s=(src/'devices/gicv3.c').read_text();needle='static int hppi(HvGic *g, int c, int masked) {'
+ assert needle in s;s=s.replace(needle,needle+'\n    arbitrations++;',1)
+ p=build/(name+'.c');p.write_text(s)
+ exe=build/name
+ cmd=['xcrun','--sdk','macosx','clang','-std=c11','-Wall','-Wextra','-Werror','-O2','-pthread','-I'+str(src/'core'),'-I'+str(src/'devices'),'-I'+str(src/'host'),'-DGIC_SOURCE="'+str(p)+'"']
+ if paired:cmd+=['-DPAIRED=1']
+ subprocess.run(cmd+[str(r/'tools/thermal/bench_gic.c'),'-o',str(exe)],check=True)
+ executables[name]=exe;results[name]=[]
+# Alternate ordering to reduce systematic first/last-run bias; still not a device game benchmark.
+for rep in range(7):
+ names=list(executables)
+ if rep%2:names.reverse()
+ for name in names:results[name].append(json.loads(subprocess.check_output([str(executables[name])],text=True)))
+summary={name:{'median_elapsed_ms':statistics.median(x['elapsed_ms'] for x in rows),'arbitrations':rows[0]['arbitrations'],'runs':rows} for name,rows in results.items()}
+assert all(x['irq_final']==1 for rows in results.values() for x in rows)
+assert summary['candidate_paired']['arbitrations']<summary['release_0_2']['arbitrations']
+out={'kind':'native GIC microbenchmark','power_measured':False,'game_fps_measured':False,'runner_arch':subprocess.check_output(['uname','-m'],text=True).strip(),'results':summary}
+a.output.parent.mkdir(parents=True,exist_ok=True);a.output.write_text(json.dumps(out,indent=2)+'\n');print(json.dumps({k:{x:y for x,y in v.items() if x!='runs'} for k,v in summary.items()},indent=2))

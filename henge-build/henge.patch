+        .onChange(of: remember) { _, value in
+            if !value {
+                do { try LinkPairingStore.shared.forget("viewer"); saved = nil }
+                catch { pairingNotice = error.localizedDescription }
+            }
+        }
+        .onChange(of: wired) { _, _ in if !connecting { selected = nil; discovery.start(wired: wired) } }
+        .onChange(of: connecting) { _, value in
+            if !value, phase == .active {
+                saved = (try? LinkPairingStore.shared.load("viewer", as: LinkSavedPeer.self)) ?? saved
+                discovery.start(wired: wired)
+            }
+        }
+        .onChange(of: viewer.ready) { _, ready in
+            UIApplication.shared.isIdleTimerDisabled = ready
+            // Reveal a real connection failure rather than leaving a hidden
+            // error above a frozen last frame. It can still be hidden again.
+            if !ready { controlsHidden = false }
+        }
+        .statusBarHidden(connecting && controlsHidden)
+        .onChange(of: phase) { _, phase in
+            if phase == .background { viewer.disconnect(); connecting = false; discovery.stop(); UIApplication.shared.isIdleTimerDisabled = false }
+            else if phase == .active, !connecting { discovery.start(wired: wired) }
+            else if phase == .inactive { viewer.send(LinkControl(type: "release")) }
+        }
+        .onDisappear { discovery.stop(); viewer.disconnect(); UIApplication.shared.isIdleTimerDisabled = false }
+    }
+    private func toggleControls() {
+        controlsHidden.toggle()
+        HengeLog.log("link-viewer", "viewer controls hidden=\(controlsHidden); native viewport and video mode unchanged")
+    }
+}
+
+private struct LinkMainDesktopGuide: View {
+    var body: some View {
+        Text("If the Dock or main desktop appears on the Duo, open System Settings → Displays inside macOS, select the iPad display, then choose Use as → Main Display. macOS saves the main-display choice inside this Mac.")
+        Text("Keep the Duo as an extended display. Move any existing windows back to the iPad by dragging their title bars across the shared screen edge. Changing the main display does not necessarily move windows that are already open. The Dock can also follow the pointer to another screen; move to the bottom of the iPad display to bring it back.")
+        Text("All macOS processing stays on the iPad. No macOS install on the Duo, Mac reinstall, video-feed swap or resolution change is needed.")
+    }
+}
+
+/// Native decoded buffers go straight to the system video layer. Its bounds do
+/// not change the guest mode, and .resizeAspect preserves all source pixels.
+private struct LinkVideoSurface: UIViewRepresentable {
+    let viewer: LinkViewerService
+    let toggleControls: () -> Void
+    func makeUIView(context: Context) -> LinkVideoView {
+        let view = LinkVideoView()
+        view.send = { [weak viewer] in viewer?.send($0) }
+        view.toggleControls = toggleControls
+        viewer.onPixel = { [weak view] pixel in view?.show(pixel) }
+        return view
+    }
+    func updateUIView(_ view: LinkVideoView, context: Context) { view.toggleControls = toggleControls }
+    static func dismantleUIView(_ view: LinkVideoView, coordinator: ()) { view.send = nil; view.toggleControls = nil; view.videoLayer.flushAndRemoveImage() }
+}
+private final class LinkVideoView: UIView, UIGestureRecognizerDelegate {
+    override class var layerClass: AnyClass { AVSampleBufferDisplayLayer.self }
+    var videoLayer: AVSampleBufferDisplayLayer { layer as! AVSampleBufferDisplayLayer }
+    var send: ((LinkControl) -> Void)?
+    var toggleControls: (() -> Void)?
+    // The surface is a remote trackpad, not a text editor. Keep iOS's system
+    // three-finger editing menu from taking the local controls gesture.
+    override var editingInteractionConfiguration: UIEditingInteractionConfiguration { .none }
+    override var canBecomeFirstResponder: Bool { true }
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        videoLayer.videoGravity = .resizeAspect; backgroundColor = .black
+        let controls = UITapGestureRecognizer(target: self, action: #selector(toggleViewerControls))
+        controls.numberOfTouchesRequired = 3; controls.numberOfTapsRequired = 1
+        addGestureRecognizer(controls)
+        let pointer = UIPanGestureRecognizer(target: self, action: #selector(pointerPan(_:))); pointer.maximumNumberOfTouches = 1; addGestureRecognizer(pointer)
+        let scroll = UIPanGestureRecognizer(target: self, action: #selector(scroll(_:))); scroll.minimumNumberOfTouches = 2; scroll.maximumNumberOfTouches = 2; addGestureRecognizer(scroll)
+        let click = UITapGestureRecognizer(target: self, action: #selector(click)); addGestureRecognizer(click); click.require(toFail: pointer)
+        let right = UITapGestureRecognizer(target: self, action: #selector(rightClick)); right.numberOfTouchesRequired = 2; addGestureRecognizer(right); right.require(toFail: scroll)
+        let hold = UILongPressGestureRecognizer(target: self, action: #selector(holdButton(_:)))
+        hold.minimumPressDuration = 0.35; hold.delegate = self; addGestureRecognizer(hold)
+    }
+    override func didMoveToWindow() { super.didMoveToWindow(); if window != nil { becomeFirstResponder() } }
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith other: UIGestureRecognizer) -> Bool {
+        gestureRecognizer is UILongPressGestureRecognizer || other is UILongPressGestureRecognizer
+    }
+    @objc private func toggleViewerControls() { toggleControls?() }
+    @objc private func holdButton(_ hold: UILongPressGestureRecognizer) {
+        if hold.state == .began { send?(LinkControl(type: "button", code: 0, down: true)) }
+        if hold.state == .ended || hold.state == .cancelled || hold.state == .failed { send?(LinkControl(type: "button", code: 0, down: false)) }
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+    func show(_ pixel: CVPixelBuffer) {
+        var format: CMVideoFormatDescription?, sample: CMSampleBuffer?
+        guard CMVideoFormatDescriptionCreateForImageBuffer(allocator: nil, imageBuffer: pixel, formatDescriptionOut: &format) == noErr, let format else { return }
+        var timing = CMSampleTimingInfo(duration: .invalid, presentationTimeStamp: .zero, decodeTimeStamp: .invalid)
+        guard CMSampleBufferCreateReadyWithImageBuffer(allocator: nil, imageBuffer: pixel, formatDescription: format, sampleTiming: &timing, sampleBufferOut: &sample) == noErr, let sample else { return }
+        if let attachments = CMSampleBufferGetSampleAttachmentsArray(sample, createIfNecessary: true) as? [NSMutableDictionary], let first = attachments.first { first[kCMSampleAttachmentKey_DisplayImmediately] = true }
+        if videoLayer.status == .failed { videoLayer.flush() }
+        if videoLayer.isReadyForMoreMediaData { videoLayer.enqueue(sample) }
+    }
+    @objc private func pointerPan(_ pan: UIPanGestureRecognizer) {
+        let p = pan.translation(in: self)
+        let dx = max(-4096, min(4096, Int(p.x * contentScaleFactor))), dy = max(-4096, min(4096, Int(p.y * contentScaleFactor)))
+        pan.setTranslation(CGPoint(x: p.x - CGFloat(dx) / contentScaleFactor, y: p.y - CGFloat(dy) / contentScaleFactor), in: self)
+        if dx != 0 || dy != 0 { send?(LinkControl(type: "move", x: dx, y: dy)) }
+    }
+    @objc private func scroll(_ pan: UIPanGestureRecognizer) {
+        let p = pan.translation(in: self)
+        let x = Int(p.x / 6), y = Int(p.y / 6)
+        if x != 0 || y != 0 { pan.setTranslation(CGPoint(x: p.x - CGFloat(x * 6), y: p.y - CGFloat(y * 6)), in: self); send?(LinkControl(type: "scroll", x: max(-4096, min(4096, x)), y: max(-4096, min(4096, y)))) }
+    }
+    private func button(_ n: Int) { send?(LinkControl(type: "button", code: n, down: true)); send?(LinkControl(type: "button", code: n, down: false)) }
+    @objc private func click() { button(0) }
+    @objc private func rightClick() { button(1) }
+    override func pressesBegan(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+        for press in presses { if let key = press.key, (4...231).contains(key.keyCode.rawValue) { send?(LinkControl(type: "key", code: key.keyCode.rawValue, down: true)) } }
+    }
+    override func pressesEnded(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+        for press in presses { if let key = press.key, (4...231).contains(key.keyCode.rawValue) { send?(LinkControl(type: "key", code: key.keyCode.rawValue, down: false)) } }
+    }
+    override func pressesCancelled(_ presses: Set<UIPress>, with event: UIPressesEvent?) { pressesEnded(presses, with: event) }
+}

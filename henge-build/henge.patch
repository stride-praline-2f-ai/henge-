+static inline int hv_pvg_mode_valid(HvPvgDisplayMode m) {
+    return m.width >= 320 && m.height >= 240 && m.width <= 8192 && m.height <= 8192 &&
+        (uint64_t)m.width * m.height <= 33554432 && m.width_mm <= 65535 && m.height_mm <= 65535 &&
+        m.hz >= 24 && m.hz <= 120;

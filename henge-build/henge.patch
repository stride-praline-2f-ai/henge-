diff --git a/tests/test_preview_queue.swift b/tests/test_preview_queue.swift
new file mode 100644
index 0000000..b991fc4
--- /dev/null
+++ b/tests/test_preview_queue.swift
@@ -0,0 +1,22 @@
+import Foundation
+final class State: @unchecked Sendable {
+ let lock = NSLock()
+ var writes = 0
+ func bump() -> Bool { lock.lock(); defer { lock.unlock() }; writes += 1; return true }
+ func count() -> Int { lock.lock(); defer { lock.unlock() }; return writes }
+}
+@main struct Test {
+ static func main() {
+  let q = PreviewWorkQueue(), s = State()
+  for _ in 0..<1000 { q.save(path: "one", frame: { 10 }, write: { s.bump() }) }
+  q.drain(); precondition(s.count() == 1)
+  q.save(path: "one", frame: { 11 }, write: { s.bump() }); q.drain(); precondition(s.count() == 2)
+  q.save(path: "two", frame: { 11 }, write: { s.bump() }); q.drain(); precondition(s.count() == 3)
+  q.beginSession(); q.save(path: "two", frame: { 11 }, write: { s.bump() }); q.drain(); precondition(s.count() == 4)
+  q.save(path: "two", frame: { 12 }, write: { false })
+  q.save(path: "two", frame: { 12 }, write: { s.bump() }); q.drain(); precondition(s.count() == 5)
+  q.save(path: "two", frame: { 13 }, write: { s.bump() })
+  q.finish { precondition(s.count() == 6); return s.bump() }; precondition(s.count() == 7)
+  print("preview queue: 1000 unchanged requests -> one write; changed frames, VM restart, failure retry and final-write ordering passed")
+ }
+}
diff --git a/tests/test_prof_ios.c b/tests/test_prof_ios.c
new file mode 100644
index 0000000..553c4b6
--- /dev/null
+++ b/tests/test_prof_ios.c
@@ -0,0 +1,32 @@
+#include "machine.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+void (*hv_prof_register)(void);void (*hv_prof_unregister)(void);void (*hv_prof_session)(int);
+HvMachine *hv_vm_machine(void){return NULL;}
+void hv_prof_ios_start(void);
+void hv_prof_test_counts(uint64_t*,uint64_t*,unsigned*);
+static void *worker(void *unused){
+ (void)unused;hv_prof_register();hv_prof_register();
+ uint64_t samples,dumps;unsigned ports;hv_prof_test_counts(&samples,&dumps,&ports);assert(ports==1);
+ for(int j=0;j<500000;j++)atomic_signal_fence(memory_order_seq_cst);
+ usleep(unused?100000:25000);if(unused){hv_prof_unregister();hv_prof_test_counts(&samples,&dumps,&ports);assert(!ports);}
+ return NULL;
+}
+int main(void){
+ setenv("HV_PROF_IOS","1",1);setenv("HV_PROF_IOS_HZ","100",1);
+ setenv("HV_PROF_IOS_SECS","0",1);setenv("HV_PROF_IOS_DURATION","1",1);
+ hv_prof_ios_start();assert(hv_prof_register&&hv_prof_session);hv_prof_session(1);
+ for(int i=0;i<24;i++){pthread_t t;assert(!pthread_create(&t,NULL,worker,NULL));pthread_join(t,NULL);}
+ uint64_t samples,dumps;unsigned ports;hv_prof_test_counts(&samples,&dumps,&ports);assert(!ports&&samples>0);
+ usleep(500000);hv_prof_test_counts(&samples,&dumps,&ports);assert(dumps>=1);
+ hv_prof_session(0);usleep(30000);uint64_t stopped=samples;hv_prof_test_counts(&stopped,&dumps,&ports);
+ usleep(50000);hv_prof_test_counts(&samples,&dumps,&ports);assert(samples==stopped);
+ hv_prof_session(1);pthread_t t;pthread_create(&t,NULL,worker,(void*)1);pthread_join(t,NULL);
+ hv_prof_test_counts(&samples,&dumps,&ports);assert(!ports&&samples>stopped);
+ hv_prof_session(0);
+ puts("iOS profiler lifecycle: port reuse across 24 threads, idempotent registration, duration, invalid interval, stopped session sleep and restart passed");
+}

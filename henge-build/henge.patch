new file mode 100644
index 0000000..c434ff9
--- /dev/null
+++ b/ios/Henge/NativeLogTail.swift
@@ -0,0 +1,48 @@
+import Foundation
+import Darwin
+
+/// Mirrors an append-only log when the filesystem reports a write. The raw
+/// writer stays synchronous, so a crash does not depend on this queue running.
+/// The caller owns fd and must keep it open until cancellation completes.
+final class NativeLogTail {
+    private let fd: Int32
+    private let queue = DispatchQueue(label: "com.henge.log.reader", qos: .utility)
+    private let source: DispatchSourceFileSystemObject
+    private let emit: (String) -> Void
+    private var pending = Data()
+    private var buffer = [UInt8](repeating: 0, count: 16 * 1024)
+    private var drains = 0
+
+    init(fd: Int32, emit: @escaping (String) -> Void) {
+        self.fd = fd
+        self.emit = emit
+        source = DispatchSource.makeFileSystemObjectSource(fileDescriptor: fd, eventMask: .write, queue: queue)
+        source.setEventHandler { [weak self] in self?.drain() }
+        source.resume()
+        // Catch bytes written before registration. This and notifications run
+        // on one queue, so overlapping writes cannot duplicate a line.
+        queue.async { [weak self] in self?.drain() }
+    }
+
+    var drainCount: Int { queue.sync { drains } }
+
+    func stop(completion: @escaping () -> Void) {
+        source.setCancelHandler(handler: completion)
+        source.cancel()
+    }
+
+    private func drain() {
+        drains += 1
+        while true {
+            let n = read(fd, &buffer, buffer.count)
+            if n < 0 && errno == EINTR { continue }
+            guard n > 0 else { return }
+            pending.append(contentsOf: buffer[0..<n])
+            while let newline = pending.firstIndex(of: 0x0A) {
+                let line = pending.subdata(in: pending.startIndex..<newline)
+                pending.removeSubrange(pending.startIndex...newline)
+                if let text = String(data: line, encoding: .utf8) { emit(text) }
+            }
+        }
+    }
+}
diff --git a/ios/Henge/NativeTouchSession.swift b/ios/Henge/NativeTouchSession.swift
new file mode 100644
index 0000000..25e7bad
--- /dev/null
+++ b/ios/Henge/NativeTouchSession.swift
@@ -0,0 +1,69 @@
+import Foundation
+import Observation
+
+/// Negotiates the optional guest companion. Trackpad remains the default and fallback.
+@MainActor @Observable
+final class NativeTouchSession {
+    var requested = false {
+        didSet { defaults.set(requested, forKey: Self.preferenceKey) }
+    }
+    private(set) var ready = false
+    private(set) var status: Int32 = 0
+    private static let preferenceKey = "nativeTouchRequested"
+    private let defaults: UserDefaults
+    private let now: () -> TimeInterval
+    private var attempted = false
+    private var wasActive = false
+    private var retryAfter: TimeInterval?
+
+    init(defaults: UserDefaults = .standard,
+         now: @escaping () -> TimeInterval = { ProcessInfo.processInfo.systemUptime }) {
+        self.defaults = defaults
+        self.now = now
+        requested = defaults.bool(forKey: Self.preferenceKey)
+    }
+
+    func changedRequest() {
+        stop()
+        status = 0
+    }
+
+    func poll(active: Bool, helperRunning: Bool) {
+        let wantsInput = requested && active
+        if !wantsInput {
+            if wasActive { stop() }
+            wasActive = false
+            return
+        }
+        wasActive = true
+        // Booting the guest can take much longer than the negotiation timeout.
+        guard helperRunning else {
+            if attempted { stop() }
+            wasActive = true
+            status = 1
+            return
+        }
+        if let retryAfter {
+            guard now() >= retryAfter else { return }
+            self.retryAfter = nil
+            attempted = false
+        }
+        if !attempted {
+            attempted = true
+            hv_native_touch_enable(1)
+        }
+        status = hv_native_touch_status()
+        ready = status == 2
+        // Only transport timeouts are transient. Permission and device errors
+        // remain visible until the user changes the setup or reconnects.
+        if status == 6 { retryAfter = now() + 2 }
+    }
+
+    func stop() {
+        hv_native_touch_enable(0)
+        ready = false
+        attempted = false
+        wasActive = false
+        retryAfter = nil
+    }
+}
diff --git a/ios/Henge/NativeTouchSurface.swift b/ios/Henge/NativeTouchSurface.swift
new file mode 100644
index 0000000..b89dc8a
--- /dev/null
+++ b/ios/Henge/NativeTouchSurface.swift
@@ -0,0 +1,116 @@
+import SwiftUI
+import UIKit
+
+/// Sends full snapshots of up to five contacts in the displayed Mac image.
+/// The supplied rectangle is relative to this overlay, including zoom and letterboxing.
+struct NativeTouchSurface: UIViewRepresentable {
+    let imageRect: CGRect
+    let revealsControls: Bool
+
+    func makeUIView(context: Context) -> Surface { Surface() }
+    func updateUIView(_ view: Surface, context: Context) { view.configure(imageRect, revealsControls: revealsControls) }
+    static func dismantleUIView(_ view: Surface, coordinator: ()) { view.cancel() }
+
+    final class Surface: UIView {
+        private struct Finger {
+            let touch: UITouch
+            let id: UInt8
+            var point: CGPoint
+        }
+        private var fingers: [Finger] = []
+        private var imageRect = CGRect.zero
+        private var generation: UInt32 = 0
+        private var heartbeat: Timer?
+        private var waitForLift = false
+        private var held = Set<UITouch>()
+        private let controlsTap = UITapGestureRecognizer()
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            isMultipleTouchEnabled = true
+            backgroundColor = .clear
+            controlsTap.numberOfTouchesRequired = 3
+            controlsTap.allowedTouchTypes = [NSNumber(value: UITouch.TouchType.direct.rawValue)]
+            controlsTap.cancelsTouchesInView = true
+            controlsTap.isEnabled = false
+            controlsTap.addTarget(self, action: #selector(revealControls))
+            addGestureRecognizer(controlsTap)
+        }
+        required init?(coder: NSCoder) { fatalError("made in code") }
+
+        func configure(_ rect: CGRect, revealsControls: Bool) {
+            if controlsTap.isEnabled != revealsControls {
+                controlsTap.isEnabled = revealsControls
+            }
+            if imageRect != rect {
+                cancel()
+                if imageRect != .zero { hv_native_touch_reset() }
+                imageRect = rect
+                generation = hv_native_touch_epoch()
+                waitForLift = !held.isEmpty
+            }
+            if heartbeat == nil {
+                let timer = Timer(timeInterval: 0.1, repeats: true) { [weak self] _ in self?.send() }
+                RunLoop.main.add(timer, forMode: .common)
+                heartbeat = timer
+            }
+            send()
+        }
+
+        @objc private func revealControls() {
+            cancel()
+            NotificationCenter.default.post(name: Trackpad.threeFingerTap, object: nil)
+        }
+
+        override func didMoveToWindow() {
+            super.didMoveToWindow()
+            if window == nil { cancel(); heartbeat?.invalidate(); heartbeat = nil }
+        }
+
+        func cancel() {
+            fingers.removeAll()
+            _ = hv_native_touch_submit(generation, nil, nil, nil, 0)
+            waitForLift = !held.isEmpty
+        }
+
+        override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent?) {
+            let direct = touches.filter { $0.type == .direct }
+            held.formUnion(direct)
+            guard !waitForLift, hv_native_touch_status() == 2 else { waitForLift = true; return }
+            for touch in direct where fingers.count < 5 {
+                let point = touch.location(in: self)
+                guard imageRect.contains(point) else { continue }
+                let id = (UInt8(1)...UInt8(127)).first { candidate in !fingers.contains { $0.id == candidate } }!
+                fingers.append(Finger(touch: touch, id: id, point: point))
+            }
+            send()
+        }
+
+        override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent?) {
+            guard !waitForLift else { return }
+            for index in fingers.indices where touches.contains(fingers[index].touch) {
+                fingers[index].point = fingers[index].touch.location(in: self)
+            }
+            send()
+        }
+        override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent?) { lift(touches) }
+        override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent?) { cancel(); lift(touches) }
+        private func lift(_ touches: Set<UITouch>) {
+            held.subtract(touches)
+            fingers.removeAll { touches.contains($0.touch) }
+            if held.isEmpty { waitForLift = false }
+            send()
+        }
+        private func send() {
+            guard imageRect.width > 0, imageRect.height > 0 else { return }
+            if generation != hv_native_touch_epoch() {
+                fingers.removeAll(); waitForLift = !held.isEmpty
+                generation = hv_native_touch_epoch()
+            }
+            let ids = fingers.map(\.id)
+            let x = fingers.map { min(1, max(0, Double(($0.point.x-imageRect.minX)/imageRect.width))) }
+            let y = fingers.map { min(1, max(0, Double(($0.point.y-imageRect.minY)/imageRect.height))) }
+            _ = hv_native_touch_submit(generation, ids, x, y, ids.count)
+        }
+    }
+}

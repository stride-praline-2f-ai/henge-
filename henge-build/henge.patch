+/* Production packet parser, resolver loop and reply encoder; only DNS-SD is a
+   deterministic fixture. No external network or Apple-private API is used. */
+#define HV_DNS_TIMEOUT_MS 30
+#include "../host/dns_proxy.c"
+#include <assert.h>
+#include <unistd.h>
+
+int hv_knob[HV_K_COUNT];
+enum Mode { ANSWER, NODATA, NXDOMAIN, START_FAIL, READ_FAIL, TIMEOUT, BAD_FD };
+struct MockDNS { int fd[2]; enum Mode mode; DNSServiceQueryRecordReply callback; void *context; uint16_t type; };
+static enum Mode fixture;
+static atomic_int lookups, callbacks;
+static uint8_t delivered[2048];
+static uint32_t delivered_size;
+static int delivered_to_guest;
+static pthread_mutex_t output_mu = PTHREAD_MUTEX_INITIALIZER;
+
+DNSServiceErrorType DNSServiceQueryRecord(DNSServiceRef *out, DNSServiceFlags flags, uint32_t interface,
+    const char *name, uint16_t type, uint16_t cls, DNSServiceQueryRecordReply cb, void *context) {
+    (void)flags; (void)interface; assert(cls == 1 && !strcmp(name, "example.com."));
+    atomic_fetch_add(&lookups, 1);
+    if (fixture == START_FAIL) return -1;
+    struct MockDNS *r = calloc(1, sizeof *r); assert(r);
+    r->mode = fixture; r->callback = cb; r->context = context; r->type = type;
+    r->fd[0] = r->fd[1] = -1;
+    if (fixture != BAD_FD) {
+        assert(pipe(r->fd) == 0);
+        if (fixture != TIMEOUT) assert(write(r->fd[1], "x", 1) == 1);
+    }
+    *out = r; return 0;
+}
+int DNSServiceRefSockFD(DNSServiceRef r) { return r->fd[0]; }
+DNSServiceErrorType DNSServiceProcessResult(DNSServiceRef r) {
+    char byte; assert(read(r->fd[0], &byte, 1) == 1);
+    if (r->mode == READ_FAIL) return -1;
+    const uint8_t address[16] = {1,2,3,4};
+    int error = r->mode == NODATA ? kDNSServiceErr_NoSuchRecord : r->mode == NXDOMAIN ? kDNSServiceErr_NoSuchName : 0;
+    r->callback(r, error ? 0 : kDNSServiceFlagsAdd, 0, error, "example.com.", r->type, 1,
+                r->type == 28 ? 16 : 4, address, 60, r->context);
+    return 0;
+}
+void DNSServiceRefDeallocate(DNSServiceRef r) {
+    if (r->fd[0] >= 0) close(r->fd[0]);
+    if (r->fd[1] >= 0) close(r->fd[1]);
+    free(r);
+}
+static void output(const uint8_t *bytes, uint32_t length, int guest) {
+    assert(length <= sizeof delivered);
+    pthread_mutex_lock(&output_mu);
+    memcpy(delivered, bytes, length); delivered_size = length; delivered_to_guest = guest;
+    atomic_fetch_add(&callbacks, 1); pthread_mutex_unlock(&output_mu);
+}
+static void wait_idle(void) {
+    int64_t end = now_ms() + 2000;
+    while (atomic_load(&inflight)) {
+        assert(now_ms() < end);
+        struct timespec pause = {0, 1000000}; nanosleep(&pause, NULL);
+    }
+}
+static unsigned query(uint8_t *p, uint16_t type, int edns) {
+    memset(p, 0, 1600);
+    for (int i=0;i<12;i++) p[i]=(uint8_t)i;
+    p[12]=8; p[14]=0x45; p[23]=17;
+    p[26]=10; p[28]=2; p[29]=15; p[30]=10; p[32]=2; p[33]=3;
+    wr16(p+34,30000);wr16(p+36,53);
+    uint8_t *d=p+42;wr16(d,0x1234);d[2]=1;wr16(d+4,1);
+    const uint8_t name[]={7,'e','x','a','m','p','l','e',3,'c','o','m',0};
+    memcpy(d+12,name,sizeof name);unsigned n=12+sizeof name;
+    wr16(d+n,type);wr16(d+n+2,1);n+=4;
+    if(edns){wr16(d+10,1);wr16(d+n+1,41);wr16(d+n+3,1232);n+=11;}
+    wr16(p+38,8+n);wr16(p+16,20+8+n);return 42+n;
+}
+static void reject(uint8_t *p,unsigned n) {
+    int calls=atomic_load(&lookups);assert(!hv_dns_proxy_take(p,n,output));assert(atomic_load(&lookups)==calls);
+}
+int main(void) {
+    uint8_t p[1600];hv_knob[HV_K_DNSPROXY]=1;hv_dns_proxy_reset();
+    for (int mode=ANSWER;mode<=BAD_FD;mode++) for(int aaaa=0;aaaa<2;aaaa++) {
+        hv_dns_proxy_reset();fixture=(enum Mode)mode;
+        unsigned n=query(p,aaaa?28:1,aaaa);int before=atomic_load(&callbacks);
+        assert(hv_dns_proxy_take(p,n,output));wait_idle();assert(atomic_load(&callbacks)==before+1);
+        if(mode>=START_FAIL){assert(!delivered_to_guest && delivered_size==n && !memcmp(p,delivered,n));}
+        else {
+            assert(delivered_to_guest && rd16(delivered+42)==0x1234 && ip_checksum(delivered+14,20)==0);
+            assert(rd16(delivered+48)==(mode==ANSWER?1:0));
+            assert((delivered[45]&15)==(mode==NXDOMAIN?3:0));
+            assert(!memcmp(delivered,p+6,6));
+        }
+    }
+    unsigned n=query(p,1,0);wr16(p+16,1500);reject(p,1514); // old frame-member overwrite
+    n=query(p,1,0);p[14]=0x4f;reject(p,n); // header exceeds packet
+    n=query(p,1,0);p[20]=0x20;reject(p,n); // fragment
+    n=query(p,1,0);p[54]=0xc0;reject(p,n); // compressed question label
+    n=query(p,1,1);wr16(p+n-2,65535);reject(p,n); // impossible EDNS RDLENGTH
+    n=query(p,1,0);wr16(p+38,1000);reject(p,n); // UDP length outside IP
+    n=query(p,1,0);atomic_store(&inflight,64);reject(p,n);atomic_store(&inflight,0);
+    fixture=TIMEOUT;hv_dns_proxy_reset();
+    for(int i=0;i<GIVE_UP;i++){assert(hv_dns_proxy_take(p,n,output));wait_idle();assert(!delivered_to_guest);}
+    assert(!hv_dns_proxy_on() && hv_knob[HV_K_DNSPROXY]==1);reject(p,n); // atomic backoff, knob preserved
+    hv_dns_proxy_reset();fixture=ANSWER;int before=atomic_load(&callbacks);
+    for(int i=0;i<10;i++)assert(hv_dns_proxy_take(p,n,output));wait_idle();assert(atomic_load(&callbacks)==before+10);
+    hv_knob[HV_K_DNSPROXY]=0;reject(p,n);
+    puts("DNS: real parser/reply/threads; A/AAAA, EDNS, NXDOMAIN/NODATA, malformed IP/UDP/DNS bounds, fallback, timeout, invalid fd, saturation and concurrent delivery passed");
+}
diff --git a/tests/test_fastmem.c b/tests/test_fastmem.c
new file mode 100644
index 0000000..01ae3b5
--- /dev/null
+++ b/tests/test_fastmem.c
@@ -0,0 +1,169 @@
+/* Portable tests of the real walker and invalidation paths. No JIT execution.
+   Build with tests/fastmem_portable.sh on Linux; make test-fastmem on macOS. */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "fastmem.h"
+#include "machine.h"
+#include "mmu.h"
+
+static HvMachine m;
+static HvCpu cpu;
+static unsigned char *ram;
+static const uint64_t kernel = 0xfffffe0000010000ull;
+#define PA 0x80000000ull
+#define PG (1u << HV_TLB_PAGE_BITS)
+#define RAM_BYTES (16 * PG)
+
+/* The test never fetches instructions or takes guest exceptions. Portable
+   linking supplies just the platform-dependent symbols retained by mmu.c. */
+#ifdef HENGE_PORTABLE_TEST
+int hv_knob[HV_K_COUNT];
+void hv_ret_clear(HvCpu *c) { memset(c->ret_tab, 0, sizeof c->ret_tab); }
+void hv_cpu_kick(HvCpu *c) { c->exit_req = 1; }
+#endif
+
+static uint64_t *table(unsigned page) { return (uint64_t *)(ram + page * PG); }
+static unsigned leaf_page(uint64_t va) { return ((va ^ kernel) >> 25) ? 8 : 2; }
+static uint64_t *leaf(uint64_t va) { return &table(leaf_page(va))[(va >> 14) & 2047]; }
+static void map(uint64_t va, unsigned page, unsigned ap, unsigned attr) {
+    table(0)[(va >> 36) & 63] = (PA + PG) | 3;
+    table(1)[(va >> 25) & 2047] = (PA + leaf_page(va) * PG) | 3;
+    *leaf(va) = (PA + page * PG) | 3 | 1u << 10 | (uint64_t)ap << 6 | (uint64_t)attr << 2;
+    hv_tlb_flush_va_page(&cpu, va, -1); /* page-table edits require invalidation */
+}
+static void read_ok(uint64_t va, void *want, int pan) {
+    uint64_t pa;
+    cpu.pstate_extra = pan ? HV_PSTATE_PAN : 0;
+    assert(hv_mmu_access(&cpu, va, HV_ACC_READ, 1, &pa) == 0);
+    assert(hv_fastmem_read_ptr(&cpu, va, 8, pan ? 2 : 1) == want);
+}
+
+int main(void) {
+    ram = aligned_alloc(PG, RAM_BYTES);
+    assert(ram);
+    memset(ram, 0, RAM_BYTES);
+    cpu.m = &m;
+    cpu.pc_state = &m.percpu[0];
+    cpu.next_cid = 1;
+    m.fastmem_diagnostics = 1;
+    m.nram = 1;
+    m.ram[0] = (HvRam){.pa = PA, .size = RAM_BYTES, .host = ram, .npages = 16};
+    m.ram[0].code_pages = calloc(16, 1);
+    m.ram[0].whint = calloc(16 * HV_MAX_CPUS, sizeof(uint64_t));
+    assert(m.ram[0].code_pages && m.ram[0].whint);
+    assert(hv_fastmem_attach(&cpu, &cpu.pc_state->fastmem, 0) == 0);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    assert(hv_fastmem_attach(&cpu, &cpu.pc_state->fastmem, 1) == 0);
+    cpu.sctlr_el1 = 1;
+    cpu.ttbr1_el1 = PA;
+    cpu.mair_el1 = 0xff; /* AttrIndx 0 normal, 1 device */
+    cpu.tcr_el1 = 22ull << 16 | 1ull << 30; /* TTBR1 42-bit VA, 16K pages */
+    hv_tlb_tmajor = 1;
+    map(kernel, 3, 2, 0); /* read-only pages are allowed for reads */
+    read_ok(kernel + 40, ram + 3 * PG + 40, 0);
+    *(uint64_t *)(ram + 3 * PG + 40) = 0x12345678;
+    assert(*(uint64_t *)hv_fastmem_read_ptr(&cpu, kernel + 40, 8, 1) == 0x12345678);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel + PG - 8, 8, 1));
+    assert(hv_fastmem_read_ptr(&cpu, kernel + PG - 16, 8, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 0));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 16, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel + HV_FASTMEM_SIZE, 8, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel - HV_FASTMEM_SIZE, 8, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, 0xabfffe0000010000ull, 8, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 2)); /* independent PAN table */
+    read_ok(kernel, ram + 3 * PG, 1);
+    /* Pages 256 MB apart collide in Henge's existing software TLB. Both
+       translations survive independently in the experimental read LUT. */
+    uint64_t other = kernel + (256ull << 20);
+    map(other, 5, 2, 0);
+    read_ok(other, ram + 5 * PG, 0);
+    assert(hv_fastmem_read_ptr(&cpu, kernel, 8, 1) == ram + 3 * PG);
+
+    /* One-page TLBI must drop both permission views, including tagged VAs. */
+    hv_tlb_flush_va_asid(&cpu, kernel & 0x00ffffffffffffffull, -1);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 2));
+    assert(hv_fastmem_read_ptr(&cpu, other, 8, 1) == ram + 5 * PG);
+    read_ok(kernel, ram + 3 * PG, 0);
+    read_ok(kernel, ram + 3 * PG, 1);
+    hv_tlb_flush_va_page(&cpu, kernel & 0x00ffffffffffffffull, -1);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 2));
+    assert(hv_fastmem_read_ptr(&cpu, other, 8, 1) == ram + 5 * PG);
+    map(kernel, 4, 2, 0);
+    read_ok(kernel, ram + 4 * PG, 0); /* remapped PA */
+    hv_tlb_flush_kernel_range(&cpu, kernel, 128ull << 20);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+
+    /* Device memory, unmapped physical memory, small pages and MMU-off reads
+       must not enter the LUT even if ordinary TLB handling accepts them. */
+    uint64_t pa;
+    map(kernel, 4, 2, 1);
+    assert(!hv_mmu_access(&cpu, kernel, HV_ACC_READ, 1, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    map(kernel, 17, 2, 0);
+    assert(!hv_mmu_access(&cpu, kernel, HV_ACC_READ, 1, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    map(kernel, 4, 1, 0); /* EL0 accessible: PAN prohibits EL1 reads */
+    cpu.pstate_extra = HV_PSTATE_PAN;
+    assert(hv_mmu_access(&cpu, kernel, HV_ACC_READ, 1, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 2));
+    read_ok(kernel, ram + 4 * PG, 0);
+    assert(hv_tlbi_drop_remote_va(&cpu, kernel, -1) == -1); /* owner must ack */
+    assert(hv_tlbi_drop_remote_range(&cpu, kernel, 2, -1) == -1);
+    assert(hv_tlbi_drop_remote_range(&cpu, kernel & 0x00ffffffffffffffull, 2, -1) == -1);
+    assert(hv_fastmem_read_ptr(&cpu, kernel, 8, 1)); /* no unsynchronized remote LUT edit */
+    hv_tlb_flush(&cpu);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    *leaf(kernel) = 0;
+    assert(hv_mmu_access(&cpu, kernel, HV_ACC_READ, 1, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    cpu.sctlr_el1 = 0;
+    assert(!hv_mmu_access(&cpu, kernel, HV_ACC_READ, 1, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    cpu.sctlr_el1 = 1;
+    map(kernel, 3, 2, 0);
+    read_ok(kernel, ram + 3 * PG, 0);
+    /* User invalidations do not accidentally clear the kernel view. */
+    hv_fastmem_drop(&cpu, 0x10000, UINT64_MAX);
+    assert(hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    hv_fastmem_drop(&cpu, kernel - PG, UINT64_MAX); /* overflow-safe range */
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    hv_tlb_flush_va_page(&cpu, kernel, -1);
+    read_ok(kernel, ram + 3 * PG, 0);
+    assert(!hv_fastmem_attach(&cpu, &cpu.pc_state->fastmem, 1)); /* CPU reset */
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    /* EL0 accesses never populate the kernel cache. */
+    map(kernel, 3, 3, 0);
+    assert(!hv_mmu_access(&cpu, kernel, HV_ACC_READ, 0, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    /* A valid 4 KB guest mapping must stay on the existing helper path. */
+    memset(ram, 0, 3 * PG);
+    memset(table(8), 0, PG);
+    cpu.tcr_el1 = 22ull << 16 | 2ull << 30;
+    table(0)[(kernel >> 39) & 7] = (PA + PG) | 3;
+    table(1)[(kernel >> 30) & 511] = (PA + 2 * PG) | 3;
+    table(2)[(kernel >> 21) & 511] = (PA + 8 * PG) | 3;
+    table(8)[(kernel >> 12) & 511] = (PA + 3 * PG) | 3 | 1u << 10;
+    assert(!hv_mmu_access(&cpu, kernel, HV_ACC_READ, 1, &pa));
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    /* Repeated invalidation/refill cannot overflow the sparse clear list. */
+    uint64_t addend = (uintptr_t)(ram + 3 * PG) - kernel;
+    for (unsigned i = 0; i < 2 * HV_FASTMEM_PAGES + 1; i++) {
+        hv_fastmem_fill(&cpu, kernel, 1, addend);
+        hv_fastmem_drop(&cpu, kernel, PG);
+    }
+    hv_fastmem_fill(&cpu, kernel, 1, addend);
+    assert(!hv_fastmem_read_ptr(&cpu, kernel, 8, 1));
+    hv_fastmem_clear(&cpu);
+    hv_fastmem_fill(&cpu, kernel, 1, addend);
+    assert(hv_fastmem_read_ptr(&cpu, kernel, 8, 1) == ram + 3 * PG);
+    assert(!hv_fastmem_attach(&cpu, &cpu.pc_state->fastmem, 0));
+    assert(!cpu.fm_read[0] && !cpu.pc_state->fastmem);
+    free(m.ram[0].code_pages);
+    free(m.ram[0].whint);
+    free(ram);
+    puts("fastmem walker, permissions, invalidation and fallback tests passed");
+}
diff --git a/tests/test_fastmem_jit.py b/tests/test_fastmem_jit.py
new file mode 100644
index 0000000..37bc97d
--- /dev/null
+++ b/tests/test_fastmem_jit.py
@@ -0,0 +1,148 @@
+"""Execute Henge's actual emitted scalar memory code in Unicorn ARM64.
+
+Run with Python packages unicorn and capstone installed. The test build replaces
+only the host DCZID probe (unrelated to scalar loads) on non-ARM build hosts.
+No Apple SDK or guest macOS image is used, so this is not an iPad boot test.
+"""
+import json
+import pathlib
+import struct
+import subprocess
+import tempfile
+
+from unicorn import Uc, UC_ARCH_ARM64, UC_MODE_ARM, UC_HOOK_CODE
+from unicorn import arm64_const as regs
+from unicorn.arm64_const import UC_ARM64_REG_X28, UC_ARM64_REG_NZCV
+REGS = [getattr(regs, f"UC_ARM64_REG_X{i}") for i in range(31)]
+from capstone import Cs, CS_ARCH_ARM64, CS_MODE_ARM
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+DRIVER = r'''
+#include "translate_for_test.c"
+#include <stdio.h>
+int hv_knob[HV_K_COUNT];
+int hv_tlb_tmajor = 1;
+int main(int argc, char **argv) {
+    if (argc != 5) return 2;
+    static HvMachine machine;
+    machine.fastmem_enabled = atoi(argv[3]);
+    machine.fastmem_diagnostics = atoi(argv[4]);
+    E.w = E.hot; E.m = &machine; E.flags = strtoul(argv[2], 0, 0);
+    E.nogroup = 1;
+    translate_mem(&E, strtoul(argv[1], 0, 0), 0x1000);
+    if (E.nfix) return 3;
+    for (unsigned i = 0; i < E.nool; i++)
+        patch_branch(&E.hot[E.ool[i].at], (int64_t)E.n + 1 - E.ool[i].at);
+    printf("[");
+    for (unsigned i = 0; i < E.n; i++) printf("%s%u", i ? "," : "", E.hot[i]);
+    puts("]");
+}
+'''
+
+CODE, CPU, LUT, DATA = 0x100000, 0x2000000, 0x10000000, 0x20000000
+KERNEL, PAGE = 0xfffffe0000000000, 16384
+NZCV = 0xa0000000
+checked = 0
+diagnostic_mode = 0
+
+def run(driver, insn, *, flags=1, enabled=1, offset=128, lut=True,
+        pointer=True, tlb=True, outside=False, page_end=False, store=False, diagnostics=None):
+    global checked
+    if diagnostics is None: diagnostics = diagnostic_mode
+    words = json.loads(subprocess.check_output([str(driver), hex(insn), str(flags), str(enabled), str(diagnostics)]))
+    code = struct.pack("<" + "I" * len(words), *words)
+    u = Uc(UC_ARCH_ARM64, UC_MODE_ARM)
+    u.mem_map(CODE, 0x10000)
+    u.mem_write(CODE, code + bytes(16))
+    u.mem_map(CPU, 0x800000)
+    u.mem_map(LUT, 0x400000)
+    u.mem_map(DATA, PAGE)
+    address = KERNEL + (1 << 32 if outside else 0) + offset
+    page = address & -PAGE
+    addend = (DATA - page) & ((1 << 64) - 1)
+    table = 0 if not flags & 1 else 2 if flags & 8 else 1
+    def q(addr, value): u.mem_write(addr, struct.pack("<Q", value))
+    q(CPU + 0x4e8, LUT if pointer else 0)
+    q(CPU + 0x4f0, LUT + 0x200000 if pointer else 0)
+    q(CPU + 0x4f8, KERNEL)
+    if lut and not outside:
+        q(LUT + (0x200000 if table == 2 else 0) + (offset >> 14) * 8, addend)
+    if tlb:
+        slot = (address >> 14) & 16383
+        entry = CPU + 0x580 + table * 16384 * 32 + slot * 32
+        q(entry, (page - 15) & ((1 << 64) - 1))
+        q(entry + 8, (page - 15) & ((1 << 64) - 1))
+        q(entry + 24, addend)
+    u.mem_write(DATA, bytes([0x82, 0x73, 0x64, 0xf5, 0x46, 0x37, 0x28, 0x19]) * (PAGE // 8))
+    for reg in range(31):
+        u.reg_write(REGS[reg], 0x9000 + reg)
+        q(CPU + reg * 8, 0x9000 + reg)
+    rt, rn = insn & 31, (insn >> 5) & 31
+    stolen = {6, 7, 15, 18, 28}
+    u.reg_write(UC_ARM64_REG_X28, CPU)
+    if rn in stolen: q(CPU + rn * 8, address)
+    else: u.reg_write(REGS[rn], address)
+    u.reg_write(UC_ARM64_REG_NZCV, NZCV)
+    end = CODE + len(code)
+    stopped = []
+    def hook(emu, pc, size, data):
+        if pc in (end, end + 4):
+            stopped.append(pc)
+            emu.emu_stop()
+    u.hook_add(UC_HOOK_CODE, hook)
+    u.emu_start(CODE, end + 8, count=500)
+    expected_slow = page_end or (not tlb and (not enabled or not lut or not pointer or outside or table == 0 or store))
+    assert stopped == [end + 4 if expected_slow else end], (insn, stopped, expected_slow)
+    assert u.reg_read(UC_ARM64_REG_NZCV) == NZCV
+    counters = struct.unpack("<6Q", u.mem_read(CPU + 0x518, 48))
+    expected_counters = [0] * 6
+    if diagnostics and enabled and table and not store:
+        expected_counters[0] = 1
+        reason = 0 if not pointer else 1 if outside else 2 if page_end else 3 if not lut else None
+        expected_counters[1 if reason is None else 2 + reason] = 1
+    assert list(counters) == expected_counters, (hex(insn), counters, expected_counters)
+    if not expected_slow:
+        if store:
+            assert struct.unpack("<Q", u.mem_read(DATA + offset, 8))[0] == (address if rt == rn else 0x9000 + rt)
+        else:
+            size = {0x39400000: 1, 0x79400000: 2, 0xb9400000: 4, 0xf9400000: 8, 0xb9800000: 4}[insn & ~1023]
+            expected = int.from_bytes(u.mem_read(DATA + offset, size), "little", signed=(insn & ~1023) == 0xb9800000) & ((1 << 64) - 1)
+            actual = struct.unpack("<Q", u.mem_read(CPU + rt * 8, 8))[0] if rt in stolen else u.reg_read(REGS[rt])
+            assert actual == expected, (hex(insn), expected, actual)
+    for reg in (2, 3, 4, 5, 8, 9, 16, 17, 19, 20, 27, 29, 30):
+        if reg != rt and reg != rn:
+            assert u.reg_read(REGS[reg]) == 0x9000 + reg
+    checked += 1
+    return code
+
+with tempfile.TemporaryDirectory() as temp:
+    tmp = pathlib.Path(temp)
+    source = (ROOT / "core/translate.c").read_text()
+    probe = '__asm__ volatile("mrs %0, dczid_el0" : "=r"(dczid));'
+    assert source.count(probe) == 1
+    (tmp / "translate_for_test.c").write_text(source.replace(probe, "dczid = 0; /* test host only */"))
+    (tmp / "driver.c").write_text(DRIVER)
+    driver = tmp / "emit"
+    subprocess.run(["cc", "-std=c11", "-D_POSIX_C_SOURCE=200809L", "-O2", "-ffunction-sections", "-fdata-sections",
+                    "-I" + str(ROOT / "core"), "-I" + str(ROOT / "host"), "-I" + str(ROOT / "devices"),
+                    str(tmp / "driver.c"), str(ROOT / "core/memop.c"), "-Wl,--gc-sections", "-o", str(driver)], check=True)
+    for diagnostic_mode in (0, 1):
+        for insn in (0x39400020, 0x79400020, 0xb9400020, 0xf9400020, 0xb9800020):
+            for flags in (1, 9):
+                for offset in (0, 1, 7, 128, PAGE - 16):
+                    run(driver, insn, flags=flags, offset=offset, tlb=False)
+                for args in ({"lut": False}, {"pointer": False}, {"outside": True}, {"enabled": 0},
+                             {"lut": False, "tlb": False}, {"offset": PAGE - 8, "page_end": True}):
+                    run(driver, insn, flags=flags, **args)
+            run(driver, insn, flags=0, lut=False)
+        run(driver, 0xf9000020, store=True)
+        for rt in (0, 6, 7, 15, 18, 28, 29, 30):
+            for rn in (1, 6, 7, 15, 18, 28, 29, 30):
+                insn = 0xf9400000 | rn << 5 | rt
+                run(driver, insn, tlb=False)
+                run(driver, insn, lut=False)
+        code = run(driver, 0xf9400020, tlb=False)
+    print(f"{checked} emitted ARM64 memory cases passed (Unicorn; not device execution)")
+    print("Guard disassembly:")
+    for item in list(Cs(CS_ARCH_ARM64, CS_MODE_ARM).disasm(code, CODE))[:17]:
+        print(f"  {item.mnemonic} {item.op_str}")
diff --git a/tests/test_frame_metrics.c b/tests/test_frame_metrics.c
new file mode 100644
index 0000000..cc3dcb4
--- /dev/null
+++ b/tests/test_frame_metrics.c
@@ -0,0 +1,19 @@
+#include "frame_metrics.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+int main(void){
+ struct HvFrameMetrics m={.generation=2};
+ hv_frame_record(&m,1,1);assert(!m.frames);
+ for(int i=0;i<=1000;i++)hv_frame_record(&m,2,1+i/60.0);
+ assert(m.frames==1001 && m.intervals==1000);
+ assert(fabs(1000*m.intervals/m.total_ms-60)<0.001);
+ assert(hv_frame_percentile(&m,95)>=16.66 && hv_frame_percentile(&m,95)<=16.92);
+ assert(hv_frame_low1(&m)>59 && hv_frame_low1(&m)<=60);
+ hv_frame_record(&m,2,m.last);hv_frame_record(&m,2,NAN);assert(m.invalid==2);
+ hv_frame_record(&m,2,m.last+2);assert(m.overflow==1 && hv_frame_low1(&m)==0);
+ memset(&m,0,sizeof m);assert(hv_frame_percentile(&m,99)==0);
+ hv_frame_record(&m,0,1);hv_frame_record(&m,0,3);
+ assert(m.overflow==1 && hv_frame_percentile(&m,95)==0 && hv_frame_percentile(&m,100)==0);
+ puts("frame telemetry: known 60Hz intervals, quantiles, tail estimate, epochs, nonfinite/reversed time and overflow passed");
+}
diff --git a/tests/test_frame_pacing.c b/tests/test_frame_pacing.c
new file mode 100644
index 0000000..17505fd
--- /dev/null
+++ b/tests/test_frame_pacing.c
@@ -0,0 +1,18 @@
+#include "frame_pacing.h"
+#include <assert.h>
+#include <stdio.h>
+int main(void) {
+ assert(hv_pacing_fps(0,0,1)==0); assert(hv_pacing_fps(0,2,1)==30);
+ assert(hv_pacing_fps(60,3,1)==20); assert(hv_pacing_fps(30,0,1)==30);
+ assert(hv_pacing_fps(0,3,0)==0); assert(hv_pacing_fps(60,2,0)==60);
+ HvFramePacing p={0};unsigned draws=0;
+ for(int i=0;i<10000;i++) {
+  double t=i/1000.0;
+  if(hv_pacing_delay(&p,t,30)<=0) {hv_pacing_presented(&p,t,30);draws++;}
+ }
+ assert(draws>=290 && draws<=300); // 1000 updates/sec, about 30 submissions/sec
+ assert(hv_pacing_delay(&p,10,0)==0 && p.next==0);
+ hv_pacing_presented(&p,11,60); assert(hv_pacing_delay(&p,12,60)==0);
+ assert(hv_pacing_delay(&p,11,60)>0); // monotonic input; finite deferred wake
+ puts("frame pacing: limits, thermal transitions, protection override, burst coalescing and idle eligibility passed");
+}

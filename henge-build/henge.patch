+@MainActor
+final class LinkViewerService: ObservableObject {
+    @Published private(set) var status = "Select a local iPad or enter its address manually."
+    @Published private(set) var ready = false
+    private var transport = LinkTransport()
+    private let decodeWorker = LinkDecodeWorker(report: { HengeLog.log("link-viewer", $0) })
+    private var generation = UUID()
+    private var mode: LinkMode?
+    // A single replaceable output, owned by the view. No array of decoded frames.
+    var onPixel: ((CVPixelBuffer) -> Void)?
+    func connect(host: String, port: UInt16, key: String, wired: Bool, mode: LinkMode, peer: LinkDiscoveredPeer? = nil, remember: Bool = false) {
+        disconnect(); let g = UUID(); generation = g; self.mode = mode
+        let channel = transport
+        let mailbox = LinkPixelMailbox { [weak self] pixel in
+            guard let self, self.generation == g else { return }
+            if self.status.hasPrefix("Connected.") {
+                self.status = "Receiving the independent second monitor."
+                HengeLog.log("link-viewer", "first decoded native frame=\(mode.width)x\(mode.height); no guest VM/JIT started by viewer")
+            }
+            self.onPixel?(pixel)
+        }
+        let decodeGeneration = decodeWorker.start(mode: mode, output: { mailbox.submit($0) })
+        let worker = decodeWorker
+        transport.onStatus = { [weak self] text, connected in
+            Task { @MainActor in
+                guard let self, self.generation == g else { return }
+                self.status = text; HengeLog.log("link-viewer", text); if !connected { self.ready = false }
+                if connected { self.transport.sendControl(LinkControl(type: "hello", mode: mode)) }
+            }
+        }
+        transport.onPacket = { [weak self, weak channel] packet in
+            guard let self else { return }
+            if packet.kind == 1, let command = try? JSONDecoder().decode(LinkControl.self, from: packet.payload), command.type == "ready", command.mode == mode {
+                Task { @MainActor in
+                    guard self.generation == g else { return }; self.ready = true
+                    self.status = "Connected. Start macOS on the iPad; waiting for the second desktop."
+                    if remember, let peer {
+                        do { try LinkPairingStore.shared.save("viewer", value: LinkSavedPeer(name: peer.name, key: key.trimmingCharacters(in: .whitespacesAndNewlines), wired: wired)) }
+                        catch { self.status = "Connected. " + error.localizedDescription }
+                    }
+                }
+            } else if packet.kind == 2 {
+                worker.consume(packet.payload, generation: decodeGeneration, consumed: { [weak channel] sequence in
+                    // Runs after the decode slot is free, independently of UI work.
+                    channel?.sendControl(LinkControl(type: "videoAck", sequence: sequence))
+                }, failed: { [weak self] error in
+                    Task { @MainActor in
+                        guard let self, self.generation == g else { return }; self.status = error; self.ready = false; self.transport.stop()
+                    }
+                })
+            }
+        }
+        let secret = key.trimmingCharacters(in: .whitespacesAndNewlines)
+        if let peer { transport.connect(peer: peer, key: secret, wired: wired) }
+        else { transport.connect(host: host.trimmingCharacters(in: .whitespacesAndNewlines), key: secret, wired: wired, port: port) }
+    }
+    func send(_ control: LinkControl) { guard ready else { return }; transport.sendControl(control) }
+    func disconnect() {
+        generation = UUID(); ready = false; transport.onPacket = nil; transport.onStatus = nil; transport.stop(); transport = LinkTransport()
+        decodeWorker.stop(); mode = nil
+    }
+}

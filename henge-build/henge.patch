+#import "pvg_screen.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static NSData *render(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLLibrary> lib,
+                      id<MTLTexture> input, BOOL half, uint32_t mode, BOOL cursor) {
+    NSError *error = nil;
+    id<MTLRenderPipelineState> pipe = hv_screen_pipeline(device, lib, half ? @"screen_linear" : @"screen_plain", NO, &error);
+    assert(pipe && !error);
+    NSUInteger width = input.width, height = input.height;
+    NSUInteger row = (width * 4 + 255) & ~(NSUInteger)255;
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:width height:height mipmapped:NO];
+    td.usage = MTLTextureUsageRenderTarget;
+    td.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> output = [device newTextureWithDescriptor:td];
+    assert(output);
+    id<MTLCommandBuffer> cb = [queue commandBuffer];
+    MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = output;
+    pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:pass];
+    MTLSamplerDescriptor *sd = [MTLSamplerDescriptor new];
+    sd.minFilter = sd.magFilter = MTLSamplerMinMagFilterNearest;
+    id<MTLSamplerState> sampler = [device newSamplerStateWithDescriptor:sd];
+    float rect[4] = {-1,-1,2,2};
+    [e setRenderPipelineState:pipe];
+    [e setVertexBytes:rect length:sizeof rect atIndex:0];
+    [e setFragmentTexture:input atIndex:0];
+    [e setFragmentSamplerState:sampler atIndex:0];
+    if (half) [e setFragmentBytes:&mode length:sizeof mode atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangleStrip vertexStart:0 vertexCount:4];
+    if (cursor) {
+        uint8_t pixel[4] = {0,0,128,128}; // premultiplied red over the screen
+        MTLTextureDescriptor *ctd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:1 height:1 mipmapped:NO];
+        ctd.storageMode = MTLStorageModeShared;
+        ctd.usage = MTLTextureUsageShaderRead;
+        id<MTLTexture> ctex = [device newTextureWithDescriptor:ctd];
+        [ctex replaceRegion:MTLRegionMake2D(0,0,1,1) mipmapLevel:0 withBytes:pixel bytesPerRow:4];
+        [e setRenderPipelineState:hv_screen_pipeline(device, lib, @"screen_cursor", YES, &error)];
+        assert(!error);
+        [e setFragmentTexture:ctex atIndex:0];
+        [e drawPrimitives:MTLPrimitiveTypeTriangleStrip vertexStart:0 vertexCount:4];
+    }
+    [e endEncoding];
+    id<MTLBuffer> readback = [device newBufferWithLength:row * height options:MTLResourceStorageModeShared];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:output sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(width,height,1)
+                toBuffer:readback destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:row * height];
+    [blit endEncoding];
+    [cb commit]; [cb waitUntilCompleted]; // test readback only; production remains asynchronous
+    assert(cb.status == MTLCommandBufferStatusCompleted);
+    NSMutableData *result = [NSMutableData dataWithLength:width * height * 4];
+    for (NSUInteger y = 0; y < height; y++)
+        memcpy((uint8_t *)result.mutableBytes + y * width * 4,
+               (uint8_t *)readback.contents + y * row, width * 4);
+    return result;
+}
+
+int main(int argc, const char **argv) { @autoreleasepool {
+    assert(argc == 2);
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (!device) { fprintf(stderr, "Native Metal pixel tests require a GPU; no pass claimed.\n"); return 77; }
+    NSError *error = nil;
+    id<MTLLibrary> bundled = [device newLibraryWithURL:[NSURL fileURLWithPath:@(argv[1])] error:&error];
+    assert(bundled && !error);
+    id<MTLLibrary> fallback = [device newLibraryWithSource:screen_shaders options:nil error:&error];
+    assert(fallback && !error);
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    for (id<MTLLibrary> lib in @[bundled, fallback]) {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:2 height:2 mipmapped:NO];
+        td.storageMode = MTLStorageModeShared; td.usage = MTLTextureUsageShaderRead;
+        id<MTLTexture> input = [device newTextureWithDescriptor:td];
+        uint8_t pattern[16] = {255,0,0,255, 0,255,0,255, 0,0,255,255, 255,255,255,255};
+        [input replaceRegion:MTLRegionMake2D(0,0,2,2) mipmapLevel:0 withBytes:pattern bytesPerRow:8];
+        assert([render(device,queue,lib,input,NO,0,NO) isEqualToData:[NSData dataWithBytes:pattern length:16]]);
+        NSData *overlaid = render(device,queue,lib,input,NO,0,YES);
+        const uint8_t *overlay = overlaid.bytes;
+        assert(abs(overlay[0]-127)<=1 && overlay[1]==0 && abs(overlay[2]-128)<=1 && overlay[3]==255);
+        td.pixelFormat = MTLPixelFormatRGBA16Float;
+        input = [device newTextureWithDescriptor:td];
+        uint16_t gray[16];
+        for (int i=0;i<16;i++) gray[i] = i%4==3 ? 0x3c00 : 0x3400; // 1.0 alpha, 0.25 RGB
+        [input replaceRegion:MTLRegionMake2D(0,0,2,2) mipmapLevel:0 withBytes:gray bytesPerRow:16];
+        for (uint32_t mode=0;mode<2;mode++) {
+            NSData *pixels = render(device,queue,lib,input,YES,mode,NO);
+            const uint8_t *p = pixels.bytes;
+            for (int i=0;i<16;i++) assert(abs(p[i]-(i%4==3 ? 255 : mode ? 137 : 64))<=1);
+        }
+        // An exact Fit mode need not have a height divisible by eight. Verify
+        // every pixel and the last scanline through both production libraries.
+        td.pixelFormat = MTLPixelFormatBGRA8Unorm;
+        td.width = 1920; td.height = 1350;
+        input = [device newTextureWithDescriptor:td]; assert(input);
+        NSMutableData *full = [NSMutableData dataWithLength:1920 * 1350 * 4];
+        uint8_t *bytes = full.mutableBytes;
+        for (NSUInteger y=0;y<1350;y++) for (NSUInteger x=0;x<1920;x++) {
+            NSUInteger at=(y*1920+x)*4;
+            bytes[at]=x%251; bytes[at+1]=y%253; bytes[at+2]=(x+y)%255; bytes[at+3]=255;
+        }
+        [input replaceRegion:MTLRegionMake2D(0,0,1920,1350) mipmapLevel:0 withBytes:bytes bytesPerRow:1920*4];
+        assert([render(device,queue,lib,input,NO,0,NO) isEqualToData:full]);
+    }
+    puts("native Metal exact-fit: 1920x1350 non-eight-aligned height, every pixel and final row preserved");
+    printf("native Metal GPU pixels: bundled and fallback libraries, BGRA orientation/colours, half-float encoded/linear and premultiplied cursor passed on %s\n",device.name.UTF8String);
+    return 0;
+} }
diff --git a/tests/test_native_touch.c b/tests/test_native_touch.c
new file mode 100644
index 0000000..1766e60
--- /dev/null
+++ b/tests/test_native_touch.c
@@ -0,0 +1,142 @@
+#include "native_touch.h"
+#include "share.h"
+#include <assert.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+static char json[1024];
+static void next(void) { assert(hv_native_touch_next(json, sizeof json) > 0); }
+static void submit(uint32_t e, size_t n, double position) {
+    uint8_t ids[] = {1, 2}; double xy[] = {position, position};
+    assert(hv_native_touch_submit(e, ids, xy, xy, n));
+}
+static double monotonic_time(void) {
+    struct timespec time;
+    assert(clock_gettime(CLOCK_MONOTONIC, &time) == 0);
+    return time.tv_sec + time.tv_nsec / 1e9;
+}
+static _Atomic int sender_done;
+static void *idle_sender(void *generation) {
+    uint32_t e = *(uint32_t *)generation;
+    for (int i = 0; i < 12; i++) {
+        // Deliberately outlive three long polls. The helper must keep reporting
+        // until this sender finishes, including on a loaded CI runner.
+        usleep(160000);
+        assert(hv_native_touch_submit(e, NULL, NULL, NULL, 0));
+    }
+    atomic_store(&sender_done, 1);
+    return NULL;
+}
+static void *delayed_contact(void *generation) {
+    usleep(30000);
+    submit(*(uint32_t *)generation, 1, 0.6);
+    return NULL;
+}
+static void http(const char *path, const char *body, char *result, size_t size, const char *socket_path) {
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0); assert(fd >= 0);
+    struct sockaddr_un address = {.sun_family = AF_UNIX};
+    snprintf(address.sun_path, sizeof address.sun_path, "%s", socket_path);
+    assert(connect(fd, (struct sockaddr *)&address, sizeof address) == 0);
+    char request[1024];
+    int n = snprintf(request, sizeof request,
+        "%s %s HTTP/1.1\r\nHost: 10.0.2.4\r\nConnection: close\r\nContent-Length: %zu\r\n\r\n%s",
+        body ? "PUT" : "GET", path, body ? strlen(body) : 0, body ? body : "");
+    assert(write(fd, request, (size_t)n) == n);
+    size_t at = 0; ssize_t read_count;
+    while ((read_count = read(fd, result+at, size-at-1)) > 0) { at += (size_t)read_count; assert(at < size-1); }
+    result[at] = 0; close(fd);
+}
+int main(void) {
+    assert(hv_native_touch_status() == HV_TOUCH_OFF);
+    uint32_t e = hv_native_touch_enable(1);
+    assert(hv_native_touch_status() == HV_TOUCH_WAITING);
+    assert(!hv_native_touch_submit(e, NULL, NULL, NULL, 0));
+    hv_native_touch_report(e-1, HV_TOUCH_READY);
+    assert(hv_native_touch_status() == HV_TOUCH_WAITING);
+    hv_native_touch_report(e, HV_TOUCH_READY);
+    uint8_t duplicate[] = {1,1}; double xy[] = {0.5,0.5};
+    assert(!hv_native_touch_submit(e, duplicate, xy, xy, 2));
+    xy[0] = NAN; assert(!hv_native_touch_submit(e, duplicate, xy, xy, 1));
+    xy[0] = 1.1; assert(!hv_native_touch_submit(e, duplicate, xy, xy, 1));
+    submit(e, 1, 0.2); submit(e, 1, 0.8); submit(e, 0, 0);
+    next(); assert(strstr(json, "0.800000000")); assert(strstr(json, "\"id\":1"));
+    next(); assert(strstr(json, "\"contacts\":[]"));
+    submit(e, 1, 0.3);
+    uint32_t fresh = hv_native_touch_reset(); assert(fresh != e);
+    assert(!hv_native_touch_submit(e, NULL, NULL, NULL, 0));
+    next(); assert(strstr(json, "\"contacts\":[]"));
+    hv_native_touch_report(e, HV_TOUCH_READY); assert(hv_native_touch_status() == HV_TOUCH_WAITING);
+    hv_native_touch_report(fresh, HV_TOUCH_PERMISSION); assert(hv_native_touch_status() == HV_TOUCH_PERMISSION);
+    next(); assert(strstr(json, "\"enabled\":false"));
+
+    // Neutral heartbeats maintain readiness without shortening the idle long poll.
+    e = hv_native_touch_enable(1); hv_native_touch_report(e, HV_TOUCH_READY);
+    pthread_t sender;
+    assert(pthread_create(&sender, NULL, idle_sender, &e) == 0);
+    for (int i = 0; i < 3 || !atomic_load(&sender_done); i++) {
+        double started = monotonic_time();
+        next();
+        assert(monotonic_time() - started >= 0.2);
+        assert(strstr(json, "\"contacts\":[]"));
+        hv_native_touch_report(e, HV_TOUCH_READY);
+    }
+    assert(pthread_join(sender, NULL) == 0);
+    assert(hv_native_touch_status() == HV_TOUCH_READY);
+
+    // A real contact wakes the long poll, and its lift still reaches the guest.
+    hv_native_touch_report(e, HV_TOUCH_READY);
+    assert(pthread_create(&sender, NULL, delayed_contact, &e) == 0);
+    double started = monotonic_time();
+    next();
+    assert(monotonic_time() - started < 0.2);
+    assert(strstr(json, "\"id\":1"));
+    assert(pthread_join(sender, NULL) == 0);
+    submit(e, 0, 0);
+    next(); assert(strstr(json, "\"contacts\":[]"));
+
+    e = hv_native_touch_enable(1); hv_native_touch_report(e, HV_TOUCH_READY);
+    // Alternating membership cannot be coalesced. Overflow releases instead of dropping a lift.
+    for (int i=0; i<64; i++) submit(e, (size_t)(i%2 + 1), 0.5);
+    assert(!hv_native_touch_submit(e, duplicate, xy, xy, 0));
+    assert(hv_native_touch_status() == HV_TOUCH_DEVICE);
+    next(); assert(strstr(json, "\"contacts\":[]"));
+    e = hv_native_touch_enable(1); hv_native_touch_report(e, HV_TOUCH_READY); submit(e, 1, 0.5);
+    usleep(800000); assert(hv_native_touch_status() == HV_TOUCH_TIMEOUT);
+    assert(hv_native_touch_epoch() != e); next(); assert(strstr(json, "\"enabled\":false"));
+
+    // An absent companion must also fall back without ever advertising readiness.
+    e = hv_native_touch_enable(1);
+    usleep(5100000);
+    assert(hv_native_touch_status() == HV_TOUCH_TIMEOUT);
+    assert(hv_native_touch_epoch() != e);
+
+    // Exercise the real guest HTTP endpoints and their status validation.
+    char directory[] = "/tmp/henge-touch-test-XXXXXX"; assert(mkdtemp(directory));
+    char socket_path[108]; snprintf(socket_path, sizeof socket_path, "%s/s", directory);
+    assert(hv_share_start(directory, socket_path, NULL) == 0);
+    char response[4096], body[64];
+    e = hv_native_touch_enable(1);
+    http("/.henge/native-touch", NULL, response, sizeof response, socket_path);
+    assert(strstr(response, "200 OK") && strstr(response, "\"version\":1"));
+    snprintf(body, sizeof body, "%u 2", e);
+    http("/.henge/native-touch", body, response, sizeof response, socket_path);
+    assert(strstr(response, "204 No Content") && hv_native_touch_status() == HV_TOUCH_READY);
+    http("/.henge/native-touch", "1 99", response, sizeof response, socket_path);
+    assert(strstr(response, "400 Bad Request"));
+    submit(e, 1, 0.25);
+    http("/.henge/native-touch", NULL, response, sizeof response, socket_path);
+    assert(strstr(response, "0.250000000"));
+    hv_native_touch_enable(0);
+    http("/.henge/native-touch", NULL, response, sizeof response, socket_path);
+    assert(strstr(response, "\"enabled\":false") && strstr(response, "\"contacts\":[]"));
+    unlink(socket_path); rmdir(directory);
+    puts("native touch: idle polling, immediate wake, transitions, validation, generations, fallback, timeout and HTTP passed");
+}
diff --git a/tests/test_native_touch_session.swift b/tests/test_native_touch_session.swift
new file mode 100644
index 0000000..5249aa5
--- /dev/null
+++ b/tests/test_native_touch_session.swift
@@ -0,0 +1,69 @@
+import Foundation
+
+@main enum NativeTouchSessionTests {
+    @MainActor static func main() {
+        let suite = "NativeTouchSessionTests.\(UUID().uuidString)"
+        let defaults = UserDefaults(suiteName: suite)!
+        defer { defaults.removePersistentDomain(forName: suite) }
+        var time: TimeInterval = 0
+        let session = NativeTouchSession(defaults: defaults, now: { time })
+        session.poll(active: true, helperRunning: true)
+        precondition(!session.ready && hv_native_touch_status() == 0)
+        session.requested = true
+        precondition(NativeTouchSession(defaults: defaults).requested, "The choice must survive a new session")
+        session.changedRequest()
+        session.poll(active: true, helperRunning: false)
+        precondition(session.status == 1 && hv_native_touch_status() == 0, "Wait for the guest helper before negotiating")
+        session.poll(active: true, helperRunning: true)
+        precondition(session.status == 1 && !session.ready)
+        let first = hv_native_touch_epoch()
+        hv_native_touch_report(first, 2)
+        session.poll(active: true, helperRunning: true)
+        precondition(session.ready)
+        session.poll(active: false, helperRunning: true)
+        precondition(!session.ready && hv_native_touch_status() == 0)
+        session.poll(active: true, helperRunning: true)
+        precondition(hv_native_touch_epoch() != first)
+        hv_native_touch_report(hv_native_touch_epoch(), 4)
+        session.poll(active: true, helperRunning: true)
+        precondition(!session.ready && session.status == 4)
+        let failed = hv_native_touch_epoch()
+        time = 100
+        session.poll(active: true, helperRunning: true)
+        precondition(hv_native_touch_epoch() == failed, "Failures must not cause a retry loop")
+        session.requested = false
+        precondition(!NativeTouchSession(defaults: defaults).requested, "Disabling native touch must also persist")
+        session.changedRequest()
+        session.poll(active: true, helperRunning: true)
+        precondition(!session.ready && session.status == 0)
+        session.requested = true
+        session.changedRequest()
+        session.poll(active: true, helperRunning: true)
+        hv_native_touch_report(hv_native_touch_epoch(), 2)
+        session.poll(active: true, helperRunning: true)
+        precondition(session.ready)
+
+        // Exercise the real transport watchdog; advance only the reconnect delay.
+        Thread.sleep(forTimeInterval: 0.8)
+        session.poll(active: true, helperRunning: true)
+        precondition(!session.ready && session.status == 6)
+        let timedOut = hv_native_touch_epoch()
+        time += 1.9
+        session.poll(active: true, helperRunning: true)
+        precondition(session.status == 6 && hv_native_touch_epoch() == timedOut, "Retries need a backoff")
+        time += 0.2
+        session.poll(active: true, helperRunning: true)
+        precondition(session.status == 1 && hv_native_touch_epoch() != timedOut, "A timeout must reconnect without toggling")
+        hv_native_touch_report(hv_native_touch_epoch(), 2)
+        session.poll(active: true, helperRunning: true)
+        precondition(session.ready)
+        session.poll(active: true, helperRunning: false)
+        precondition(!session.ready && hv_native_touch_status() == 0, "Losing the helper must release native input")
+        session.poll(active: true, helperRunning: true)
+        precondition(session.status == 1)
+        session.stop()
+        precondition(!session.ready && hv_native_touch_status() == 0)
+        precondition(NativeTouchSession(defaults: defaults).requested, "Stopping must preserve the choice")
+        print("native touch session: persistence, delayed helper, suspend, fallback and automatic retry passed")
+    }
+}
diff --git a/tests/test_pacing_scheduler.py b/tests/test_pacing_scheduler.py
new file mode 100644
index 0000000..bc1a32a
--- /dev/null
+++ b/tests/test_pacing_scheduler.py
@@ -0,0 +1,66 @@
+"""Exercise the production deferred-present scheduler with real dispatch queues."""
+from pathlib import Path
+import subprocess
+root=Path(__file__).resolve().parents[1]
+s=(root/'devices/pvg_metal.m').read_text()
+a=s.index('- (void)kickPresenter:(BOOL)fresh {');level=1;i=s.index('{',a)+1;start=i
+while level:
+ if s[i]=='{':level+=1
+ if s[i]=='}':level-=1
+ i+=1
+method=s[a:i]
+pre=r'''
+#import <Foundation/Foundation.h>
+#include <os/lock.h>
+#include <unistd.h>
+#include <time.h>
+#include <assert.h>
+#include "frame_pacing.h"
+static double now_seconds(void) { return clock_gettime_nsec_np(CLOCK_MONOTONIC)*1e-9; }
+@interface Harness:NSObject { @public
+ os_unfair_lock screen_lock; id layer, screen_tex;
+ BOOL presenter_running, drawable_retry_pending, pacing_pending;
+ double drawable_retry_cooldown, drawable_retry_deadline;
+ uint64_t layer_generation, screen_requests;
+ dispatch_queue_t presenter; HvFramePacing frame_pacing; int pacing_fps;
+ unsigned draws; dispatch_semaphore_t delivered;
+}
+-(void)updatePacingPolicy;
+-(void)presentLoop;
+-(void)kickPresenter:(BOOL)fresh;
+@end
+@implementation Harness
+-(void)updatePacingPolicy {}
+-(void)presentLoop { os_unfair_lock_lock(&screen_lock);draws++;hv_pacing_presented(&frame_pacing,now_seconds(),pacing_fps);presenter_running=NO;os_unfair_lock_unlock(&screen_lock);dispatch_semaphore_signal(delivered); }
+'''
+post=r'''
+@end
+static void kick(Harness *h) { os_unfair_lock_lock(&h->screen_lock);[h kickPresenter:YES];os_unfair_lock_unlock(&h->screen_lock); }
+int main(void) { @autoreleasepool {
+ Harness *h=[Harness new];h->screen_lock=OS_UNFAIR_LOCK_INIT;
+ h->layer=[NSObject new];h->screen_tex=[NSObject new];h->pacing_fps=30;
+ h->delivered=dispatch_semaphore_create(0);
+ h->presenter=dispatch_queue_create("test.pacer",DISPATCH_QUEUE_SERIAL);
+ h->frame_pacing.next=now_seconds()+0.04;
+ os_unfair_lock_lock(&h->screen_lock);
+ for(int i=0;i<1000;i++)[h kickPresenter:YES];
+ os_unfair_lock_unlock(&h->screen_lock);
+ assert(dispatch_semaphore_wait(h->delivered,dispatch_time(DISPATCH_TIME_NOW,2*NSEC_PER_SEC))==0);
+ dispatch_sync(h->presenter,^{});
+ printf("pacing scheduler: draws=%u pending=%d deferred=%llu\n",h->draws,h->pacing_pending,h->frame_pacing.coalesced);
+ assert(h->draws==1 && !h->pacing_pending && h->frame_pacing.coalesced>=1);
+ assert(dispatch_semaphore_wait(h->delivered,dispatch_time(DISPATCH_TIME_NOW,100*NSEC_PER_MSEC))!=0);
+ dispatch_sync(h->presenter,^{});assert(h->draws==1);
+ os_unfair_lock_lock(&h->screen_lock);h->frame_pacing.next=now_seconds()+0.04;os_unfair_lock_unlock(&h->screen_lock);
+ kick(h);
+ os_unfair_lock_lock(&h->screen_lock);h->layer_generation++;h->pacing_pending=NO;h->frame_pacing.next=0;os_unfair_lock_unlock(&h->screen_lock);
+ assert(dispatch_semaphore_wait(h->delivered,dispatch_time(DISPATCH_TIME_NOW,100*NSEC_PER_MSEC))!=0);
+ dispatch_sync(h->presenter,^{});assert(h->draws==1);
+ kick(h);assert(dispatch_semaphore_wait(h->delivered,dispatch_time(DISPATCH_TIME_NOW,2*NSEC_PER_SEC))==0);
+ dispatch_sync(h->presenter,^{});assert(h->draws==2);
+ puts("production presenter scheduler: 1000 events coalesced, final frame retained, no idle timer, stale target cancellation and reconnect passed");
+} }
+'''
+b=root/'build';b.mkdir(exist_ok=True);p=b/'test_pacing_scheduler.m';p.write_text(pre+method+post)
+subprocess.run(['xcrun','--sdk','macosx','clang','-fobjc-arc','-Wall','-Wextra','-Werror','-I'+str(root/'devices'),str(p),'-framework','Foundation','-o',str(b/'test_pacing_scheduler')],check=True)
+subprocess.run([str(b/'test_pacing_scheduler')],check=True,timeout=10)

+++ b/tests/test_hvsparse.py
@@ -0,0 +1,27 @@
+"""Run the production image converter against disposable files and aliases."""
+from pathlib import Path
+import os, subprocess, tempfile
+root = Path(__file__).resolve().parents[1]
+with tempfile.TemporaryDirectory(prefix='henge-sparse-regression-') as tmp:
+    p = Path(tmp); exe = p/'hvsparse'
+    subprocess.run([os.environ.get('CC','cc'), '-D_GNU_SOURCE', '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror',
+                    '-I'+str(root/'host'), str(root/'host/hvsparse.c'), str(root/'tools/hvsparse_main.c'), '-o', str(exe)], check=True)
+    raw=p/'raw'; packed=p/'packed'; restored=p/'restored'
+    with raw.open('wb') as f:
+        f.write(b'first data'); f.seek(32*1024*1024-9); f.write(b'last data')
+    subprocess.run([str(exe),'pack',str(raw),str(packed)],check=True)
+    subprocess.run([str(exe),'unpack',str(packed),str(restored)],check=True)
+    assert raw.read_bytes()==restored.read_bytes()
+    for op in ('pack','unpack'):
+        for alias in ('same','hardlink','symlink'):
+            src=p/(op+'-'+alias); src.write_bytes(packed.read_bytes() if op=='unpack' else b'preserve input'*256)
+            before=src.read_bytes(); dst=src if alias=='same' else src.with_suffix('.alias')
+            if alias=='hardlink': os.link(src,dst)
+            if alias=='symlink': dst.symlink_to(src)
+            assert subprocess.run([str(exe),op,str(src),str(dst)],timeout=10).returncode != 0
+            assert src.read_bytes()==before
+    # Invalid input must not destroy an existing, unrelated destination either.
+    bad=p/'invalid'; bad.write_bytes(b'not an image'); dest=p/'existing'; dest.write_bytes(b'keep destination')
+    assert subprocess.run([str(exe),'unpack',str(bad),str(dest)]).returncode != 0
+    assert dest.read_bytes()==b'keep destination'
+print('hvsparse: sparse round trip; six same-file/hardlink/symlink overwrite refusals; invalid input preserves existing output')
diff --git a/tests/test_idle_integration.c b/tests/test_idle_integration.c
new file mode 100644
index 0000000..2b1be58
--- /dev/null
+++ b/tests/test_idle_integration.c
@@ -0,0 +1,63 @@
+#include "machine.h"
+#include "dispatch.h"
+#include "sysreg.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static HvMachine m;
+static HvCpu cpu;
+static uint32_t code[4096] __attribute__((aligned(16384))) = {0xd503207f, 0xd2800540}; /* WFI; MOV X0,#42 */
+static unsigned activations;
+static void became_active(void *opaque) { assert(opaque == &m); activations++; }
+static uint64_t timer_tick(HvMachine *machine, HvCpu *c) {
+    assert(machine == &m && c == &cpu);
+    return hv_counter() + 24000; /* same 24 MHz deadline used by engine WFI */
+}
+int main(void) {
+    assert(hv_machine_init(&m, 1 << 20) == 0);
+    assert(hv_machine_add_ram(&m, (uintptr_t)code, sizeof code, code, 1) == 0);
+    hv_cpu_reset(&cpu, &m);
+    cpu.pc = (uintptr_t)code;
+    cpu.cpacr_el1 = 3u << 20;
+    m.stop_pc = (uintptr_t)(code + 2);
+    m.tick = timer_tick;
+    m.notify_cpu_active = became_active;
+    m.activity_opaque = &m;
+    assert(hv_run(&cpu) == HV_EXIT_HALT);
+    assert(cpu.x[0] == 42);
+    assert(m.stats.wfi == 1);
+    assert(activations >= 2); /* initial entry and resumed guest timer wait */
+    assert(!m.percpu[0].active);
+    /* Periodic ticks may skip parked CPUs; explicit broadcasts must not. */
+    static HvCpu parked;
+    m.cpus[1] = &parked; m.ncpus = 2;
+    cpu.exit_req = parked.exit_req = 0;
+    m.percpu[0].active = 1; m.percpu[1].active = 0;
+    assert(hv_machine_kick_active(&m) == 1);
+    assert(cpu.exit_req == 1 && parked.exit_req == 0);
+    cpu.exit_req = 0; m.percpu[0].active = 0;
+    assert(hv_machine_kick_active(&m) == 0 && cpu.exit_req == 0 && parked.exit_req == 0);
+    hv_machine_kick_all(&m);
+    assert(cpu.exit_req == 1 && parked.exit_req == 1);
+    cpu.exit_req = parked.exit_req = 0;
+    m.percpu[0].active = m.percpu[1].active = 1;
+    assert(hv_machine_kick_active(&m) == 2 && cpu.exit_req == 1 && parked.exit_req == 1);
+    /* Deadline mode never delays CPU0 polling or explicit requests. */
+    cpu.exit_req = parked.exit_req = 0;
+    m.percpu[1].timer_deadline_valid = 0;
+    assert(hv_machine_kick_due(&m, 100) == 2); // unknown timer state is conservative
+    cpu.exit_req = parked.exit_req = 0;
+    m.percpu[1].timer_deadline = 200; m.percpu[1].timer_deadline_valid = 1;
+    assert(hv_machine_kick_due(&m, 100) == 1 && !parked.exit_req);
+    cpu.exit_req = 0;
+    assert(hv_machine_kick_due(&m, 200) == 2 && parked.exit_req);
+    cpu.exit_req = parked.exit_req = 0; m.percpu[1].timer_deadline = 0;
+    assert(hv_machine_kick_due(&m, 300) == 1 && !parked.exit_req);
+    hv_cpu_kick(&parked); assert(parked.exit_req); // actual work bypasses filter
+    m.percpu[0].active = m.percpu[1].active = 0;
+    cpu.exit_req = parked.exit_req = 0;
+    assert(hv_machine_kick_due(&m, 400) == 0);
+    hv_machine_free(&m);

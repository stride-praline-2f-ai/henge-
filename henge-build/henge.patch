+        for i in stride(from: 3, to: gray.count, by: 4) { gray[i] = 1 }
+        half.replace(region: MTLRegionMake2D(0, 0, mode.width, mode.height), mipmapLevel: 0, withBytes: &gray, bytesPerRow: mode.width*8)

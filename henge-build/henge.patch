diff --git a/core/fastmem.c b/core/fastmem.c
new file mode 100644
index 0000000..65df08f
--- /dev/null
+++ b/core/fastmem.c
@@ -0,0 +1,127 @@
+#include "fastmem.h"
+#include "machine.h"
+
+#include <stdlib.h>
+
+struct HvFastmem {
+    uint64_t *read[2];
+    /* Only clear populated slots on a full flush. Range invalidations may
+       leave duplicates here; a full list simply refuses more fills until the
+       next full flush. No allocation or libc in the light refill path. */
+    uint32_t *used;
+    uint32_t nused;
+    int anchored;
+    uint64_t base;
+    uint64_t fills, clears, drops, saturated;
+};
+
+void hv_fastmem_free(struct HvFastmem *fm) {
+    if (!fm) return;
+    free(fm->read[0]);
+    free(fm->read[1]);
+    free(fm->used);
+    free(fm);
+}
+
+int hv_fastmem_attach(HvCpu *cpu, struct HvFastmem **owner, int enabled) {
+    cpu->fm_read[0] = cpu->fm_read[1] = cpu->fm_base = 0;
+    cpu->fm_attempts = cpu->fm_hits = 0;
+    for (int i = 0; i < 4; i++) cpu->fm_misses[i] = 0;
+    if (!enabled) { hv_fastmem_free(*owner); *owner = NULL; return 0; }
+    if (!*owner) {
+        struct HvFastmem *fm = calloc(1, sizeof *fm);
+        if (!fm) return -1;
+        fm->read[0] = calloc(HV_FASTMEM_PAGES, sizeof(uint64_t));
+        fm->read[1] = calloc(HV_FASTMEM_PAGES, sizeof(uint64_t));
+        fm->used = calloc(2 * HV_FASTMEM_PAGES, sizeof(uint32_t));
+        if (!fm->read[0] || !fm->read[1] || !fm->used) {
+            hv_fastmem_free(fm);
+            return -1;
+        }
+        *owner = fm;
+    }
+    struct HvFastmem *fm = *owner;
+    cpu->fm_read[0] = (uintptr_t)fm->read[0];
+    cpu->fm_read[1] = (uintptr_t)fm->read[1];
+    cpu->fm_base = fm->base;
+    hv_fastmem_clear(cpu);
+    return 0;
+}
+
+void hv_fastmem_fill(HvCpu *cpu, uint64_t va, int table, uint64_t addend) {
+    if (!cpu->fm_read[0] || table < 1 || table > 2 || !addend || va >> 48 != 0xffff) return;
+    struct HvFastmem *fm = cpu->pc_state->fastmem;
+    if (!fm->anchored) {
+        /* Keep the first canonical kernel data window for this CPU. Code
+           fetches never choose it. Read CPU fields at runtime in the JIT. */
+        __atomic_store_n(&fm->base, va & ~(HV_FASTMEM_SIZE - 1), __ATOMIC_RELAXED);
+        fm->anchored = 1;
+        cpu->fm_base = fm->base;
+    }
+    uint64_t off = va - fm->base;
+    if (off >= HV_FASTMEM_SIZE) return;
+    uint32_t index = (uint32_t)(off >> HV_TLB_PAGE_BITS);
+    uint64_t *entry = &fm->read[table - 1][index];
+    if (!*entry) {
+        if (fm->nused == 2 * HV_FASTMEM_PAGES) {
+            if (cpu->m->fastmem_diagnostics) __atomic_fetch_add(&fm->saturated, 1, __ATOMIC_RELAXED);
+            return;
+        }
+        fm->used[fm->nused++] = (table - 1) * HV_FASTMEM_PAGES + index;
+    }
+    *entry = addend;
+    if (cpu->m->fastmem_diagnostics) __atomic_fetch_add(&fm->fills, 1, __ATOMIC_RELAXED);
+}
+
+void hv_fastmem_clear(HvCpu *cpu) {
+    if (!cpu->fm_read[0]) return;
+    struct HvFastmem *fm = cpu->pc_state->fastmem;
+    if (cpu->m->fastmem_diagnostics) __atomic_fetch_add(&fm->clears, 1, __ATOMIC_RELAXED);
+    for (uint32_t k = 0; k < fm->nused; k++) {
+        uint32_t code = fm->used[k];
+        fm->read[code / HV_FASTMEM_PAGES][code % HV_FASTMEM_PAGES] = 0;
+    }
+    fm->nused = 0;
+}
+
+void hv_fastmem_drop(HvCpu *cpu, uint64_t va, uint64_t len) {
+    if (!cpu->fm_read[0] || !len || !((va >> 55) & 1)) return;
+    struct HvFastmem *fm = cpu->pc_state->fastmem;
+    if (!fm->anchored) return;
+    /* TLBI addresses are compared without the top-byte tag, as in mmu.c.
+       Intersect without computing an end address that could overflow. */
+    uint64_t start = va & 0x00ffffffffffffffull;
+    uint64_t base = fm->base & 0x00ffffffffffffffull;
+    if (start < base) {
+        if (len <= base - start) return;
+        len -= base - start;
+        start = base;
+    }
+    uint64_t off = start - base;
+    if (off >= HV_FASTMEM_SIZE) return;
+    if (len > HV_FASTMEM_SIZE - off) len = HV_FASTMEM_SIZE - off;
+    uint32_t first = (uint32_t)(off >> HV_TLB_PAGE_BITS);
+    uint32_t last = (uint32_t)((off + len - 1) >> HV_TLB_PAGE_BITS);
+    for (uint32_t p = first; p <= last; p++) fm->read[0][p] = fm->read[1][p] = 0;
+    if (cpu->m->fastmem_diagnostics) __atomic_fetch_add(&fm->drops, 1, __ATOMIC_RELAXED);
+}
+
+void *hv_fastmem_read_ptr(HvCpu *cpu, uint64_t va, unsigned bytes, int table) {
+    if (!cpu->fm_read[0] || table < 1 || table > 2 || !bytes || bytes > 8) return NULL;
+    uint64_t off = va - cpu->fm_base;
+    if (off >= HV_FASTMEM_SIZE || (off & ((1u << HV_TLB_PAGE_BITS) - 1)) + 15 >= (1u << HV_TLB_PAGE_BITS)) return NULL;
+    uint64_t *read = (uint64_t *)(uintptr_t)cpu->fm_read[table - 1];
+    uint64_t addend = read[off >> HV_TLB_PAGE_BITS];
+    return addend ? (void *)(uintptr_t)(va + addend) : NULL;
+}
+
+int hv_fastmem_snapshot(HvCpu *cpu, HvFastmemSnapshot *out) {
+    if (!cpu->fm_read[0]) return 0;
+    struct HvFastmem *fm = cpu->pc_state->fastmem;
+    out->base = __atomic_load_n(&fm->base, __ATOMIC_RELAXED);
+    out->fills = __atomic_load_n(&fm->fills, __ATOMIC_RELAXED);
+    out->clears = __atomic_load_n(&fm->clears, __ATOMIC_RELAXED);
+    out->drops = __atomic_load_n(&fm->drops, __ATOMIC_RELAXED);
+    out->saturated = __atomic_load_n(&fm->saturated, __ATOMIC_RELAXED);
+    return 1;
+}
diff --git a/core/fastmem.h b/core/fastmem.h
new file mode 100644
index 0000000..6909ef5
--- /dev/null
+++ b/core/fastmem.h
@@ -0,0 +1,31 @@
+#ifndef HENGE_FASTMEM_H
+#define HENGE_FASTMEM_H
+
+#include "cpu.h"
+#include <stdio.h>
+
+/* Experimental LUT fastmem, not a host VM remapping backend. A bounded 4 GB
+   kernel window has one read addend per guest 16 KB page, separately for PAN.
+   No stores, EL0 accesses, MMIO or cross-page accesses use this cache. */
+#define HV_FASTMEM_BITS 32
+#define HV_FASTMEM_SIZE (1ull << HV_FASTMEM_BITS)
+#define HV_FASTMEM_PAGES (HV_FASTMEM_SIZE >> HV_TLB_PAGE_BITS)
+
+struct HvFastmem;
+int hv_fastmem_attach(HvCpu *cpu, struct HvFastmem **owner, int enabled);
+void hv_fastmem_free(struct HvFastmem *fm);
+/* Scalar only: called with the guest's SIMD registers live. */
+void hv_fastmem_fill(HvCpu *cpu, uint64_t va, int table, uint64_t addend);
+void hv_fastmem_clear(HvCpu *cpu);
+void hv_fastmem_drop(HvCpu *cpu, uint64_t va, uint64_t len);
+/* Reference for the JIT guard, also used by the policy tests. */
+void *hv_fastmem_read_ptr(HvCpu *cpu, uint64_t va, unsigned bytes, int table);
+typedef struct HvFastmemSnapshot {
+    uint64_t base, fills, clears, drops, saturated;
+} HvFastmemSnapshot;
+int hv_fastmem_snapshot(HvCpu *cpu, HvFastmemSnapshot *out);
+struct HvMachine;
+/* Call outside translated code, with host FP/SIMD state restored. */
+void hv_fastmem_log(struct HvMachine *m, FILE *out);
+
+#endif
diff --git a/core/fastmem_log.c b/core/fastmem_log.c
new file mode 100644
index 0000000..bef10d1

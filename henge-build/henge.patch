diff --git a/ios/Henge/Link/LinkDecodeWorker.swift b/ios/Henge/Link/LinkDecodeWorker.swift
new file mode 100644
index 0000000..7d2506a
--- /dev/null
+++ b/ios/Henge/Link/LinkDecodeWorker.swift
@@ -0,0 +1,100 @@
+import Foundation
+import CoreVideo
+
+/// Protocol v2 bounds the entire capture/send/decode path to three frames.
+/// Each generation owns its slots: cancelled work cannot starve a reconnect.
+final class LinkDecodeWorker {
+    private final class Run {
+        let id = UUID()
+        let slots = DispatchSemaphore(value: LinkFrameCredits.capacity)
+        var decoder: LinkDecoder? // decoder queue only
+        var pending = 0, peak = 0 // protected by lock
+        var decoded = 0
+        var totalMS = 0.0, maxMS = 0.0, maxWaitMS = 0.0 // decoder queue only
+    }
+    private let queue = DispatchQueue(label: "henge.link.decoder", qos: .userInitiated)
+    private let lock = NSLock()
+    private var run: Run?
+    private let decodeOperation: ((Data) throws -> UInt64)?
+    private let report: (String) -> Void
+    // The injected operation lets tests suspend real queue work deterministically.
+    init(decode: ((Data) throws -> UInt64)? = nil, report: @escaping (String) -> Void = { _ in }) {
+        decodeOperation = decode; self.report = report
+    }
+    func start(mode: LinkMode, output: @escaping (CVPixelBuffer) -> Void) -> UUID {
+        let next = Run()
+        lock.lock(); let previous = run; run = next; lock.unlock()
+        queue.async { [self, previous] in
+            previous?.decoder = nil
+            guard current(next) else { return }
+            if decodeOperation == nil { next.decoder = LinkDecoder(mode: mode, output: output) }
+        }
+        return next.id
+    }
+    func consume(_ data: Data, generation g: UUID, consumed: @escaping (UInt64) -> Void, failed: @escaping (String) -> Void) {
+        lock.lock()
+        guard let active = run, active.id == g else { lock.unlock(); return }
+        guard active.slots.wait(timeout: .now()) == .success else {
+            lock.unlock(); stop(active); failed("Peer exceeded the negotiated three-frame video window"); return
+        }
+        active.pending += 1; active.peak = max(active.peak, active.pending)
+        lock.unlock()
+        let queued = ProcessInfo.processInfo.systemUptime
+        queue.async { [self, active] in
+            var sequence: UInt64?, failure: String?
+            if current(active) {
+                let began = ProcessInfo.processInfo.systemUptime
+                do {
+                    if let decodeOperation { sequence = try decodeOperation(data) }
+                    else if let decoder = active.decoder { sequence = try decoder.decode(data) }
+                    else { throw LinkError.invalid("Decoder was not initialized") }
+                    let ms = (ProcessInfo.processInfo.systemUptime - began) * 1000
+                    active.decoded += 1; active.totalMS += ms; active.maxMS = max(active.maxMS, ms)
+                    active.maxWaitMS = max(active.maxWaitMS, (began - queued) * 1000)
+                    if active.decoded == 1 || active.decoded % 600 == 0 {
+                        lock.lock(); let peak = active.peak; lock.unlock()
+                        report(String(format: "decode-consumed=%d queue-peak=%d/3 mean-ms=%.2f max-ms=%.2f max-queue-ms=%.2f; acknowledgement precedes presentation", active.decoded, peak, active.totalMS / Double(active.decoded), active.maxMS, active.maxWaitMS))
+                    }
+                } catch { failure = error.localizedDescription }
+            }
+            // Release the queue slot BEFORE acknowledging: a fast sender must
+            // never reclaim its credit while this old job still owns our slot.
+            lock.lock(); active.pending -= 1; lock.unlock()
+            active.slots.signal()
+            guard current(active) else { return }
+            if let failure { stop(active); failed(failure) }
+            else if let sequence { consumed(sequence) }
+        }
+    }
+    func stop() {
+        lock.lock(); let previous = run; run = nil; lock.unlock()
+        queue.async { previous?.decoder = nil }
+    }
+    private func stop(_ active: Run) {
+        lock.lock(); if run === active { run = nil }; lock.unlock()
+        queue.async { active.decoder = nil }
+    }
+    private func current(_ active: Run) -> Bool {
+        lock.lock(); defer { lock.unlock() }; return run === active
+    }
+}
+
+/// If main is temporarily busy, retain just the latest decoded image instead of
+/// posting an unbounded sequence of UI tasks. A superseded image is never
+/// misrepresented as having reached the physical screen.
+final class LinkPixelMailbox {
+    private let lock = NSLock()
+    private var latest: CVPixelBuffer?
+    private var queued = false
+    private let deliver: @MainActor (CVPixelBuffer) -> Void
+    init(deliver: @escaping @MainActor (CVPixelBuffer) -> Void) { self.deliver = deliver }
+    func submit(_ pixel: CVPixelBuffer) {
+        lock.lock(); latest = pixel
+        if queued { lock.unlock(); return }
+        queued = true; lock.unlock()
+        DispatchQueue.main.async { [self] in
+            lock.lock(); let pixel = latest; latest = nil; queued = false; lock.unlock()
+            if let pixel { deliver(pixel) }
+        }
+    }
+}
diff --git a/ios/Henge/Link/LinkFlowControl.swift b/ios/Henge/Link/LinkFlowControl.swift
new file mode 100644
index 0000000..7e9ba85
--- /dev/null
+++ b/ios/Henge/Link/LinkFlowControl.swift
@@ -0,0 +1,46 @@
+import Foundation
+
+/// A send completion only means Network.framework accepted the bytes. A frame
+/// credit is returned only after BOTH that completion and the peer's decoder
+/// acknowledgement. Duplicate, future and retired acknowledgements do nothing.
+final class LinkFrameCredits: @unchecked Sendable {
+    static let capacity = 3
+    struct Receipt { let sequence: UInt64; let consumed: Bool; let seconds: TimeInterval }
+    private struct Frame { let began: TimeInterval; var sent = false; var consumed: TimeInterval? }
+    private let lock = NSLock()
+    private var frames: [UInt64: Frame] = [:]
+    var pending: Int { lock.lock(); defer { lock.unlock() }; return frames.count }
+    func begin(_ sequence: UInt64, now: TimeInterval = ProcessInfo.processInfo.systemUptime) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        guard sequence > 0, frames.count < Self.capacity, frames[sequence] == nil else { return false }
+        frames[sequence] = Frame(began: now); return true
+    }
+    func sent(_ sequence: UInt64, success: Bool) -> Receipt? {
+        lock.lock(); defer { lock.unlock() }
+        guard var frame = frames[sequence] else { return nil }
+        if !success {
+            frames.removeValue(forKey: sequence)
+            return Receipt(sequence: sequence, consumed: false, seconds: 0)
+        }
+        frame.sent = true
+        if let at = frame.consumed {
+            frames.removeValue(forKey: sequence)
+            return Receipt(sequence: sequence, consumed: true, seconds: max(0, at - frame.began))
+        }
+        frames[sequence] = frame; return nil
+    }
+    func consumed(_ sequence: UInt64, now: TimeInterval = ProcessInfo.processInfo.systemUptime) -> Receipt? {
+        lock.lock(); defer { lock.unlock() }
+        guard var frame = frames[sequence], frame.consumed == nil else { return nil }
+        frame.consumed = now
+        if frame.sent {
+            frames.removeValue(forKey: sequence)
+            return Receipt(sequence: sequence, consumed: true, seconds: max(0, now - frame.began))
+        }
+        frames[sequence] = frame; return nil
+    }
+    func cancel() -> Int {
+        lock.lock(); defer { lock.unlock() }
+        let count = frames.count; frames.removeAll(); return count
+    }
+}
diff --git a/ios/Henge/Link/LinkPairing.swift b/ios/Henge/Link/LinkPairing.swift
new file mode 100644
index 0000000..3b85616
--- /dev/null
+++ b/ios/Henge/Link/LinkPairing.swift
@@ -0,0 +1,110 @@
+import Foundation
+import Network
+import Security
+import SwiftUI
+
+/// Local discovery is only an address hint. TLS possession of the pairing key
+/// remains the authority; no key, user name or screen data is advertised.
+struct LinkDiscoveredPeer: Identifiable, Equatable {
+    static let serviceType = "_henge-link._tcp"
+    let name: String
+    let endpoint: NWEndpoint
+    var id: String { name }
+    var title: String { "Henge iPad · " + String(name.suffix(6)) }
+    static func validName(_ name: String) -> Bool {
+        name.hasPrefix("Henge-") && UUID(uuidString: String(name.dropFirst(6))) != nil
+    }
+    init?(endpoint: NWEndpoint) {
+        guard case let .service(name, type, domain, _) = endpoint,
+              Self.validName(name), type == Self.serviceType, domain == "local." else { return nil }
+        self.name = name; self.endpoint = endpoint
+    }
+}
+
+@MainActor
+final class LinkDiscovery: ObservableObject {
+    @Published private(set) var peers: [LinkDiscoveredPeer] = []
+    @Published private(set) var status = ""
+    private var browser: NWBrowser?
+    private var generation = UUID()
+    func start(wired: Bool) {
+        stop(); let g = UUID(); generation = g
+        let parameters = NWParameters.tcp
+        parameters.prohibitedInterfaceTypes = [.cellular]
+        parameters.includePeerToPeer = false
+        if wired { parameters.requiredInterfaceType = .wiredEthernet }
+        let browser = NWBrowser(for: .bonjour(type: LinkDiscoveredPeer.serviceType, domain: "local."), using: parameters)
+        self.browser = browser; status = "Looking for an iPad on your local network…"
+        browser.browseResultsChangedHandler = { [weak self] results, _ in
+            let peers = results.compactMap { LinkDiscoveredPeer(endpoint: $0.endpoint) }
+            // The same service can be seen on more than one interface.
+            let unique = Dictionary(peers.map { ($0.name, $0) }, uniquingKeysWith: { first, _ in first }).values.sorted { $0.name < $1.name }
+            Task { @MainActor in
+                guard let self, self.generation == g else { return }
+                self.peers = Array(unique)
+                self.status = unique.isEmpty ? "No iPad found yet. Start the display link on your iPad, or use manual connection." : "Select your iPad. Its address and port are discovered automatically."
+            }
+        }
+        browser.stateUpdateHandler = { [weak self] state in
+            if case .failed = state {
+                Task { @MainActor in guard let self, self.generation == g else { return }; self.status = "Discovery unavailable. Allow Local Network in Settings, or use manual connection." }
+            }
+        }
+        browser.start(queue: DispatchQueue(label: "henge.link.discovery", qos: .utility))
+    }
+    func stop() { generation = UUID(); browser?.cancel(); browser = nil; peers = [] }
+    deinit { browser?.cancel() }
+}
+
+struct LinkHostPairing: Codable {
+    var name: String
+    var key: String
+    static func fresh() throws -> Self { Self(name: "Henge-" + UUID().uuidString, key: try LinkTransport.newKey()) }
+}
+struct LinkSavedPeer: Codable {
+    let name: String
+    let key: String
+    let wired: Bool
+}
+
+/// Explicit opt-in only. Device-local, unlocked-only Keychain items; neither
+/// iCloud synchronization, UserDefaults, Documents nor log/Bonjour storage.
+struct LinkPairingStore {
+    static let shared = LinkPairingStore()
+    let service: String
+    init(service: String = (Bundle.main.bundleIdentifier ?? "com.henge.app") + ".link-pairing-v2") { self.service = service }
+    private func query(_ account: String) -> [String: Any] {
+        [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: service,
+         kSecAttrAccount as String: account, kSecAttrSynchronizable as String: false]
+    }
+    func load<T: Decodable>(_ account: String, as: T.Type) throws -> T? {
+        var q = query(account); q[kSecReturnData as String] = true; q[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        let status = SecItemCopyMatching(q as CFDictionary, &result)
+        if status == errSecItemNotFound { return nil }
+        guard status == errSecSuccess, let data = result as? Data else { throw LinkError.invalid("Saved pairing is unavailable. Unlock this device or pair manually. (\(status))") }
+        return try JSONDecoder().decode(T.self, from: data)
+    }
+    func save<T: Encodable>(_ account: String, value: T) throws {
+        let q = query(account), data = try JSONEncoder().encode(value)
+        let attributes: [String: Any] = [kSecValueData as String: data, kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly]
+        var status = SecItemUpdate(q as CFDictionary, attributes as CFDictionary)
+        if status == errSecItemNotFound {
+            status = SecItemAdd(q.merging(attributes, uniquingKeysWith: { _, new in new }) as CFDictionary, nil)
+        }
+        guard status == errSecSuccess else { throw LinkError.invalid("Could not save pairing securely. Manual pairing is still available. (\(status))") }
+    }
+    func forget(_ account: String) throws {
+        let status = SecItemDelete(query(account) as CFDictionary)
+        guard status == errSecSuccess || status == errSecItemNotFound else { throw LinkError.invalid("Could not remove saved pairing (\(status))") }
+    }
+    func host(remember: Bool) throws -> LinkHostPairing {
+        if !remember { return try .fresh() }
+        if let saved = try load("host", as: LinkHostPairing.self) {
+            guard LinkDiscoveredPeer.validName(saved.name) else { throw LinkError.invalid("Invalid saved pairing; forget it and pair again") }
+            _ = try LinkTransport.parameters(key: saved.key, wired: false)
+            return saved
+        }
+        let fresh = try LinkHostPairing.fresh(); try save("host", value: fresh); return fresh
+    }
+}
diff --git a/ios/Henge/Link/LinkProtocol.swift b/ios/Henge/Link/LinkProtocol.swift
new file mode 100644
index 0000000..94231b2
--- /dev/null
+++ b/ios/Henge/Link/LinkProtocol.swift
@@ -0,0 +1,94 @@
+import Foundation
+
+// Original protocol. Never deserialize an unbounded peer-controlled allocation.
+enum LinkError: Error, LocalizedError {
+    case invalid(String)
+    var errorDescription: String? { if case let .invalid(s) = self { return s }; return nil }
+}
+struct LinkMode: Codable, Equatable {
+    var width: Int, height: Int, widthMM: Int, heightMM: Int, hz: Int
+    var codedWidth: Int { (width + 1) & ~1 }
+    var codedHeight: Int { (height + 1) & ~1 }
+    func validate() throws {
+        guard (320...8192).contains(width), (240...8192).contains(height), width * height <= 33_554_432,
+              (1...65535).contains(widthMM), (1...65535).contains(heightMM), (24...120).contains(hz) else {
+            throw LinkError.invalid("Unsupported display mode")
+        }
+    }
+}
+struct LinkControl: Codable {
+    static let currentVersion = 2
+    var version = Self.currentVersion
+    var type: String
+    var mode: LinkMode? = nil
+    var x: Int? = nil, y: Int? = nil, code: Int? = nil, down: Bool? = nil
+    var sequence: UInt64? = nil
+    func validate() throws {
+        guard version == Self.currentVersion else { throw LinkError.invalid("Update Henge on both devices: different Link protocol version") }
+        switch type {
+        case "hello", "ready": guard let mode else { throw LinkError.invalid("Missing display mode") }; try mode.validate()
+        case "move", "scroll": guard let x, let y, (-4096...4096).contains(x), (-4096...4096).contains(y) else { throw LinkError.invalid("Invalid pointer delta") }
+        case "button": guard let code, (0...2).contains(code), down != nil else { throw LinkError.invalid("Invalid button") }
+        case "key": guard let code, (4...231).contains(code), down != nil else { throw LinkError.invalid("Invalid HID key") }
+        case "videoAck": guard let sequence, sequence > 0 else { throw LinkError.invalid("Invalid video acknowledgement") }
+        case "ping", "pong", "bye", "release": break
+        default: throw LinkError.invalid("Unknown control message")
+        }
+    }
+}
+struct LinkPacket {
+    static let maximum = 16 * 1024 * 1024
+    let kind: UInt8
+    let payload: Data
+    func wire() throws -> Data {
+        guard (1...2).contains(kind), payload.count < Self.maximum else { throw LinkError.invalid("Oversize packet") }
+        var n = UInt32(payload.count + 1).bigEndian
+        var result = Data(bytes: &n, count: 4); result.append(kind); result.append(payload); return result
+    }
+}
+struct LinkParser {
+    private var buffer = Data()
+    mutating func append(_ data: Data) throws -> [LinkPacket] {
+        guard data.count <= 65536, buffer.count + data.count <= LinkPacket.maximum + 65540 else { throw LinkError.invalid("Receive buffer limit") }
+        buffer.append(data)
+        var output = [LinkPacket]()
+        while buffer.count >= 4 {
+            let n = buffer.prefix(4).reduce(0) { ($0 << 8) | Int($1) }
+            guard n >= 1, n <= LinkPacket.maximum else { throw LinkError.invalid("Invalid packet length") }
+            guard buffer.count >= n + 4 else { break }
+            let kind = buffer[buffer.startIndex + 4]
+            guard kind == 1 || kind == 2 else { throw LinkError.invalid("Invalid packet type") }
+            output.append(LinkPacket(kind: kind, payload: Data(buffer.dropFirst(5).prefix(n - 1))))
+            buffer = Data(buffer.dropFirst(n + 4))
+        }
+        return output
+    }
+}
+struct LinkVideoHeader: Codable {
+    var codec: String, width: Int, height: Int, sequence: UInt64
+    var parameterSets: [Data]
+    var codedWidth: Int? = nil, codedHeight: Int? = nil
+    var encodedWidth: Int { codedWidth ?? width }
+    var encodedHeight: Int { codedHeight ?? height }
+    func pack(_ data: Data) throws -> Data {
+        let meta = try JSONEncoder().encode(self)
+        guard meta.count <= 65536, data.count > 0 else { throw LinkError.invalid("Invalid video payload") }
+        var n = UInt32(meta.count).bigEndian
+        var out = Data(bytes: &n, count: 4); out.append(meta); out.append(data); return out
+    }
+    static func unpack(_ payload: Data) throws -> (Self, Data) {
+        guard payload.count >= 5 else { throw LinkError.invalid("Short video payload") }
+        let n = payload.prefix(4).reduce(0) { ($0 << 8) | Int($1) }
+        guard n > 0, n <= 65536, payload.count > n + 4 else { throw LinkError.invalid("Invalid video header") }
+        let meta = try JSONDecoder().decode(Self.self, from: payload.subdata(in: 4..<4+n))
+        guard meta.codec == "hevc" || meta.codec == "h264", (320...8192).contains(meta.width), (240...8192).contains(meta.height), meta.width * meta.height <= 33_554_432,
+              (2...3).contains(meta.parameterSets.count), meta.parameterSets.allSatisfy({ !$0.isEmpty && $0.count <= 16384 }) else { throw LinkError.invalid("Invalid codec configuration") }
+        // A native odd-sized viewport is padded by at most one pixel per axis
+        // for the hardware chroma format. It is never rescaled or truncated.
+        guard meta.encodedWidth >= meta.width, meta.encodedWidth <= ((meta.width + 1) & ~1),
+              meta.encodedHeight >= meta.height, meta.encodedHeight <= ((meta.height + 1) & ~1),
+              meta.encodedWidth <= 8192, meta.encodedHeight <= 8192,
+              meta.encodedWidth * meta.encodedHeight <= 33_554_432 else { throw LinkError.invalid("Invalid codec canvas") }
+        return (meta, Data(payload.dropFirst(4+n)))
+    }
+}

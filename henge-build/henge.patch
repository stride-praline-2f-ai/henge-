new file mode 100644
index 0000000..9a5c260
--- /dev/null
+++ b/ios/Henge/PhysicalMouseButtons.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+/// Compatibility mapping for GameController physical mice/trackpads only.
+/// Guest button IDs are 0 = left, 1 = right, 2 = middle; touch controls retain those IDs.
+struct PhysicalMouseButtons {
+    static let swapKey = "henge.mouse.swapRightAndMiddle"
+
+    /// Captured when the VM session starts, so a held button's release uses the same mapping.
+    let swapsRightAndMiddle: Bool
+    private(set) var held: Set<Int32> = []
+
+    mutating func event(_ physicalButton: Int32, pressed: Bool) -> Int32? {
+        guard (0...2).contains(physicalButton) else { return nil }
+        let guestButton = swapsRightAndMiddle && physicalButton != 0 ? 3 - physicalButton : physicalButton
+        if pressed {
+            held.insert(guestButton)
+        } else {
+            held.remove(guestButton)
+        }
+        return guestButton
+    }
+
+    /// Release all mapped buttons on disconnect or when the VM input session ends.
+    mutating func releaseAll() -> [Int32] {
+        let releases = held.sorted()
+        held.removeAll()
+        return releases
+    }
+}
diff --git a/ios/Henge/PreviewWorkQueue.swift b/ios/Henge/PreviewWorkQueue.swift
new file mode 100644
index 0000000..0929051
--- /dev/null
+++ b/ios/Henge/PreviewWorkQueue.swift
@@ -0,0 +1,21 @@
+import Foundation
+
+/// All preview state and writes belong to one utility queue. Never caches a failed write.
+final class PreviewWorkQueue: @unchecked Sendable {
+    private let queue = DispatchQueue(label: "henge.preview", qos: .utility)
+    private var last: (path: String, frame: UInt64)?
+
+    func beginSession() { queue.async { self.last = nil } }
+    func save(path: String, frame: @escaping @Sendable () -> UInt64,
+              write: @escaping @Sendable () -> Bool) {
+        queue.async {
+            let current = frame()
+            if let previous = self.last, previous.path == path, previous.frame == current { return }
+            if write() { self.last = (path, current) }
+        }
+    }
+    func finish(write: @Sendable () -> Bool) {
+        queue.sync { _ = write(); last = nil }
+    }
+    func drain() { queue.sync {} }
+}
diff --git a/ios/Henge/Resources/HengeLink.txt b/ios/Henge/Resources/HengeLink.txt
new file mode 100644
index 0000000..d973aa5
--- /dev/null
+++ b/ios/Henge/Resources/HengeLink.txt
@@ -0,0 +1,11 @@
+Henge Link protocol 2 — experimental second PVG display
+Wired mode requires compatible USB-C Ethernet adapters; plain USB-C is not supported.
+Pair before boot; no guest macOS reinstall is needed. Viewer mode does not require JIT.
+Native hardware codec/transport checks are not physical iPad-to-Duo validation.
+Remote video is compressed; primary Retina output is unchanged.
+Source and detailed setup/security/validation: docs/henge-link/README.md
+Decoder-consumption acknowledgements bound the end-to-end video window to three frames. Update both devices.
+
+Nearby iPads discovery finds the current address and port. Opt-in Remember on both devices saves the pairing in device-only Keychain. Forget on the iPad revokes the key. No key is advertised. Manual connection remains available.
+
+Three-finger tap on the Duo toggles local display controls without changing video dimensions. Choose the iPad as Main Display in macOS System Settings > Displays; the Duo remains an extension. All emulation runs on the iPad.

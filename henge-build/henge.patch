diff --git a/tests/test_translation_race.py b/tests/test_translation_race.py
new file mode 100644
index 0000000..b65c694
--- /dev/null
+++ b/tests/test_translation_race.py
@@ -0,0 +1,91 @@
+"""Exercise actual dispatch lookup with deterministic concurrent publication.
+
+Only emit/place and platform helpers are substituted: a competing CPU publishes
+at controlled points. The real block hash lookup, validation and publication run.
+No claim of a full threaded JIT execution test; native engine tests complement it.
+"""
+from pathlib import Path
+import os, subprocess, tempfile
+root = Path(__file__).resolve().parents[1]
+src = (root / 'core/dispatch.c').read_text()
+lookup = src[src.index('static HvBlock *lookup('):src.index('\n/* WFE.', src.index('static HvBlock *lookup('))]
+preamble = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "machine.h"
+#define hash_of hv_block_hash
+#define find hv_block_find
+static HvMachine m;
+static HvCpu cpu;
+static HvBlock winner, storage[4];
+static uint32_t page_gen, words[4096];
+static uint8_t protected_page;
+static int schedule, emitted, placed, kicks;
+static uint64_t mach_absolute_time(void) { return 1; }
+static void publish(const HvBlock *b) {
+    winner = *b;
+    if (schedule == 3) winner.flags ^= HV_BLOCK_PAN;
+    if (schedule == 4) winner.gen++;
+    winner.code = words;
+    /* Same bucket deliberately, to test exact identity and page generation. */
+    m.hash[hash_of(b->va, b->pa, b->flags)] = &winner;
+}
+static int hv_translate_emit(HvMachine *mm, HvBlock *b, const uint32_t *c, uint32_t n) {
+    (void)mm; (void)c; (void)n; emitted++;
+    if (schedule == 1 || schedule == 3 || schedule == 4) publish(b);
+    return 0;
+}
+static uint32_t hv_translate_pending_words(void) { return 64; }
+static int hv_translate_place(HvMachine *mm, HvBlock *b) {
+    placed++; b->code = words + 64; mm->jit.used += 64;
+    if (schedule == 2) publish(b);
+    return 0;
+}
+static void block_dump(const HvBlock *b, const uint32_t *c) { (void)b; (void)c; }
+static void hv_tlb_protect_code_page(HvCpu *c, HvRam *r, uint64_t p) { (void)c; (void)r; (void)p; }
+void hv_machine_kick_all(HvMachine *mm) { (void)mm; kicks++; }
+'''
+main = r'''
+int main(void) {
+    for (schedule = 0; schedule <= 4; schedule++) {
+        memset(&m, 0, sizeof m); memset(&cpu, 0, sizeof cpu);
+        memset(&winner, 0, sizeof winner);
+        pthread_mutex_init(&m.tr_mu, NULL);
+        protected_page = 1; page_gen = 7;
+        m.nram = 1; m.ram[0] = (HvRam){.pa=0x80000000, .size=16384,
+            .page_gen=&page_gen, .code_pages=&protected_page};
+        m.blocks = storage; m.max_blocks = 4; m.jit.base = words;
+        cpu.m = &m; cpu.pc_state = &m.percpu[0];
+        emitted = placed = kicks = 0;
+        HvBlock *b = lookup(&cpu, 0x1000, 0x80000000, HV_BLOCK_EL1, words, 1);
+        assert(b && b->flags == HV_BLOCK_EL1 && b->gen == 7);
+        assert(emitted == 1 && !kicks);
+        if (schedule == 1) {
+            assert(b == &winner && !placed && !m.jit.used && !m.nblocks);
+            assert(m.stats.duplicate_place_avoided == 1);
+            assert(m.stats.duplicate_bytes_avoided == 256);
+        } else {
+            assert(placed == 1 && m.jit.used == 64);
+            assert(!m.stats.duplicate_place_avoided);
+            assert(m.stats.duplicate_place_late == (schedule == 2));
+            assert(m.nblocks == (schedule != 2));
+        }
+        assert(lookup(&cpu, 0x1000, 0x80000000, HV_BLOCK_EL1, words, 1) == b);
+        assert(emitted == 1); /* front-cache reuse */
+        pthread_mutex_destroy(&m.tr_mu);
+    }
+    puts("translation race: winner before placement saves 256 bytes; late winner, flags, generations and reuse passed");
+}
+'''
+# Include the real RAM-region lookup, without the rest of the Darwin runtime.
+msrc = (root / 'core/machine.c').read_text()
+a = msrc.index('HvRam *hv_ram_lookup(')
+b = msrc.index('\n}', a) + 2
+ram_lookup = msrc[a:b]
+with tempfile.TemporaryDirectory() as tmp:
+    c = Path(tmp) / 'race.c'; c.write_text(preamble + ram_lookup + '\n' + lookup + main)
+    exe = Path(tmp) / 'race'
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=c11', '-O2', '-pthread',
+                    '-I' + str(root/'core'), '-I' + str(root/'host'), str(c), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
diff --git a/tests/test_wake_epoch.c b/tests/test_wake_epoch.c
new file mode 100644
index 0000000..1933051
--- /dev/null
+++ b/tests/test_wake_epoch.c
@@ -0,0 +1,36 @@
+#include "wake_epoch.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+
+static HvWakeEpoch epoch;
+static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t cv = PTHREAD_COND_INITIALIZER;
+static int sleeping, release_worker, kicks;
+static void *worker(void *arg) {
+    uint64_t token = (uintptr_t)arg;
+    assert(hv_wake_current(&epoch, token));
+    pthread_mutex_lock(&mu);
+    sleeping = 1; pthread_cond_signal(&cv);
+    while (!release_worker) pthread_cond_wait(&cv, &mu);
+    pthread_mutex_unlock(&mu);
+    if (hv_wake_current(&epoch, token)) kicks++;
+    return NULL;
+}
+int main(void) {
+    uint64_t first = hv_wake_advance(&epoch);
+    pthread_t t;
+    assert(pthread_create(&t, NULL, worker, (void *)(uintptr_t)first) == 0);
+    pthread_mutex_lock(&mu);
+    while (!sleeping) pthread_cond_wait(&cv, &mu);
+    hv_wake_advance(&epoch); /* stop while worker sleeps */
+    uint64_t next = hv_wake_advance(&epoch); /* a new start must not revive it */
+    assert(hv_wake_current(&epoch, next) && !hv_wake_current(&epoch, first));
+    release_worker = 1; pthread_cond_signal(&cv);
+    pthread_mutex_unlock(&mu);
+    pthread_join(t, NULL);
+    assert(kicks == 0);
+    hv_wake_advance(&epoch);
+    assert(!hv_wake_current(&epoch, next));
+    puts("wake ticker: stop during sleep and restart cannot revive stale worker");
+}
diff --git a/tests/test_walk_log.py b/tests/test_walk_log.py
new file mode 100644
index 0000000..e6cb23b
--- /dev/null
+++ b/tests/test_walk_log.py
@@ -0,0 +1,48 @@
+"""Exercise production walk-log decisions, including conservative fallbacks.
+Native MMU/JIT tests separately cover actual remote drops and instruction runs.
+"""
+from pathlib import Path
+import os, subprocess, tempfile
+root=Path(__file__).resolve().parents[1];s=(root/'core/mmu.c').read_text()
+a=s.index('static int walks_elsewhere(');b=s.index('{',a);e=b+1;depth=1
+while depth:
+    depth+=(s[e]=='{')-(s[e]=='}');e+=1
+function=s[a:e]
+defines='\n'.join(line for line in s.splitlines() if line.startswith(('#define HV_WALK_ANY ','#define WALK_LOG ','#define WALK_PAGE_BITS ')))
+code=r'''
+#include "machine.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+int hv_knob[HV_K_COUNT];
+static HvMachine m; static HvCpu c;
+'''+defines+'\n'+function+r'''
+int main(void) {
+ c.m=&m;c.pc_state=&m.percpu[0];HvPerCpu *p=c.pc_state;
+ const uint64_t P=0x100004000ull,Q=P+0x4000;
+ hv_knob[HV_K_WALKLOG]=1;
+ p->walk_page[0]=Q;p->walk_seq=1;
+ assert(walks_elsewhere(&c,1,1,P,1));
+ assert(!walks_elsewhere(&c,1,1,P,2)); // real overlap, not just equality
+ p->walk_page[0]=P;assert(!walks_elsewhere(&c,1,1,P,1));
+ p->walk_page[0]=HV_WALK_ANY;assert(!walks_elsewhere(&c,1,1,P,1));
+ p->walk_page[0]=Q;p->walk_seq=2;
+ assert(walks_elsewhere(&c,0,2,P,1)); // walk ran while the drop was in progress
+ assert(walks_elsewhere(&c,0,2,0xab00000000000000ull|P,1));
+ p->walk_page[0]=P;assert(!walks_elsewhere(&c,0,2,0xab00000000000000ull|P,1));
+ for(int k=0;k<8;k++)p->walk_page[k]=Q;
+ p->walk_seq=14;assert(walks_elsewhere(&c,0,14,P,1));
+ p->walk_seq=16;assert(!walks_elsewhere(&c,0,16,P,1)); // overwritten/uncertain log
+ p->walk_seq=18;assert(!walks_elsewhere(&c,0,2,P,1)); // later reuse after sampled end
+ assert(!walks_elsewhere(&c,0,18,P,1));
+ p->walk_seq=2;assert(!walks_elsewhere(&c,UINT32_MAX-3,2,P,1)); // sequence wrap is conservative
+ hv_knob[HV_K_WALKLOG]=0;
+ assert(!walks_elsewhere(&c,0,2,P,1));assert(walks_elsewhere(&c,2,2,P,1));
+ puts("walk log: overlap, other page, tagged VA, process switch, intervening walks, reuse, overflow, wrap and disabled fallback passed");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='henge-walk-log-') as tmp:
+    p=Path(tmp);(p/'check.c').write_text(code)
+    subprocess.run([os.environ.get('CC','cc'),'-std=c11','-Wall','-Wextra','-Werror','-O1','-g','-fsanitize=address,undefined',
+                    '-I'+str(root/'core'),'-I'+str(root/'host'),str(p/'check.c'),'-o',str(p/'check')],check=True)
+    subprocess.run([str(p/'check')],check=True,timeout=10)

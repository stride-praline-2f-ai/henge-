+/* Guest-side, user-initiated preference changes and undo. */
+static const char lighter_macos_script[] =
+    "#!/bin/sh\n"
+    "# The guest user runs this explicitly from Terminal.\n"
+    "export LC_ALL=C\n"
+    "umask 077\n"
+    "action=${1:-}\n"
+    "case \"$action\" in apply|undo) ;; *) exit 2 ;; esac\n"
+    "state=\"$HOME/Library/Application Support/Henge/Lighter macOS\"\n"
+    "mkdir -p \"$state\" || exit 1\n"
+    "if ! mkdir \"$state/lock\"; then\n"
+    "    echo 'Another Lighter macOS change is in progress.'\n"
+    "    exit 1\n"
+    "fi\n"
+    "trap 'rmdir \"$state/lock\"' EXIT\n"
+    "trap 'exit 1' HUP INT TERM\n"
+    "\n"
+    "# Return a typed value or an explicit missing marker. Unrecognized errors\n"
+    "# must leave the existing preference untouched.\n"
+    "read_preference() {\n"
+    "    preference_type=$(/usr/bin/defaults read-type \"$1\" \"$2\" 2>&1) || {\n"
+    "        case \"$preference_type\" in\n"
+    "            *\"does not exist\"*) printf '%s\\n' missing; return ;;\n"
+    "            *) printf '%s\\n' \"$preference_type\" >&2; return 1 ;;\n"
+    "        esac\n"
+    "    }\n"
+    "    case \"$preference_type\" in\n"
+    "        'Type is boolean') preference_type=bool ;;\n"
+    "        'Type is integer') preference_type=int ;;\n"
+    "        *) echo \"Unsupported existing preference type for $2.\" >&2; return 1 ;;\n"
+    "    esac\n"
+    "    preference_value=$(/usr/bin/defaults read \"$1\" \"$2\") || return 1\n"
+    "    case \"$preference_value\" in 1|0) ;; *) [ \"$preference_type\" = int ] || return 1 ;; esac\n"
+    "    case \"${preference_value#-}\" in ''|*[!0-9]*) return 1 ;; esac\n"
+    "    printf '%s %s\\n' \"$preference_type\" \"$preference_value\"\n"
+    "}\n"
+    "\n"
+    "change_preference() {\n"
+    "    domain=$1 key=$2 kind=$3 wanted=$4\n"
+    "    backup=\"$state/$key\"\n"
+    "    current=$(read_preference \"$domain\" \"$key\") || return 1\n"
+    "    if [ \"$action\" = apply ]; then\n"
+    "        [ \"$current\" != \"$kind $wanted\" ] || return 0\n"
+    "        if [ ! -f \"$backup\" ]; then\n"
+    "            temporary=$(mktemp \"$state/.backup.XXXXXX\") || return 1\n"
+    "            if ! printf '%s\\n' \"$current\" > \"$temporary\" || ! mv \"$temporary\" \"$backup\"; then\n"
+    "                rm -f \"$temporary\"\n"
+    "                return 1\n"
+    "            fi\n"
+    "        elif [ \"$current\" != \"$(cat \"$backup\")\" ]; then\n"
+    "            echo \"Keeping your newer value for $key. Undo before applying again.\"\n"
+    "            return 0\n"
+    "        fi\n"
+    "        /usr/bin/defaults write \"$domain\" \"$key\" \"-$kind\" \"$wanted\"\n"
+    "        return\n"
+    "    fi\n"
+    "    [ -f \"$backup\" ] || return 0\n"
+    "    if [ \"$current\" = \"$kind $wanted\" ]; then\n"
+    "        read -r saved_type saved_value < \"$backup\" || return 1\n"
+    "        case \"$saved_type\" in\n"
+    "            missing) /usr/bin/defaults delete \"$domain\" \"$key\" || return 1 ;;\n"
+    "            bool|int) /usr/bin/defaults write \"$domain\" \"$key\" \"-$saved_type\" \"$saved_value\" || return 1 ;;\n"
+    "            *) return 1 ;;\n"
+    "        esac\n"
+    "    else\n"
+    "        echo \"Keeping your newer value for $key.\"\n"
+    "    fi\n"
+    "    rm \"$backup\"\n"
+    "}\n"
+    "\n"
+    "failed=0\n"
+    "change_preference NSGlobalDomain NSAutomaticWindowAnimationsEnabled bool 0 || failed=1\n"
+    "change_preference com.apple.dock launchanim bool 0 || failed=1\n"
+    "change_preference com.apple.WindowManager StandardHideWidgets int 1 || failed=1\n"
+    "change_preference com.apple.WindowManager StageManagerHideWidgets int 1 || failed=1\n"
+    "if [ \"$failed\" -ne 0 ]; then\n"
+    "    echo 'Some preferences could not be changed. Saved values are available for Undo.'\n"
+    "else\n"
+    "    echo 'Done. Log out and back in to apply the changes across the desktop.'\n"
+    "fi\n"
+    "exit \"$failed\"\n";

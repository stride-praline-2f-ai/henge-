diff --git a/tests/test_lighter_macos.py b/tests/test_lighter_macos.py
new file mode 100644
index 0000000..444bc62
--- /dev/null
+++ b/tests/test_lighter_macos.py
@@ -0,0 +1,82 @@
+"""Exercise the exact embedded guest script with isolated macOS defaults fixtures."""
+import ast
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+import tempfile
+import unittest
+
+EMBEDDED = Path(__file__).resolve().parents[1] / "host/lighter_macos.h"
+
+MOCK_DEFAULTS = r"""
+import json, os, sys
+from pathlib import Path
+prefs = Path(os.environ["MOCK_PREFERENCES"])
+values = json.loads(prefs.read_text())
+command, domain, key, *args = sys.argv[1:]
+name = domain + "/" + key
+if command in ("read-type", "read"):
+    if name not in values:
+        sys.exit("The domain/default pair does not exist")
+    kind, value = values[name]
+    print({"bool":"Type is boolean","int":"Type is integer","string":"Type is string"}[kind]
+          if command == "read-type" else value)
+elif command == "write":
+    values[name] = [args[0][1:], args[1]]
+elif command == "delete":
+    del values[name]
+else:
+    sys.exit("Unsupported defaults command")
+prefs.write_text(json.dumps(values))
+"""
+
+
+class LighterMacOSChecks(unittest.TestCase):
+    WINDOW = "NSGlobalDomain/NSAutomaticWindowAnimationsEnabled"
+    DOCK = "com.apple.dock/launchanim"
+    WIDGET = "com.apple.WindowManager/StandardHideWidgets"
+    STAGE = "com.apple.WindowManager/StageManagerHideWidgets"
+
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        home = self.home = Path(directory.name)
+        mock = home / "defaults.py"
+        mock.write_text(MOCK_DEFAULTS)
+        self.prefs = home / "preferences.json"
+        self.script = home / "lighter.sh"
+        lines = (line.strip().rstrip(";") for line in EMBEDDED.read_text().splitlines())
+        script = "".join(ast.literal_eval(line) for line in lines if line.startswith('"'))
+        self.script.write_text(script.replace("/usr/bin/defaults", f"{shlex.quote(sys.executable)} {shlex.quote(str(mock))}"))
+
+    def run_action(self, action, expected=0):
+        result = subprocess.run(["sh", str(self.script), action], text=True, capture_output=True,
+                                env={**os.environ, "HOME": str(self.home), "MOCK_PREFERENCES": str(self.prefs)})
+        self.assertEqual(result.returncode, expected, result.stdout + result.stderr)
+        return json.loads(self.prefs.read_text())
+
+    def test_apply_is_idempotent_and_undo_restores_exact_previous_values(self):
+        original = {self.DOCK: ["bool", "1"], self.WIDGET: ["int", "7"], self.STAGE: ["int", "1"]}
+        self.prefs.write_text(json.dumps(original))
+        after = {self.DOCK: ["bool", "0"], self.WINDOW: ["bool", "0"],
+                 self.WIDGET: ["int", "1"], self.STAGE: ["int", "1"]}
+        self.assertEqual(self.run_action("apply"), after)
+        self.assertEqual(self.run_action("apply"), after)
+        self.assertEqual(self.run_action("undo"), original)
+        self.assertEqual(self.run_action("undo"), original)
+
+    def test_manual_changes_survive_undo_and_unknown_types_are_preserved(self):
+        self.prefs.write_text(json.dumps({self.WIDGET: ["string", "original"]}))
+        changed = self.run_action("apply", expected=1)
+        self.assertEqual(changed[self.WIDGET], ["string", "original"])
+        changed[self.STAGE] = ["int", "9"]
+        self.prefs.write_text(json.dumps(changed))
+        self.assertEqual(self.run_action("undo", expected=1),
+                         {self.WIDGET: ["string", "original"], self.STAGE: ["int", "9"]})
+
+
+if __name__ == "__main__":
+    unittest.main()

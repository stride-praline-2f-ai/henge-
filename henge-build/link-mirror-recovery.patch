diff --git a/ios/Henge/Link/LinkProtocol.swift b/ios/Henge/Link/LinkProtocol.swift
index 23db487..88b14c6 100644
--- a/ios/Henge/Link/LinkProtocol.swift
+++ b/ios/Henge/Link/LinkProtocol.swift
@@ -3,7 +3,28 @@ import Foundation
 // Original protocol. Never deserialize an unbounded peer-controlled allocation.
 enum LinkError: Error, LocalizedError {
     case invalid(String)
-    var errorDescription: String? { if case let .invalid(s) = self { return s }; return nil }
+    case encoderUnavailable
+    var errorDescription: String? {
+        switch self {
+        case .invalid(let message): return message
+        case .encoderUnavailable: return "No supported hardware encoder for this stream. The host display is unchanged."
+        }
+    }
+}
+enum LinkMirrorStatus: Int {
+    case displayUnavailable = 1 // Version 2 peers already understand this value.
+    case waitingForDisplay = 2
+    case encoderUnavailable = 3
+    case setupFailed = 4
+
+    var viewerMessage: String {
+        switch self {
+        case .displayUnavailable: return "The Mac display is still unavailable. Open the Mac desktop on the host and retry video."
+        case .waitingForDisplay: return "Waiting for the Mac display. Wireless controls are connected."
+        case .encoderUnavailable: return "The host could not start hardware video at the requested rate or 30 Hz. Wireless controls are connected."
+        case .setupFailed: return "The host could not set up video. Check the host’s Henge Link log."
+        }
+    }
 }
 struct LinkMode: Codable, Equatable {
     var width: Int, height: Int, widthMM: Int, heightMM: Int, hz: Int

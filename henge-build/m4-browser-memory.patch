+        precondition(m4BootRAM(15360) == 12288)
+        mac.ramMB = 8192
+        precondition(GuestMemory.prepare(mac) == 12288)
+        precondition(GuestMemory.prepare(mac, use: .savedSnapshot) == 8192)
+        precondition(mac.ramMB == 8192)
+        mac.ramMB = 4096
+        precondition(GuestMemory.prepare(mac, use: .installer) == 4096)
+        print("PASS Guest RAM policy: M4 cold boot floor, real-pressure fallback for oversized requests, legacy snapshots and installer")
         print("PASS Desktop MetalFX configuration: actual VirtualMac activation, legacy native default, same workspace, capability/backend fallbacks, Duo and Fit independence")
     }
 }
diff --git a/tests/test_literal_tlb.c b/tests/test_literal_tlb.c
new file mode 100644
index 0000000000000000000000000000000000000000..c94cec7ef33da47a0d77c1b966b5722c9d6953db
--- /dev/null
+++ b/tests/test_literal_tlb.c
@@ -0,0 +1,81 @@
+/* Production-emitter instruction counts plus a paired warmed ARM64 proxy. */
+#include "dispatch.h"
+#include "translate.h"
+#include <assert.h>
+#include <mach/mach_time.h>
+#include <stdio.h>
+
+static HvMachine m;
+static HvCpu cpu;
+static uint32_t code[4096] __attribute__((aligned(16384))) = {
+    0x58000201, /* ldr x1, PC + 64 */
+    0x8b010042, /* add x2, x2, x1 */
+    0xf1000463, /* subs x3, x3, #1 */
+    0x54ffffa1, /* b.ne PC - 12 */
+    [16] = 5
+};
+
+static unsigned inline_words(uint64_t pc, uint32_t flags, int enabled) {
+    HvBlock block = {.va = pc, .pa = pc, .flags = flags};
+    uint64_t before = m.stats.words_inline;
+    m.tlb_literal_slot = enabled;
+    assert(!hv_translate_emit_profiled(&m, &block, code, 4, 0));
+    return (unsigned)(m.stats.words_inline - before);
+}
+
+static void run(uint64_t pc, unsigned iterations, uint32_t value) {
+    cpu.pc = pc;
+    cpu.x[2] = 0;
+    cpu.x[3] = iterations;
+    assert(hv_run(&cpu) == HV_EXIT_HALT);
+    assert(cpu.x[2] == (uint64_t)iterations * value && cpu.x[3] == 0);
+}
+
+int main(void) {
+    assert(!hv_machine_init(&m, 4 << 20));
+    m.fastmem_enabled = 0;
+    m.tlb_preload = 0;
+    m.stats_interval = 1;
+    const uint64_t pcs[] = {0x10000, 0x8000000};
+    const uint32_t contexts[] = {0, HV_BLOCK_EL1, HV_BLOCK_EL1 | HV_BLOCK_PAN};
+    for (unsigned i = 0; i < 2; i++) {
+        for (unsigned c = 0; c < 3; c++) {
+            unsigned before = inline_words(pcs[i], contexts[c], 0);
+            unsigned after = inline_words(pcs[i], contexts[c], 1);
+            unsigned base_words = 2 + (hv_tlb_tmajor && c != 0);
+            unsigned folded_words = i || (hv_tlb_tmajor && c != 0);
+            assert(before - after == base_words - folded_words);
+            printf("literal-tlb-words: layout=%d slot=%u table=%u reference=%u folded=%u\n",
+                   hv_tlb_tmajor, i, c, before, after);
+        }
+    }
+    m.stats_interval = 0;
+    mach_timebase_info_data_t tb;
+    assert(!mach_timebase_info(&tb));
+    assert(!hv_machine_add_ram(&m, pcs[0], sizeof code, code, 1));
+    assert(!hv_machine_add_ram(&m, pcs[1], sizeof code, code, 1));
+    for (unsigned i = 0; i < 2; i++) {
+        m.stop_pc = pcs[i] + 4 * sizeof code[0];
+        for (unsigned round = 0; round < 7; round++) for (unsigned order = 0; order < 2; order++) {
+            int enabled = order ^ (round & 1);
+            m.tlb_literal_slot = enabled;
+            hv_flush_blocks(&m);
+            hv_cpu_reset(&cpu, &m);
+            cpu.el = 0;
+            cpu.spsel = 0;
+            run(pcs[i], 10000, 5);
+            uint64_t begin = mach_absolute_time();
+            run(pcs[i], 2000000, 5);
+            double ns = (double)(mach_absolute_time() - begin) * tb.numer / tb.denom;
+            printf("literal-tlb-bench: layout=%d slot=%u round=%u enabled=%d ns_per_load=%.3f checksum=10000000\n",
+                   hv_tlb_tmajor, i, round, enabled, ns / 2000000);
+
+            /* The slot is constant, but the literal and TLB contents are live. */
+            code[16] = 9;
+            run(pcs[i], 3, 9);
+            code[16] = 5;
+        }
+    }
+    hv_machine_free(&m);
+    puts("PASS literal TLB: live data, reduced emitted words and identical guest sums");
+}

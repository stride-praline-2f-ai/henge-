+/* A literal has the same VA on every execution of this block. Fold the
+   index into the CPU-relative displacement, keeping both live entry reads. */
+static uint32_t put_literal_tlb_slot(Emit *e, int *base, uint64_t va, int table) {
+    uint32_t slot = (uint32_t)(va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1);

+def extract_validated_bundle(tar, root):
+    # The caller supplies an empty, private directory. Only copy validated
+    # regular files and directories, without restoring archive ownership or modes.
+    members = tar.getmembers()
+    validate_members(members)
+    for member in members:
+        target = root / member.name
+        if member.isdir():
+            target.mkdir(parents=True, exist_ok=True)
+            continue
+        target.parent.mkdir(parents=True, exist_ok=True)
+        source = tar.extractfile(member)
+        if source is None:
+            raise ValueError('Missing guest-helper archive contents: ' + member.name)
+        with source, target.open('xb') as output:
+            shutil.copyfileobj(source, output)
+        target.chmod(0o700 if member.mode & 0o111 else 0o600)
+
 
